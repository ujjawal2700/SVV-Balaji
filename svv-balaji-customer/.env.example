# Base URL of the SVV Balaji API, including the global api/v1 prefix.
# Leave relative to go through the Vite dev proxy (see vite.config.ts).
VITE_API_BASE_URL="/api/v1"

# Where the dev proxy forwards to. Development only.
VITE_API_PROXY_TARGET="http://localhost:3000"

# This dev server fronts the other two apps so that development matches the
# production origin. Both are separate Vite servers you start yourself.
VITE_ADMIN_PROXY_TARGET="http://localhost:5173"
VITE_FIELD_PROXY_TARGET="http://localhost:5174"

# Where this app keeps its refresh token.
#
# MUST differ from the admin panel's key AND the field app's. All three are
# served from one origin (svvbalaji.com, /admin and /field) so they share one
# localStorage, and the backend stores a single refresh hash per user - with a
# shared key, a customer signing in here would silently end a staff session in
# another tab.
VITE_TOKEN_KEY="svv.customer.refreshToken"

# Where the cart lives between visits. Same reasoning as the token key: one
# origin, three apps, no collisions.
VITE_CART_KEY="svv.customer.cart"
