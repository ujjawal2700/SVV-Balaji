# Base URL of the SVV Balaji API, including the global api/v1 prefix.
#
# Leave as the relative path below to go through the Vite dev proxy (see
# vite.config.ts) - that keeps the browser origin the same as the app's, which
# is how it will look in production behind Nginx.
VITE_API_BASE_URL="/api/v1"

# Where the dev proxy forwards to. Only used by vite.config.ts in development.
VITE_API_PROXY_TARGET="http://localhost:3000"
