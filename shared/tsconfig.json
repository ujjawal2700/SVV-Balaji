{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,

    // shared/ uses import.meta.env; vite's client types live in a sibling app
    "types": ["../svv-balaji-admin/node_modules/vite/client"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["./*"],

      // shared/ has no node_modules of its own; resolve against a sibling app,
      // with react/react-dom redirected to @types (see the app tsconfigs).
      "react": ["../svv-balaji-admin/node_modules/@types/react"],
      "react/*": ["../svv-balaji-admin/node_modules/@types/react/*"],
      "react-dom": ["../svv-balaji-admin/node_modules/@types/react-dom"],
      "react-dom/*": ["../svv-balaji-admin/node_modules/@types/react-dom/*"],
      "*": ["../svv-balaji-admin/node_modules/*"]
    }
  },
  "include": ["**/*"]
}
