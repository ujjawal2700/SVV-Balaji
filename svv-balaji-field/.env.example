# Base URL of the SVV Balaji API, including the global api/v1 prefix.
# Leave relative to go through the Vite dev proxy (see vite.config.ts).
VITE_API_BASE_URL="/api/v1"

# Where the dev proxy forwards to. Development only.
VITE_API_PROXY_TARGET="http://localhost:3000"

# Where this app keeps its refresh token.
#
# MUST differ from the admin panel's key. The two apps are served from the same
# origin (svvbalaji.com and svvbalaji.com/field) so they share one localStorage,
# and the backend stores a single refresh hash per user - with one key, signing
# in here would silently end an admin session in another tab.
VITE_TOKEN_KEY="svv.field.refreshToken"
