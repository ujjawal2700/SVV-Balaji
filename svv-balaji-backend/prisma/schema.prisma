// SVV Balaji - Farm-to-Customer Supply Chain Management
// Phase 0 Foundation Schema
// Covers: Auth/RBAC, Branch Master, and the Farmer/Product/Warehouse master
// stubs needed before Phase 1 (Farm Sourcing & Planning) work begins.
//
// NOTE: This is a Phase 0 foundation only. Batch genealogy models
// (RawMaterialBatch, ProductionBatch, FinishedGoodsBatch, Order, etc.)
// get added in Phase 2-4 per the module roadmap - they are intentionally
// NOT included here so the schema doesn't get ahead of the build plan.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  BRANCH_MANAGER
  PROCUREMENT_MANAGER
  AGRICULTURE_EXPERT
  PRODUCTION_MANAGER
  QA_MANAGER
  WAREHOUSE_MANAGER
  SALES_TEAM
  LOGISTICS_TEAM
  // CUSTOMER intentionally excluded from this internal-staff enum -
  // customers are modeled separately (Customer table, Phase 4+) once
  // the D2C app scope is confirmed with the client.
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum FarmerStatus {
  PENDING_VERIFICATION
  ACTIVE
  INACTIVE
  BLACKLISTED
  SUSPENDED
}

enum FarmerVerificationAction {
  APPROVED
  REJECTED
  DOCUMENTS_REQUESTED
}

enum AgreementStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

// --- Phase 2: Procurement & Raw Material Control -------------------------

enum ProcurementPlanStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// FRD 13.4 - outcome of the pre-harvest quality inspection.
enum InspectionResult {
  APPROVED
  REJECTED
  HOLD_FOR_REINSPECTION
}

/// FRD 15.4 - where a raw material batch sits in its lifecycle.
/// Extends through production/dispatch in later phases.
enum BatchStatus {
  COLLECTED
  STORED
  UNDER_PRODUCTION
  PACKAGED
  DISPATCHED
  DELIVERED
  REJECTED
}

/// FRD 26.4. Shared by farmer collection payments and customer order payments -
/// both can fail and both can be refunded, so the states belong to both.
enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  /// An attempted payment that did not go through. Distinct from PENDING:
  /// pending means nobody has tried, failed means someone tried and it bounced,
  /// and collapsing the two hides every failure in the "not yet paid" bucket.
  FAILED
  /// Money returned after being taken. Terminal - a refunded payment is not
  /// pending again, and treating it as such would double-count the receivable.
  REFUNDED
}

/// FRD 17.3 - every inventory change is one of these.
enum StockMovementType {
  /// Packed finished goods entering a warehouse automatically when QA releases the batch.
  PRODUCTION_INWARD
  STOCK_IN
  STOCK_OUT
  TRANSFER
  ADJUSTMENT
}

// --- Phase 3: Processing, QA & Packaging ---------------------------------

/// FRD 19.4 - only APPROVED recipes may be used in production.
enum RecipeStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  INACTIVE
}

/// FRD 20.3 / 20.4 - single raw material vs blended.
/// MULTI_GRAIN execution (weigh-per-ratio, blending, homogeneity) is modelled
/// here but gated in the service until the client confirms it is in scope.
enum ProductionType {
  SINGLE_GRAIN
  MULTI_GRAIN
}

/// FRD 20.7
enum ProductionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  PAUSED
  CANCELLED
}

/// FRD 21 - quality is checked at three points in the lifecycle.
enum InspectionStage {
  RAW_MATERIAL
  IN_PROCESS
  FINISHED_GOODS
}

/// FRD 21.4
enum QualityResult {
  PASS
  FAIL
  REWORK_REQUIRED
}

// --- Supplier Module --------------------------------------------------------

enum SupplierStatus {
  PENDING_VERIFICATION
  ACTIVE
  INACTIVE
  BLACKLISTED
  SUSPENDED
}

enum SupplierVerificationAction {
  APPROVED
  REJECTED
  DOCUMENTS_REQUESTED
}

enum TransportStatus {
  SCHEDULED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Auth / Users
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  fullName     String
  phone        String?
  role         UserRole
  status       UserStatus @default(ACTIVE)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  refreshTokenHash String?

  // Phase 0 / 2FA & Security
  isTwoFactorEnabled     Boolean  @default(false)
  twoFactorSecret        String? // AES-256-GCM encrypted
  twoFactorTempSecret    String? // AES-256-GCM encrypted (during setup)
  twoFactorRecoveryCodes String[] @default([]) // Array of bcrypt-hashed recovery codes

  // Phase 1 back-relations
  farmerVerificationLogs    FarmerVerificationLog[]
  seedDistributionsGiven    SeedDistribution[]
  trainingSessionsConducted TrainingSession[]
  fieldVisitsAsExpert       FieldVisit[]

  // Phase 2 back-relations
  procurementPlansCreated ProcurementPlan[]       @relation("ProcurementPlansCreated")
  harvestInspections      HarvestInspection[]     @relation("HarvestInspections")
  rawMaterialCollections  RawMaterialCollection[] @relation("RawMaterialCollections")
  stockMovements          StockMovement[]         @relation("StockMovements")

  farmPlotsCreated FarmPlot[] @relation("FarmPlotsCreated")
  farmersCreated   Farmer[]   @relation("FarmersCreated")

  // Phase 3 back-relations
  /// FRD 6.2 - the branch this user is the assigned manager of, if any.
  /// Distinct from `branch` above, which is where they work.
  managedBranch Branch? @relation("BranchManager")

  cleaningGradingRecords   CleaningGradingRecord[] @relation("CleaningGradingOperator")
  cleaningGradingVerified  CleaningGradingRecord[] @relation("CleaningGradingVerifier")
  recipesCreated           Recipe[]                @relation("RecipesCreated")
  recipesApproved          Recipe[]                @relation("RecipesApproved")
  productionBatchesCreated ProductionBatch[]       @relation("ProductionBatchesCreated")
  qualityInspections       QualityInspection[]     @relation("QualityInspections")
  finishedGoodsPacked      FinishedGoodsBatch[]    @relation("FinishedGoodsPacked")
  batchHoldEvents          BatchHoldEvent[]        @relation("BatchHoldEvents")
  orderReturnsRecorded     OrderReturn[]           @relation("OrderReturnsRecorded")
  pushSubscriptions        PushSubscription[]
  orderEventsActed         OrderEvent[]            @relation("OrderEventsActed")
  loyaltySettingsUpdated   LoyaltySettings[]       @relation("LoyaltySettingsUpdated")

  // Phase 4 back-relations
  customersAssigned Customer[]        @relation("CustomerAssignedTo")
  priceListsCreated PriceList[]       @relation("PriceListsCreated")
  ordersPlaced      Order[]           @relation("OrdersPlaced")
  orderAllocations  OrderAllocation[] @relation("OrderAllocations")

  // Supplier back-relations
  suppliersCreated          Supplier[]                @relation("SuppliersCreated")
  supplierVerificationLogs  SupplierVerificationLog[]
  supplierTransportsCreated SupplierTransport[]       @relation("TransportsCreated")
  purchaseOrdersCreated     PurchaseOrder[]           @relation("PurchaseOrdersCreated")

  // Storefront back-relations
  customerAccountsReviewed  CustomerAccount[]  @relation("CustomerAccountsReviewed")
  referralSettingsUpdated   ReferralSettings[]
  coinTransactionsPerformed CoinTransaction[]  @relation("CoinTransactionsPerformed")
  supportTicketsResolved    SupportTicket[]    @relation("SupportTicketResolvedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([branchId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Branch Management (FRD Section 6)
// ---------------------------------------------------------------------------

model Branch {
  id           String  @id @default(uuid())
  name         String
  location     String
  address      String
  contactName  String?
  contactPhone String?
  isActive     Boolean @default(true)

  /// FRD 6.2 - the Branch Manager assigned to run this branch.
  ///
  /// The relationship was previously only inferable backwards: find the users
  /// whose `branchId` is this branch and whose role happens to be
  /// BRANCH_MANAGER. That answers "who works here", not "who is accountable
  /// for this branch" - two managers at one site made the question unanswerable,
  /// and a branch with none looked identical to a branch with one.
  ///
  /// Unique because a manager runs one branch: they carry a single `branchId`,
  /// so managing a second would mean being assigned somewhere they do not work.
  managerId String? @unique
  manager   User?   @relation("BranchManager", fields: [managerId], references: [id])

  users            User[]
  farmers          Farmer[]
  warehouses       Warehouse[]
  trainingSessions TrainingSession[]
  fieldVisits      FieldVisit[]

  // Phase 2
  procurementPlans       ProcurementPlan[]
  rawMaterialCollections RawMaterialCollection[]
  rawMaterialBatches     RawMaterialBatch[]

  // Phase 3
  productionBatches ProductionBatch[]

  // Phase 4
  customers Customer[]
  orders    Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("branches")
}

// ---------------------------------------------------------------------------
// Farmer Management + Farmer ID & Traceability (FRD Sections 7-8, Phase 1)
// farmerCode is nullable until approval - per FRD 8.1 the unique ID is
// generated for "every approved farmer", not at registration time.
// ---------------------------------------------------------------------------

model Farmer {
  id            String  @id @default(uuid())
  farmerCode    String? @unique // e.g. SVV-2026-000123 - assigned on approval, the traceability anchor
  fullName      String
  mobile        String
  aadhaarNumber String?
  panNumber     String?

  /// FRD 7.1 "Family Details" - free text.
  ///
  /// Deliberately one string rather than a related table. The FRD asks for it
  /// under Personal Information alongside name and mobile, not as a structured
  /// dependants list, and nothing downstream reads it. A `FarmerFamilyMember`
  /// table would be a schema we then have to keep correct for data nobody
  /// queries. Promote it if a requirement ever needs it row-wise.
  familyDetails String?

  village     String
  district    String
  state       String
  address     String?
  gpsLocation String?

  farmSizeAcres  Decimal? @db.Decimal(10, 2)
  landType       String?
  irrigationType String?
  cropDetails    String?

  bankAccountName String?
  bankName        String?
  bankAccountNo   String?
  ifscCode        String?

  status FarmerStatus @default(PENDING_VERIFICATION)

  // --- FRD 7.6 Farmer Performance -------------------------------------------
  //
  // Persisted rather than computed on read, for one concrete reason: FRD 7.4
  // lists Quality Rating as a *search filter*. A score computed in application
  // code cannot be filtered or sorted in SQL without loading every farmer, so
  // the composite lands here and `FarmerPerformanceService` keeps it current.
  //
  // The component scores are stored beside it so the panel can explain a rating
  // without recomputing it, and so a rating can be audited after the fact
  // against the records that produced it.

  /// Composite 0-100. NULL means unrated - no procurement history yet.
  /// Null is not zero: a farmer who has never supplied is not a bad farmer.
  qualityRating Decimal? @db.Decimal(5, 2)

  /// FRD 7.6 components, each 0-100 and each NULL when it has no input.
  cropQualityScore         Decimal? @db.Decimal(5, 2)
  deliveryTimelinessScore  Decimal? @db.Decimal(5, 2)
  procurementQuantityScore Decimal? @db.Decimal(5, 2)

  /// When the scores above were last recomputed. Stale values are a bug, so
  /// this exists to make staleness visible rather than invisible.
  performanceUpdatedAt DateTime?

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  createdById String?
  createdBy   User?   @relation("FarmersCreated", fields: [createdById], references: [id])

  verificationLogs    FarmerVerificationLog[]
  agreements          Agreement[]
  seedDistributions   SeedDistribution[]
  trainingAttendances TrainingAttendance[]
  fieldVisits         FieldVisit[]
  plots               FarmPlot[]

  // Phase 2 - the traceability chain from this farmer forward
  harvestInspections     HarvestInspection[]
  rawMaterialCollections RawMaterialCollection[]
  rawMaterialBatches     RawMaterialBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([branchId])
  /// FRD 7.4 filters and sorts farmers by Quality Rating.
  @@index([qualityRating])
  @@map("farmers")
}

// ---------------------------------------------------------------------------
// Farmer code sequence - backs the SVV-YYYY-NNNNNN traceability ID.
// Single row per year, incremented atomically (see FarmersService) so
// concurrent approvals never collide on the same code.
// ---------------------------------------------------------------------------

model FarmerCodeCounter {
  year       Int @id
  lastNumber Int @default(0)

  @@map("farmer_code_counters")
}

// ---------------------------------------------------------------------------
// Farmer Verification Audit Trail (FRD 7.2)
// ---------------------------------------------------------------------------

model FarmerVerificationLog {
  id       String @id @default(uuid())
  farmerId String
  farmer   Farmer @relation(fields: [farmerId], references: [id])

  action  FarmerVerificationAction
  remarks String?

  verifiedById String
  verifiedBy   User   @relation(fields: [verifiedById], references: [id])

  createdAt DateTime @default(now())

  @@index([farmerId])
  @@map("farmer_verification_logs")
}

// ---------------------------------------------------------------------------
// Agreement Management (FRD Section 9)
// ---------------------------------------------------------------------------

model Agreement {
  id       String @id @default(uuid())
  farmerId String
  farmer   Farmer @relation(fields: [farmerId], references: [id])

  cropName         String
  variety          String?
  expectedQuantity Decimal   @db.Decimal(12, 2)
  purchaseRate     Decimal   @db.Decimal(12, 2)
  agreementDate    DateTime
  harvestDate      DateTime?
  qualityStandards String?

  status AgreementStatus @default(PENDING)

  harvestInspections HarvestInspection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmerId])
  @@index([status])
  @@map("agreements")
}

// ---------------------------------------------------------------------------
// Seed & Input Distribution (FRD Section 10)
// ---------------------------------------------------------------------------

model SeedDistribution {
  id       String @id @default(uuid())
  farmerId String
  farmer   Farmer @relation(fields: [farmerId], references: [id])

  seedName         String
  seedVariety      String?
  quantity         Decimal  @db.Decimal(12, 2)
  unit             String   @default("KG")
  batchNumber      String?
  distributionDate DateTime

  distributedById String
  distributedBy   User   @relation(fields: [distributedById], references: [id])

  createdAt DateTime @default(now())

  @@index([farmerId])
  @@map("seed_distributions")
}

// ---------------------------------------------------------------------------
// Training Management (FRD Section 11)
// ---------------------------------------------------------------------------

model TrainingSession {
  id            String   @id @default(uuid())
  title         String
  description   String?
  scheduledDate DateTime

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  conductedById String
  conductedBy   User   @relation(fields: [conductedById], references: [id])

  attendances TrainingAttendance[]
  materials   TrainingMaterial[]

  createdAt DateTime @default(now())

  @@index([branchId])
  @@map("training_sessions")
}

model TrainingAttendance {
  id String @id @default(uuid())

  sessionId String
  session   TrainingSession @relation(fields: [sessionId], references: [id])

  farmerId String
  farmer   Farmer @relation(fields: [farmerId], references: [id])

  attended Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([sessionId, farmerId])
  @@map("training_attendances")
}

model TrainingMaterial {
  id String @id @default(uuid())

  sessionId String
  session   TrainingSession @relation(fields: [sessionId], references: [id])

  fileUrl  String
  fileType String // pdf, image, presentation, video

  createdAt DateTime @default(now())

  @@map("training_materials")
}

// ---------------------------------------------------------------------------
// Field Monitoring (FRD Section 12)
// ---------------------------------------------------------------------------

model FieldVisit {
  id String @id @default(uuid())

  farmerId String
  farmer   Farmer @relation(fields: [farmerId], references: [id])

  expertId String
  expert   User   @relation(fields: [expertId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  visitDate DateTime
  cropName  String?

  cropGrowthStage    String?
  cropHealth         String?
  pestStatus         String?
  diseaseObservation String?

  fertilizerAdvice       String?
  irrigationAdvice       String?
  pestControlSuggestions String?
  harvestPreparation     String?

  yieldPredictionQty Decimal? @db.Decimal(12, 2)

  documents FieldVisitDocument[]

  createdAt DateTime @default(now())

  @@index([farmerId])
  @@index([expertId])
  @@map("field_visits")
}

model FieldVisitDocument {
  id String @id @default(uuid())

  fieldVisitId String
  fieldVisit   FieldVisit @relation(fields: [fieldVisitId], references: [id])

  fileUrl  String
  fileType String // photo, pdf report, inspection doc

  createdAt DateTime @default(now())

  @@map("field_visit_documents")
}

// ===========================================================================
// PHASE 2 - Procurement & Raw Material Control (FRD Sections 13-17)
// ===========================================================================

// ---------------------------------------------------------------------------
// Procurement Planning (FRD 13.1)
// ---------------------------------------------------------------------------

model ProcurementPlan {
  id       String @id @default(uuid())
  cropName String

  plannedQuantity Decimal @db.Decimal(12, 2)
  unit            String  @default("KG")

  scheduledFrom DateTime
  scheduledTo   DateTime

  status ProcurementPlanStatus @default(DRAFT)
  notes  String?

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  createdById String
  createdBy   User   @relation("ProcurementPlansCreated", fields: [createdById], references: [id])

  inspections HarvestInspection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([status])
  @@map("procurement_plans")
}

// ---------------------------------------------------------------------------
// Harvest Inspection (FRD 13.2 - 13.5)
// Gate before collection: only APPROVED inspections may proceed.
// ---------------------------------------------------------------------------

model HarvestInspection {
  id String @id @default(uuid())

  farmerId String
  farmer   Farmer @relation(fields: [farmerId], references: [id])

  /// Optional - inspections can happen against an agreement or ad hoc.
  agreementId String?
  agreement   Agreement? @relation(fields: [agreementId], references: [id])

  procurementPlanId String?
  procurementPlan   ProcurementPlan? @relation(fields: [procurementPlanId], references: [id])

  /// Which of the farmer's plots this harvest came from.
  ///
  /// Optional, and has to stay optional: every inspection recorded before
  /// plots existed has none, and a farmer whose land has not been mapped yet
  /// still needs to be inspectable. A missing plot is a gap in the trace, not
  /// a reason to block procurement.
  plotId String?
  plot   FarmPlot? @relation("InspectedPlot", fields: [plotId], references: [id])

  cropName       String
  inspectionDate DateTime

  // FRD 13.2 inspection checklist
  moistureLevel  Decimal? @db.Decimal(5, 2)
  foreignMatter  Decimal? @db.Decimal(5, 2)
  grainSize      String?
  grainColor     String?
  smell          String?
  physicalDamage String?

  result  InspectionResult
  remarks String?

  inspectedById String
  inspectedBy   User   @relation("HarvestInspections", fields: [inspectedById], references: [id])

  documents  HarvestInspectionDocument[]
  collection RawMaterialCollection?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmerId])
  @@index([result])
  @@index([plotId])
  @@map("harvest_inspections")
}

model HarvestInspectionDocument {
  id String @id @default(uuid())

  inspectionId String
  inspection   HarvestInspection @relation(fields: [inspectionId], references: [id])

  fileUrl  String
  fileType String // crop_image | inspection_photo | pdf | quality_certificate

  createdAt DateTime @default(now())

  @@map("harvest_inspection_documents")
}

// ---------------------------------------------------------------------------
// Raw Material Collection (FRD Section 14)
// One collection per approved inspection - this is the farmer -> batch link.
// ---------------------------------------------------------------------------

model RawMaterialCollection {
  id String @id @default(uuid())

  /// Enforced 1:1 - a harvest is collected once.
  inspectionId String            @unique
  inspection   HarvestInspection @relation(fields: [inspectionId], references: [id])

  farmerId String
  farmer   Farmer @relation(fields: [farmerId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  /// Copied from the inspection at collection time rather than read through
  /// it. The collection is the row the batch and every downstream trace hangs
  /// off, and denormalising one nullable id here saves a join on the hottest
  /// read in the system - the consumer trace page.
  plotId String?
  plot   FarmPlot? @relation("HarvestedPlot", fields: [plotId], references: [id])

  cropName           String
  collectionDate     DateTime
  collectionLocation String?

  // FRD 14.2 weight measurement
  grossWeight Decimal @db.Decimal(12, 2)
  netWeight   Decimal @db.Decimal(12, 2)
  unit        String  @default("KG")

  // FRD 14.3 purchase details
  purchaseRate  Decimal       @db.Decimal(12, 2)
  totalAmount   Decimal       @db.Decimal(14, 2)
  paymentStatus PaymentStatus @default(PENDING)

  /// FRD 14.4 - receipt issued to farmer and company.
  receiptNumber String @unique

  collectedById String
  collectedBy   User   @relation("RawMaterialCollections", fields: [collectedById], references: [id])

  batch RawMaterialBatch?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmerId])
  @@index([branchId])
  @@index([plotId])
  @@map("raw_material_collections")
}

// ---------------------------------------------------------------------------
// Batch Management (FRD Section 15)
// The traceability spine: Farmer -> Collection -> RawMaterialBatch -> (Phase 3
// production) -> (Phase 4 order/delivery).
// ---------------------------------------------------------------------------

model RawMaterialBatch {
  id String @id @default(uuid())

  /// FRD 15.1 format: RM-YYYYMMDD-NNN
  batchNumber String @unique

  // -------------------------------------------------------------------------
  // Origin Link - either from a Farmer Collection or a Supplier Transport
  // -------------------------------------------------------------------------

  collectionId String?                @unique
  collection   RawMaterialCollection? @relation(fields: [collectionId], references: [id])

  supplierTransportId String?            @unique
  supplierTransport   SupplierTransport? @relation(fields: [supplierTransportId], references: [id])

  farmerId String?
  farmer   Farmer? @relation(fields: [farmerId], references: [id])

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  // -------------------------------------------------------------------------

  cropName String
  quantity Decimal @db.Decimal(12, 2)
  unit     String  @default("KG")

  status BatchStatus @default(COLLECTED)

  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  stock          WarehouseStock[]
  stockMovements StockMovement[]

  // Phase 3 - consumed into production, and inspected along the way
  cleaningGradingRecords CleaningGradingRecord[]
  consumptions           ProductionConsumption[]
  qualityInspections     QualityInspection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmerId])
  @@index([status])
  @@index([warehouseId])
  @@map("raw_material_batches")
}

/// Per-day sequence backing RM-YYYYMMDD-NNN. Same atomic-increment pattern as
/// FarmerCodeCounter so concurrent collections never collide on a batch number.
model BatchNumberCounter {
  /// YYYYMMDD as an integer, e.g. 20260807
  dateKey    Int @id
  lastNumber Int @default(0)

  @@map("batch_number_counters")
}

// ---------------------------------------------------------------------------
// Warehouse Stock + Inventory Ledger (FRD Sections 16-17)
// ---------------------------------------------------------------------------

/// Current on-hand quantity per (warehouse, batch). Mutated only alongside a
/// StockMovement row so the ledger and the balance can never drift apart.
model WarehouseStock {
  id String @id @default(uuid())

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  batchId String
  batch   RawMaterialBatch @relation(fields: [batchId], references: [id])

  quantity         Decimal @db.Decimal(12, 2)
  reservedQuantity Decimal @default(0) @db.Decimal(12, 2)
  unit             String  @default("KG")

  storageLocation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([warehouseId, batchId])
  @@index([warehouseId])
  @@map("warehouse_stock")
}

/// FRD 17.3/17.5 - append-only audit trail of every inventory change.
/// Every change to stock, of either kind.
///
/// Raw material has always held the invariant that quantity is never mutated
/// except alongside a row here. Finished goods did not - `FinishedGoodsStock`
/// was decremented on dispatch and left no trace, so "why is the count wrong"
/// had no answer. A-13 (16 Aug) closed that by widening this table rather than
/// adding a second one: one ledger means one place to read, one report, one
/// screen, instead of every inventory question being asked twice and joined.
///
/// Exactly one of `batchId` / `fgBatchId` is set. Enforced by a CHECK
/// constraint in the migration, because Prisma cannot express it.
model StockMovement {
  id String @id @default(uuid())

  /// Set for raw material movements.
  batchId String?
  batch   RawMaterialBatch? @relation(fields: [batchId], references: [id])

  /// Set for finished goods movements.
  fgBatchId String?
  fgBatch   FinishedGoodsBatch? @relation(fields: [fgBatchId], references: [id])

  fromWarehouseId String?
  fromWarehouse   Warehouse? @relation("StockMovementFrom", fields: [fromWarehouseId], references: [id])

  toWarehouseId String?
  toWarehouse   Warehouse? @relation("StockMovementTo", fields: [toWarehouseId], references: [id])

  movementType StockMovementType
  quantity     Decimal           @db.Decimal(12, 2)
  unit         String            @default("KG")
  reason       String?
  /// Machine-readable origin, e.g. QA_RELEASE_AUTO.
  reference    String?

  performedById String
  performedBy   User   @relation("StockMovements", fields: [performedById], references: [id])

  createdAt DateTime @default(now())

  @@index([batchId])
  @@index([fgBatchId])
  @@index([movementType])
  @@map("stock_movements")
}

// ===========================================================================
// PHASE 3 - Processing, QA & Packaging (FRD Sections 18-23)
// ===========================================================================

// ---------------------------------------------------------------------------
// Cleaning & Grading (FRD Section 18)
// Happens to a raw material batch before it can enter production.
// ---------------------------------------------------------------------------

model CleaningGradingRecord {
  id String @id @default(uuid())

  rawMaterialBatchId String
  rawMaterialBatch   RawMaterialBatch @relation(fields: [rawMaterialBatchId], references: [id])

  // FRD 18.1 cleaning activities
  dustRemoved            Boolean @default(false)
  stonesRemoved          Boolean @default(false)
  foreignMaterialRemoved Boolean @default(false)
  impuritiesSeparated    Boolean @default(false)

  // FRD 18.2 grading parameters
  grainSize     String?
  color         String?
  texture       String?
  moistureLevel Decimal? @db.Decimal(5, 2)
  purity        Decimal? @db.Decimal(5, 2)

  /// Weight lost to cleaning - matters for yield reconciliation.
  wastageQuantity Decimal? @db.Decimal(12, 2)

  /// FRD loss/yield tracking - material removed during cleaning that still has
  /// resale value (bran, choker, husk), distinct from pure wastage above.
  /// `wastageQuantity` stays pure loss; this is loss that has value.
  byProductQuantity Decimal? @db.Decimal(12, 2)
  byProductName     String?

  /// FRD 18.3 - QA sign-off before the batch is production-ready.
  /// FRD 18.3. Set only through `PATCH /cleaning-grading/:id/verify`, which
  /// requires `quality.create` - never by the operator submitting the record.
  /// Production refuses a batch whose cleaning record is not verified.
  qaVerified     Boolean   @default(false)
  /// Who verified, and when. A sign-off nobody is named against is not a sign-off.
  qaVerifiedById String?
  qaVerifiedBy   User?     @relation("CleaningGradingVerifier", fields: [qaVerifiedById], references: [id])
  qaVerifiedAt   DateTime?

  remarks String?

  operatorId String
  operator   User   @relation("CleaningGradingOperator", fields: [operatorId], references: [id])

  createdAt DateTime @default(now())

  @@index([rawMaterialBatchId])
  @@map("cleaning_grading_records")
}

// ---------------------------------------------------------------------------
// Recipe / Formula Management (FRD Section 19)
// Created by Super Admin only, versioned, and approved before use.
// ---------------------------------------------------------------------------

model Recipe {
  id String @id @default(uuid())

  recipeCode String
  version    Int    @default(1)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  name        String
  category    String?
  description String?

  productionType ProductionType @default(SINGLE_GRAIN)

  // FRD 19.3 production formula
  mixingRatio           String?
  processingSequence    String?
  grindingInstructions  String?
  roastingInstructions  String?
  oilExtractionProcess  String?
  packagingInstructions String?

  /// Expected output for one full batch, used to scale ingredient quantities.
  batchYieldQuantity Decimal? @db.Decimal(12, 2)
  unit               String   @default("KG")

  status RecipeStatus @default(DRAFT)

  createdById String
  createdBy   User   @relation("RecipesCreated", fields: [createdById], references: [id])

  approvedById String?
  approvedBy   User?     @relation("RecipesApproved", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  ingredients       RecipeIngredient[]
  productionBatches ProductionBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Same code may exist at multiple versions, but only once per version.
  @@unique([recipeCode, version])
  @@index([status])
  @@map("recipes")
}

/// FRD 19.2 - one row per raw material in the formula.
/// For SINGLE_GRAIN recipes there is exactly one; MULTI_GRAIN has several
/// whose percentages should total 100.
model RecipeIngredient {
  id String @id @default(uuid())

  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  /// Matches RawMaterialBatch.cropName - what to pull from stock.
  cropName String

  quantity   Decimal  @db.Decimal(12, 3)
  unit       String   @default("KG")
  /// Share of the finished blend, 0-100.
  percentage Decimal? @db.Decimal(5, 2)

  createdAt DateTime @default(now())

  @@index([recipeId])
  @@map("recipe_ingredients")
}

// ---------------------------------------------------------------------------
// Production Management (FRD Section 20)
// ---------------------------------------------------------------------------

model ProductionBatch {
  id String @id @default(uuid())

  /// Format: PB-YYYYMMDD-NNN
  productionBatchNumber String @unique

  productId String
  product   Product @relation(fields: [productId], references: [id])

  recipeId      String
  recipe        Recipe @relation(fields: [recipeId], references: [id])
  /// Pinned at creation - recipes are versioned and may change afterwards.
  recipeVersion Int

  productionType ProductionType

  plannedQuantity Decimal  @db.Decimal(12, 2)
  actualQuantity  Decimal? @db.Decimal(12, 2)
  /// FRD 20.5 - planned minus actual, i.e. process loss.
  productionLoss  Decimal? @db.Decimal(12, 2)
  unit            String   @default("KG")

  /// Loss/yield tracking - material recovered during production with resale
  /// value (e.g. oil cake, screenings), distinct from pure process loss above.
  byProductQuantity Decimal? @db.Decimal(12, 2)
  byProductName     String?
  /// Revenue if/when the by-product is sold. A recorded figure, not a sales workflow.
  byProductRevenue  Decimal? @db.Decimal(12, 2)

  productionDate DateTime
  status         ProductionStatus @default(PLANNED)

  // FRD 20.6 machine allocation
  machineName    String?
  machineNumber  String?
  operatorName   String?
  productionLine String?

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  /// Warehouse the raw material is drawn from.
  ///
  /// Added with FRD 17.2 reservation. A PLANNED run holds a reservation against
  /// stock rows in a specific warehouse, and the release has to find exactly
  /// those rows again when the run starts or is cancelled - so the warehouse
  /// stops being a create-time argument and becomes a property of the run.
  ///
  /// Nullable only because runs created before reservation existed have no
  /// value to backfill; every new run sets it.
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  createdById String
  createdBy   User   @relation("ProductionBatchesCreated", fields: [createdById], references: [id])

  consumptions         ProductionConsumption[]
  qualityInspections   QualityInspection[]
  finishedGoodsBatches FinishedGoodsBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([branchId])
  @@map("production_batches")
}

/// FRD 20.5 - the traceability link across the processing step.
/// Every raw material batch consumed by a production run is recorded here,
/// which is what lets a finished pack resolve back to specific farmers.
model ProductionConsumption {
  id String @id @default(uuid())

  productionBatchId String
  productionBatch   ProductionBatch @relation(fields: [productionBatchId], references: [id], onDelete: Cascade)

  rawMaterialBatchId String
  rawMaterialBatch   RawMaterialBatch @relation(fields: [rawMaterialBatchId], references: [id])

  quantityUsed Decimal @db.Decimal(12, 2)
  unit         String  @default("KG")

  createdAt DateTime @default(now())

  @@unique([productionBatchId, rawMaterialBatchId])
  @@index([rawMaterialBatchId])
  @@map("production_consumptions")
}

// ---------------------------------------------------------------------------
// Quality Management (FRD Section 21)
// ---------------------------------------------------------------------------

model QualityInspection {
  id String @id @default(uuid())

  stage InspectionStage

  /// Exactly one of these is set, depending on stage.
  rawMaterialBatchId String?
  rawMaterialBatch   RawMaterialBatch? @relation(fields: [rawMaterialBatchId], references: [id])

  productionBatchId String?
  productionBatch   ProductionBatch? @relation(fields: [productionBatchId], references: [id])

  finishedGoodsBatchId String?
  finishedGoodsBatch   FinishedGoodsBatch? @relation(fields: [finishedGoodsBatchId], references: [id])

  // FRD 21.1 raw material parameters
  moisture      Decimal? @db.Decimal(5, 2)
  purity        Decimal? @db.Decimal(5, 2)
  grainSize     String?
  color         String?
  foreignMatter Decimal? @db.Decimal(5, 2)
  odor          String?

  // FRD 21.2 in-process parameters
  ingredientRatio    String?
  mixingAccuracy     String?
  grindingQuality    String?
  temperature        Decimal? @db.Decimal(6, 2)
  productConsistency String?

  // FRD 21.3 finished goods parameters
  productAppearance String?
  productWeight     Decimal? @db.Decimal(12, 3)
  packagingQuality  String?
  labelAccuracy     String?
  shelfLifeVerified Boolean?

  result  QualityResult
  remarks String?

  inspectedById String
  inspectedBy   User   @relation("QualityInspections", fields: [inspectedById], references: [id])

  createdAt DateTime @default(now())

  @@index([stage])
  @@index([result])
  @@map("quality_inspections")
}

// ---------------------------------------------------------------------------
// Packaging + Finished Goods (FRD Sections 22-23)
// ---------------------------------------------------------------------------

model FinishedGoodsBatch {
  id String @id @default(uuid())

  /// Format: FG-YYYYMMDD-NNN. This is what the consumer QR resolves to.
  fgBatchNumber String @unique

  productionBatchId String
  productionBatch   ProductionBatch @relation(fields: [productionBatchId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  // FRD 22.2 label information
  packagingType     String // pouch | box | bottle | jar | sack
  netWeight         Decimal   @db.Decimal(12, 3)
  weightUnit        String    @default("KG")
  mrp               Decimal?  @db.Decimal(12, 2)
  packagingDate     DateTime
  manufacturingDate DateTime
  expiryDate        DateTime?
  shelfLifeDays     Int?

  /// Number of packs produced at this net weight.
  packCount Int

  /// Public traceability URL encoded in the QR (FRD 22.3). Stored so the
  /// printed code and the record can never disagree.
  qrPayload String?

  /// FRD 21.5 - only QA-released batches may be stocked or dispatched.
  qaReleased Boolean @default(false)

  /// Recall control, separate from QA release on purpose: `qaReleased` says the
  /// batch PASSED inspection, `holdStatus` says whether it may still be sold.
  /// A complaint can freeze a batch that passed. Only ACTIVE batches are
  /// allocated, dispatched, counted as storefront stock or vouched for on the
  /// public trace page. Every change is written to `BatchHoldEvent`.
  holdStatus    BatchHoldStatus @default(ACTIVE)
  holdReason    String?
  holdChangedAt DateTime?

  holdEvents BatchHoldEvent[]

  packedById String
  packedBy   User   @relation("FinishedGoodsPacked", fields: [packedById], references: [id])

  qualityInspections QualityInspection[]
  stock              FinishedGoodsStock[]
  /// Every stock-in, dispatch and adjustment of this batch (A-13).
  stockMovements     StockMovement[]

  // Phase 4 - every allocation is a traceability link from an order line to a
  // specific pack batch, and through it back to the farmer.
  allocations OrderAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productionBatchId])
  @@index([qaReleased])
  @@index([holdStatus])
  @@map("finished_goods_batches")
}

/// FRD Section 23 - packaged stock awaiting dispatch.
enum BatchHoldStatus {
  ACTIVE
  ON_HOLD
  RECALLED
}

/// Append-only audit of every freeze, recall and release of a finished goods batch.
model BatchHoldEvent {
  id String @id @default(uuid())

  fgBatchId String
  fgBatch   FinishedGoodsBatch @relation(fields: [fgBatchId], references: [id])

  fromStatus BatchHoldStatus
  toStatus   BatchHoldStatus
  reason     String

  performedById String
  performedBy   User   @relation("BatchHoldEvents", fields: [performedById], references: [id])

  createdAt DateTime @default(now())

  @@index([fgBatchId])
  @@map("batch_hold_events")
}

model FinishedGoodsStock {
  id String @id @default(uuid())

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  fgBatchId String
  fgBatch   FinishedGoodsBatch @relation(fields: [fgBatchId], references: [id])

  quantity         Int
  reservedQuantity Int @default(0)

  storageLocation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([warehouseId, fgBatchId])
  @@index([warehouseId])
  @@map("finished_goods_stock")
}

/// Shared per-day sequence for PB- and FG- numbers, keyed by prefix+date so
/// the two series increment independently.
model SequenceCounter {
  /// e.g. "PB-20260807" or "FG-20260807"
  key        String @id
  lastNumber Int    @default(0)

  @@map("sequence_counters")
}

// ---------------------------------------------------------------------------
// Product Master
// ---------------------------------------------------------------------------

model Product {
  id       String  @id @default(uuid())
  name     String
  sku      String  @unique
  unit     String // e.g. KG, LITRE, PACK
  isActive Boolean @default(true)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  // --- Storefront catalogue metadata -----------------------------------
  // Nothing above this line was written with a shopper in mind - `name` is an
  // operations label, not marketing copy. These fields are additive and
  // optional so every screen and API caller that already reads Product is
  // unaffected; they matter only once `showOnStorefront` is turned on.
  description      String?
  images           String[] @default([])
  /// Off by default: an internal SKU does not appear to a shopper until staff
  /// deliberately publish it, same reasoning as isActive gating pickers.
  showOnStorefront Boolean  @default(false)

  /// URL-safe, unique when set. Null is fine - a product not yet published
  /// does not need one, and requiring it up front would block creating a
  /// product before its storefront copy is ready.
  slug            String? @unique
  metaTitle       String?
  metaDescription String?

  /// Inventory thresholds, product-level rather than per-warehouse for now -
  /// the catalogue asks "should this be flagged low" as one number, not one
  /// per location. Per-warehouse thresholds are a real future need (a branch
  /// with its own reorder cadence) but nothing today asks for it, so it is
  /// not built. Sellable quantity itself stays computed from
  /// FinishedGoodsStock, never duplicated here - these are only the trip
  /// wires against that live number.
  reorderPoint   Int?    @default(0)
  safetyStock    Int?    @default(0)
  allowBackorder Boolean @default(false)

  // --- Product detail page content (added 19 Sep) -----------------------
  // Everything below drives a section of the storefront product page, which
  // until now read a hardcoded mock array in the customer app. All optional
  // and additive: a product with none of it still renders, it just shows
  // fewer sections. Prices are deliberately NOT here - they stay dated
  // PriceList rules so historical invoices reproduce (see PriceList).

  /// Marketing brand, distinct from the manufacturer entity below.
  brand     String?
  /// The pack descriptor a shopper reads under the name - "10kg Bag",
  /// "100g x 20". Not `unit`, which is the operational measure (KG/PACK).
  packLabel String?
  /// Struck-through reference price. The sell price is a PriceList rule;
  /// this is the "was" figure a discount is calculated against, and it is a
  /// property of the pack, not of a channel.
  mrp       Decimal? @db.Decimal(12, 2)
  /// Small overlay on the product card - "Buy 10 Get 1", "100% Sharbati".
  badge     String?
  hsnCode   String?

  /// Display-only until a real review subsystem exists. Staff-entered, so a
  /// seeded catalogue does not show "0 ratings" on every card.
  rating      Decimal? @db.Decimal(3, 2)
  reviewCount Int?

  /// Bullet list above the fold on the product page.
  highlights String[] @default([])

  manufacturer    String?
  countryOfOrigin String?
  shelfLife       String?
  disclaimer      String?
  returnPolicy    String?
  warranty        String?

  /// B2C order limits, per order line.
  minOrderQuantity Int?
  maxOrderQuantity Int?

  /// B2B wholesale order parameters - the MOQ / max / master-pack trio the
  /// retailer view of the product page is built around.
  moqB2B              Int?
  maxOrderQuantityB2B Int?
  packBoxSize         Int?
  bulkAvailable       Boolean @default(false)

  /// The "Business & GST Compliance" panel, shown only to retailers.
  gstInvoiceAvailable    Boolean @default(true)
  businessSupportContact String?
  deliveryTerms          String?

  /// Which curated storefront shelves this product is pinned to. Homepage
  /// sections read these rather than a hardcoded list, so a Super Admin
  /// changing a product's price or name changes it everywhere it appears.
  /// `isTopPick` feeds "Popular Products" and each category's Top Picks tab;
  /// `isDailyStaple` feeds "Best of the Basics".
  /// How the B2B tier table is ENTERED. false = each tier is a per-unit price;
  /// true = each tier is the TOTAL for that quantity (5 packs -> 2750), and the
  /// per-unit price is derived from it. Either way PriceList.unitPrice holds the
  /// per-unit figure the order engine multiplies by quantity - see PriceList.tierTotal.
  b2bTiersAreTotals Boolean @default(false)

  isTopPick     Boolean @default(false)
  isDailyStaple Boolean @default(false)

  /// Per-product loyalty override. INHERIT = use the category rule.
  loyaltyEligibility LoyaltyEligibility @default(INHERIT)

  recipes              Recipe[]
  productionBatches    ProductionBatch[]
  finishedGoodsBatches FinishedGoodsBatch[]

  variants       ProductVariant[]
  specifications ProductSpecification[]
  faqs           ProductFaq[]
  offers         ProductOffer[]

  // Phase 4
  priceLists PriceList[]
  orderItems OrderItem[]

  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  wishlistedBy CustomerWishlistItem[]
  reviews      ProductReview[]

  @@index([categoryId])
  @@map("products")
}

/// Customer-facing taxonomy (added 16 Sep for the storefront catalogue).
/// Deliberately separate from the operational `category` string Product used
/// to carry - that was free text with no uniqueness, no hierarchy and no way
/// to render a collection page. A self-relation gives two levels of nesting
/// (e.g. "Flours" -> "Multigrain Flours") without a fixed depth limit; the
/// service refuses a category becoming its own ancestor.
model Category {
  id           String  @id @default(uuid())
  name         String
  /// URL-safe, unique - what a storefront collection page resolves on.
  slug         String  @unique
  description  String?
  imageUrl     String?
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  /// Loyalty default for everything filed here. INHERIT = ask the parent
  /// category, then the program default. A product can override it.
  loyaltyEligibility LoyaltyEligibility @default(INHERIT)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@map("categories")
}

// ---------------------------------------------------------------------------
// Product detail page content (added 19 Sep)
//
// Four child tables rather than JSON columns on Product: each is an ordered
// list a Super Admin edits row by row, and the admin screen needs to reorder
// and delete individual entries. JSON would make every edit a
// read-modify-write of the whole blob, and would put no constraint on shape.
// ---------------------------------------------------------------------------

/// A pack size / SKU variation of the same product - "5kg Bag" vs "10kg Bag".
///
/// A variant carries its own SKU and MRP, but NOT its own price column:
/// prices are PriceList rules keyed on (product, variant, channel, quantity),
/// so a variant's rate is superseded and dated exactly like a product's.
model ProductVariant {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name   String
  /// Unique across the catalogue, same rule as Product.sku - a variant is a
  /// distinct sellable unit and a picking slip has to resolve it.
  sku    String   @unique
  /// Falls back to the parent product's unit when null.
  unit   String?
  mrp    Decimal? @db.Decimal(12, 2)
  images String[] @default([])

  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  priceLists PriceList[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, displayOrder])
  @@map("product_variants")
}

/// One row of the specifications table - "Net Weight" / "10 KG".
model ProductSpecification {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  label        String
  value        String
  displayOrder Int    @default(0)

  @@index([productId, displayOrder])
  @@map("product_specifications")
}

/// One question and answer in the product page's FAQ accordion.
model ProductFaq {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  question     String
  answer       String
  displayOrder Int    @default(0)

  @@index([productId, displayOrder])
  @@map("product_faqs")
}

/// A bank/promotional offer line shown on the product page. Distinct from
/// `Scheme`, which is a homepage tile and belongs to no product.
model ProductOffer {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  title        String
  description  String
  displayOrder Int    @default(0)

  @@index([productId, displayOrder])
  @@map("product_offers")
}

// ---------------------------------------------------------------------------
// Warehouse Master (stub - stock/batch relations added in Phase 2-3)
// ---------------------------------------------------------------------------

model Warehouse {
  id       String   @id @default(uuid())
  name     String
  location String
  capacity Decimal? @db.Decimal(12, 2)
  isActive Boolean  @default(true)

  /// CENTRAL = the depot that ships nationally through the 3PL. OUTLET = a
  /// franchise store that delivers locally with its own riders. Both hold
  /// finished goods stock in the same table, so there is one inventory truth.
  kind            WarehouseKind @default(CENTRAL)
  city            String?
  state           String?
  pincode         String?
  /// Where the node physically is, for the distance test at checkout.
  latitude        Decimal?      @db.Decimal(9, 6)
  longitude       Decimal?      @db.Decimal(9, 6)
  /// How far this outlet delivers. Null = the program default (CheckoutSettings).
  serviceRadiusKm Decimal?      @db.Decimal(6, 2)
  contactPhone    String?

  stockReservations StockReservation[]

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  // Phase 2
  batches           RawMaterialBatch[]
  stock             WarehouseStock[]
  movementsOutgoing StockMovement[]    @relation("StockMovementFrom")
  movementsIncoming StockMovement[]    @relation("StockMovementTo")

  // Phase 3
  finishedGoodsStock FinishedGoodsStock[]

  // Phase 4
  orders           Order[]
  orderAllocations OrderAllocation[]

  /// Runs drawing raw material from here (FRD 17.2 reservation).
  productionBatches ProductionBatch[]

  // Supplier transports destined for this warehouse
  supplierTransports SupplierTransport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("warehouses")
}

// ===========================================================================
// PHASE 4 - SALES, ORDER FULFILMENT & DELIVERY (FRD Sections 24-28)
//
// Client decision, 11-Aug-2026: the system sells through BOTH channels, B2B
// (distributors and retailers, taken by a sales executive) and B2C (consumers
// buying directly), at DIFFERENT PRICES.
//
// Two consequences are baked into the model rather than bolted on later:
//
//   1. `channel` is a first-class column on Customer and Order. Nothing in the
//      order path is allowed to assume a single channel.
//   2. Price is not a column on Product. It lives in a dated PriceList keyed on
//      (product, channel, customerType), so the two channels can never collide
//      and an invoice raised last quarter still reprints at last quarter's rate.
// ===========================================================================

enum SalesChannel {
  B2B
  B2C
}

enum CustomerType {
  DISTRIBUTOR
  RETAILER
  INSTITUTIONAL
  CONSUMER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

/// Credit is a B2B concept. Consumers pay up front, always.
enum PaymentTerms {
  PREPAID
  CREDIT_7
  CREDIT_15
  CREDIT_30
  CREDIT_45
}

enum OrderStatus {
  DRAFT
  PLACED
  CONFIRMED
  ALLOCATED
  PACKED
  DISPATCHED
  DELIVERED
  CANCELLED
}

model Customer {
  id String @id @default(uuid())

  /// Format: CUST-B2B-000001 / CUST-B2C-000001. Channel is visible in the code
  /// itself because operations staff read these aloud on the phone.
  customerCode String @unique

  channel SalesChannel
  type    CustomerType

  name        String
  contactName String?
  phone       String
  email       String?

  /// Required for B2B (needed on the tax invoice), never required for B2C.
  /// Enforced in CustomersService, not by the database, so the rule is testable.
  gstin String?

  billingAddress  String
  shippingAddress String?
  city            String?
  district        String?
  state           String?
  pincode         String?

  creditLimit  Decimal?     @db.Decimal(14, 2)
  paymentTerms PaymentTerms @default(PREPAID)

  status CustomerStatus @default(ACTIVE)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  /// Sales executive who owns the relationship. B2C customers have none.
  assignedToId String?
  assignedTo   User?   @relation("CustomerAssignedTo", fields: [assignedToId], references: [id])

  orders Order[]

  /// The storefront login attached to this record, if they shop online.
  /// Staff-created customers who only ever order by phone have none.
  account CustomerAccount?

  /// Auto-generated on creation (every channel, every creation path - staff
  /// form and self-registration alike), unique, human-shareable
  /// (e.g. "RAUNAK4821"). This is the code printed into their referral link;
  /// see Referral below for the relationship it is used to create.
  referralCode String @unique

  /// The relationship that brought this customer in, if any - null for
  /// everyone who signed up without a code or was created by staff.
  referredAs Referral? @relation("ReferralReferee")

  /// Everyone this customer has successfully referred.
  referralsGiven Referral[] @relation("ReferralReferrer")

  /// Denormalised running total - see CoinTransaction for the ledger that is
  /// the actual source of truth.
  coinBalance      Int               @default(0)
  coinTransactions CoinTransaction[]

  addresses         CustomerAddress[]
  checkoutSessions  CheckoutSession[]
  couponRedemptions CouponRedemption[]

  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  wishlistItems  CustomerWishlistItem[]
  supportTickets SupportTicket[]
  productReviews ProductReview[]

  @@index([channel])
  @@index([status])
  @@index([branchId])
  @@map("customers")
}

/// One row per successful referral. Deliberately not just a `referredById`
/// field on Customer: a dedicated row gives an audit trail (the code as it was
/// entered, when) that survives the referrer later regenerating their own
/// code, and `refereeId` being unique is what makes "this customer already has
/// a referral relationship" a database guarantee rather than an application
/// check that something could race.
///
/// Created exactly once, at the moment the referee's Customer row is created
/// (B2C: first OTP verify; B2B: staff approval) - never on code entry or link
/// open, which is not a successful referral yet. See
/// storefront-auth.service.ts's `resolveReferral`.
model Referral {
  id String @id @default(uuid())

  referrerId String
  referrer   Customer @relation("ReferralReferrer", fields: [referrerId], references: [id])

  refereeId String   @unique
  referee   Customer @relation("ReferralReferee", fields: [refereeId], references: [id])

  /// The code as entered at signup, kept even if the referrer's own code is
  /// later regenerated - the audit trail should not silently change under it.
  code String

  /// Set once the configured reward trigger has fired and coins have been
  /// credited to both sides - null means "not yet rewarded", not "never will
  /// be". Checked before crediting so a relationship is never paid out twice,
  /// including across an admin changing the trigger after some referrals
  /// already earned their reward under the old one.
  rewardedAt DateTime?

  coinTransactions CoinTransaction[]

  createdAt DateTime @default(now())

  @@index([referrerId])
  @@map("referrals")
}

enum ReferralRewardTrigger {
  REGISTRATION
  ACCOUNT_VERIFICATION
  FIRST_ORDER
  FIRST_DELIVERY
}

enum CoinTransactionReason {
  REFERRAL_REFERRER_REWARD
  REFERRAL_REFEREE_REWARD
  /// Loyalty points earned on a DELIVERED order. `expiresAt`/`remainingAmount`
  /// are set on these rows only.
  LOYALTY_EARN
  /// Negative. Points taken back because eligible items were returned/refunded.
  LOYALTY_REVERSAL
  /// Negative. Unspent points that passed their `expiresAt`.
  LOYALTY_EXPIRY
  /// Negative. Points spent to pay part of an order at checkout.
  LOYALTY_REDEMPTION
  /// Positive. Redeemed points given back because the order was cancelled.
  LOYALTY_REDEMPTION_REFUND
  /// A Super Admin correction - refund, reversal, or any other manual fix.
  /// `amount` carries the sign (negative claws back); `note` is required at
  /// the API layer for this reason, because unlike the two above there is no
  /// automatic event to point back to.
  MANUAL_ADJUSTMENT
}

/// Staff-configured, single row (see ReferralService.getSettings, which
/// lazily creates it - there is no seed script for a fresh database).
/// Read live at every candidate trigger event rather than frozen onto a
/// Referral at creation, so changing the trigger applies to relationships
/// already in flight, not only ones created after the change.
model ReferralSettings {
  id String @id @default(uuid())

  referrerRewardCoins Int                   @default(100)
  refereeRewardCoins  Int                   @default(50)
  rewardTrigger       ReferralRewardTrigger @default(REGISTRATION)

  /// The program-wide kill switch. While false: no new referral code may be
  /// entered at signup, and nothing already in flight is credited, regardless
  /// of when its Referral row was created.
  isActive Boolean @default(true)

  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("referral_settings")
}

/// The coin ledger. `Customer.coinBalance` is a denormalised running total for
/// cheap reads - never written to directly outside ReferralService.creditReward,
/// which always writes the matching row here in the same transaction. Same
/// invariant this project already holds for warehouse stock and StockMovement:
/// a balance never moves without a ledger entry explaining why.
model CoinTransaction {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  /// Positive credits, negative debits. The two referral reasons are always
  /// positive (nothing spends coins yet); MANUAL_ADJUSTMENT is the one reason
  /// that can go either way - a refund/bonus is positive, a clawback/reversal
  /// is negative. `Customer.coinBalance` is always incremented by exactly
  /// this value, so the balance is correct under either sign without a
  /// separate debit code path.
  amount Int
  reason CoinTransactionReason

  /// Free text. Required at the API layer for MANUAL_ADJUSTMENT (the "why" -
  /// there is no automatic event to point back to); optional and usually
  /// unset for the two referral reasons, which speak for themselves via
  /// `referralId`.
  note String?

  referralId String?
  referral   Referral? @relation(fields: [referralId], references: [id])

  /// The order whose CONFIRMED/DELIVERED transition triggered this reward,
  /// when the configured trigger is order-based. Null for REGISTRATION/
  /// ACCOUNT_VERIFICATION rewards (no order exists yet) and for every
  /// MANUAL_ADJUSTMENT.
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  /// LOYALTY_EARN only: when these points lapse (null = never), and how many of
  /// them are still live. Reversals and expiry both draw `remainingAmount` down,
  /// which is what stops a return reversing points that already expired.
  expiresAt       DateTime?
  remainingAmount Int?

  /// Staff who made a MANUAL_ADJUSTMENT. Null for every system-generated row
  /// (both referral reward reasons) - there is no "performer" for those,
  /// only a trigger event.
  performedById String?
  performedBy   User?   @relation("CoinTransactionsPerformed", fields: [performedById], references: [id])

  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([reason, expiresAt])
  @@map("coin_transactions")
}

/// A dated price for one product in one channel.
///
/// Rows are never edited once orders reference them - supersede by closing
/// `effectiveTo` and inserting a new row. That is what keeps historical
/// invoices reproducible.
model PriceList {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  /// Which pack size this rate is for. Null means the rule prices the product
  /// itself, which is every row written before 19 Sep 2026 and every row an
  /// order line resolves today.
  ///
  /// Resolution treats null as a value, not a wildcard: a product-level
  /// lookup matches ONLY null rows, so a variant rate can never leak into a
  /// line that did not ask for that variant.
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  channel SalesChannel

  /// Optional refinement within a channel - e.g. distributors get a keener
  /// rate than retailers. Null means "any customer type in this channel".
  customerType CustomerType?

  unitPrice Decimal @db.Decimal(12, 2)
  currency  String  @default("INR")

  /// Held per price row because GST rate is a property of what is being sold
  /// and can change by notification.
  gstRatePercent Decimal @default(5) @db.Decimal(5, 2)

  /// Quantity break. A row with minQuantity 50 beats one with minQuantity 1
  /// when the line qualifies.
  minQuantity Int @default(1)

  /// Set only when the tier was entered as a total for minQuantity units. Kept so
  /// the admin form shows back exactly what was typed (1000 over 3 units is 333.33
  /// per unit, and 333.33 x 3 would read 999.99). unitPrice = tierTotal / minQuantity.
  tierTotal Decimal? @db.Decimal(12, 2)

  effectiveFrom DateTime
  effectiveTo   DateTime?

  isActive Boolean @default(true)

  createdById String
  createdBy   User   @relation("PriceListsCreated", fields: [createdById], references: [id])

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, channel, effectiveFrom])
  @@index([variantId])
  @@index([channel])
  @@map("price_lists")
}

model Order {
  id String @id @default(uuid())

  /// Format: SO-YYYYMMDD-NNN
  orderNumber String @unique

  /// Denormalised from the customer deliberately: the channel an order was
  /// taken through is a fact about the order, and must not change if the
  /// customer record is later edited.
  channel SalesChannel

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  status OrderStatus @default(DRAFT)

  orderDate      DateTime
  requiredByDate DateTime?

  /// Warehouse the order is fulfilled from - allocation only draws stock here.
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  subtotal Decimal @default(0) @db.Decimal(14, 2)
  taxTotal Decimal @default(0) @db.Decimal(14, 2)
  total    Decimal @default(0) @db.Decimal(14, 2)

  paymentStatus PaymentStatus @default(PENDING)
  paymentTerms  PaymentTerms  @default(PREPAID)

  /// Sales executive who captured the order. Null for a B2C order the consumer
  /// placed themselves.
  placedById String?
  placedBy   User?   @relation("OrdersPlaced", fields: [placedById], references: [id])

  /// Where this order was shipped, captured at the moment it was raised.
  ///
  /// A snapshot, not a lookup. It used to be inferred from the customer's
  /// current `shippingAddress`, which meant editing a customer retroactively
  /// rewrote where every past order had been delivered - the same class of
  /// error the denormalised `channel` above already guards against. Defaults
  /// from the customer at create time and can be overridden per order, which
  /// is what a one-off delivery to a different site actually needs.
  deliveryAddress String?

  notes           String?
  cancelledReason String?
  cancelledAt     DateTime?

  /// When the goods physically left the warehouse.
  ///
  /// Written by `advance()` at the DISPATCHED transition. Exists because
  /// "Delayed Shipments" (FRD 34, Delivery Reports) compares this against
  /// `requiredByDate`, and status alone cannot answer it - an order that is
  /// DISPATCHED tells you it left, never when.
  ///
  /// It is also the only defensible start for the credit period: CREDIT_30 has
  /// to count from something, and dispatch is the point the customer actually
  /// received value. See SVV_Balaji_FRD34_Reporting_Gaps.md - the client has
  /// not confirmed this yet.
  dispatchedAt DateTime?

  /// When the customer took delivery. Written by `advance()` at DELIVERED.
  ///
  /// The other half of "Delivery Performance". Deliberately separate from
  /// `dispatchedAt` rather than derived from it: transit time is the number
  /// worth watching, and it is the difference between the two.
  deliveredAt DateTime?

  items       OrderItem[]
  allocations OrderAllocation[]

  /// Set on a referral reward's ledger rows when a FIRST_ORDER/FIRST_DELIVERY
  /// trigger paid out because of this specific order - see CoinTransaction.
  coinTransactions CoinTransaction[]

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  loyaltyEarn LoyaltyOrderEarn?
  returns     OrderReturn[]

  // ---- Storefront checkout (all null/default for staff-placed orders) ----
  source            OrderSource        @default(STAFF)
  /// LOCAL (franchise outlet, in-house rider) or SHIPROCKET (central depot, 3PL).
  /// Decided by the server from the delivery address; the customer never picks it.
  fulfillmentMethod FulfillmentMethod?
  /// Immutable copy of the delivery address as it was when the order was placed.
  addressSnapshot   Json?
  /// The full server-side quote (lines, tax, discounts, fee, ETA) frozen at placement.
  pricingSnapshot   Json?
  distanceKm        Decimal?           @db.Decimal(8, 2)
  etaMin            DateTime?
  etaMax            DateTime?

  /// Doorstep proof-of-delivery code. Shown only to the customer who owns the
  /// order; staff enter what the customer reads out.
  deliveryOtp           String?
  deliveryOtpAttempts   Int       @default(0)
  deliveryOtpVerifiedAt DateTime?

  paymentMode      PaymentMode?
  gatewayOrderId   String?
  gatewayPaymentId String?

  discountTotal         Decimal @default(0) @db.Decimal(14, 2)
  deliveryFee           Decimal @default(0) @db.Decimal(14, 2)
  couponCode            String?
  loyaltyRedeemedPoints Int     @default(0)
  loyaltyRedeemedInr    Decimal @default(0) @db.Decimal(14, 2)

  riderName  String?
  riderPhone String?

  checkoutSessionId String?          @unique
  checkoutSession   CheckoutSession? @relation(fields: [checkoutSessionId], references: [id])

  shipment            OrderShipment?
  events              OrderEvent[]
  paymentTransactions PaymentTransaction[]
  stockReservations   StockReservation[]
  couponRedemption    CouponRedemption?
  productReviews      ProductReview[]

  @@index([channel])
  @@index([status])
  @@index([customerId])
  @@index([orderDate])
  /// Every delivery report is a date-range scan over dispatches. Partial,
  /// because an order that has not shipped is never in one of those answers.
  @@index([dispatchedAt])
  @@map("orders")
}

model OrderItem {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  /// Packs ordered.
  quantity Int

  /// Resolved from the price list at placement and then frozen. A later price
  /// change must never silently restate an order that is already out.
  unitPrice Decimal @db.Decimal(12, 2)

  /// Which price rule was applied. Kept so a disputed invoice can be answered
  /// with "this row, effective this date" rather than an opinion.
  priceListId String?
  priceList   PriceList? @relation(fields: [priceListId], references: [id])

  gstRatePercent Decimal @db.Decimal(5, 2)

  lineSubtotal Decimal @db.Decimal(14, 2)
  /// This line's pro-rata share of the order-level discount (coupon + points
  /// redeemed). GST is charged on subtotal minus this.
  lineDiscount Decimal @default(0) @db.Decimal(14, 2)
  lineTax      Decimal @db.Decimal(14, 2)
  lineTotal    Decimal @db.Decimal(14, 2)

  /// Frozen at placement so a later rename or re-SKU never rewrites history.
  skuSnapshot  String?
  nameSnapshot String?

  allocations OrderAllocation[]

  loyaltyLine LoyaltyOrderEarnLine?
  returns     OrderReturn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, productId])
  @@index([orderId])
  @@map("order_items")
}

/// Which physical pack batches satisfy an order line.
///
/// This is the row that keeps the traceability promise alive through the sales
/// half of the system: order -> allocation -> FG batch -> production run ->
/// raw material batch -> farmer. Without it, a delivered order is anonymous.
model OrderAllocation {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  fgBatchId String
  fgBatch   FinishedGoodsBatch @relation(fields: [fgBatchId], references: [id])

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  quantity Int

  allocatedById String
  allocatedBy   User   @relation("OrderAllocations", fields: [allocatedById], references: [id])

  /// Set when the reservation is given back - cancelling the order, or a
  /// re-allocation. The row is never deleted.
  ///
  /// A-13 (16 Aug): cancel() used to `deleteMany` these after releasing the
  /// reservations. The stock was returned correctly, but the record of WHICH
  /// batches were promised to this customer was destroyed - so "you allocated
  /// me FG-20260812-003 and then cancelled" had no answer in the data. For a
  /// traceability product that is a strange place to economise, and once
  /// finished goods have movements the release would show as stock activity
  /// with nothing to explain it.
  ///
  /// Every read of LIVE allocations filters `releasedAt: null`.
  releasedAt     DateTime?
  releasedReason String?

  /// Set when packing staff scan this batch's label against the order, proving
  /// the pack physically in the box is the batch the system allocated (FIFO).
  scannedAt   DateTime?
  scannedById String?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([fgBatchId])
  @@map("order_allocations")
}

// ---------------------------------------------------------------------------
// Role-based access control (WS2.x, 15 Aug)
// ---------------------------------------------------------------------------

/// One grant: this role holds this permission.
///
/// The row's existence IS the grant - there is no `allowed` boolean, because a
/// row saying "denied" and no row at all would mean the same thing and would
/// eventually disagree. Revoking deletes.
///
/// `permission` is a plain string rather than an enum on purpose. The
/// authoritative list lives in src/auth/permissions/registry.ts, and writes are
/// validated against it. Making it a Postgres enum would mean a migration every
/// time a screen is added - which is the exact coupling this table exists to
/// remove.
///
/// SUPER_ADMIN never appears here. PermissionsGuard short-circuits for it, so
/// storing its grants would create a state where the last administrator can be
/// locked out of the administration screen.
model RolePermission {
  id String @id @default(uuid())

  role       UserRole
  permission String

  createdAt DateTime @default(now())

  @@unique([role, permission])
  @@index([role])
  @@map("role_permissions")
}

/// Marks a role as having been configured at least once.
///
/// Without this, "this role holds no permissions" and "this role has never been
/// set up" are the same empty result, and the seeder could not tell whether an
/// empty grant set was deliberate. A Super Admin who deliberately strips a role
/// bare must not have the defaults handed back to it on the next restart.
/// Every permission key the system has already reconciled against role grants.
///
/// This is what lets boot tell a NEW key from one an administrator deliberately
/// revoked (A-14). A key absent here is new: configured roles whose registry
/// defaults include it are granted it once, then it is recorded. A key present
/// here is never re-granted, so revocations stick across restarts.
model PermissionKeyState {
  permission String   @id
  seenAt     DateTime @default(now())

  @@map("permission_key_state")
}

model RolePermissionState {
  role UserRole @id

  seededAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@map("role_permission_state")
}

// ---------------------------------------------------------------------------
// Land profiling (WS3.1, 16 Aug)
// ---------------------------------------------------------------------------

/// One cultivable plot belonging to a farmer.
///
/// Farmers here rarely hold a single contiguous field - two or three scattered
/// plots with different soil, irrigation and crops is the norm. The summary
/// fields on `Farmer` (farmSizeAcres, landType, irrigationType, cropDetails)
/// average all of that into one row, which is fine for a registry and useless
/// for advisory work: an Agriculture Expert advising on irrigation needs to
/// know WHICH plot is rain-fed.
///
/// Those Farmer fields are deliberately left in place. They are what the
/// onboarding desk captures at registration and what every existing screen
/// reads; plots are the detail the field executive adds afterwards. Removing
/// them would be a migration across six screens for no gain.
model FarmPlot {
  id String @id @default(uuid())

  farmerId String
  farmer   Farmer @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  /// What the farmer calls it, or the revenue survey number.
  name         String
  surveyNumber String?

  areaAcres Decimal @db.Decimal(10, 2)

  soilType       String?
  irrigationType String?
  waterSource    String?

  /// What is growing on it now. Free text, because the crop list is not a
  /// master in this system and inventing one here would fork it from the
  /// crop names used on agreements and collections.
  currentCrop     String?
  sowingDate      DateTime?
  expectedHarvest DateTime?

  /// "lat,lng" captured on the plot, same format as Farmer.gpsLocation. Held
  /// as text rather than two Decimals to match what is already stored and read
  /// by the trace page - one format, one parser.
  gpsLocation String?

  notes String?

  isActive Boolean @default(true)

  createdById String
  createdBy   User   @relation("FarmPlotsCreated", fields: [createdById], references: [id])

  /// What has been harvested from this plot. These are what turn a plot from a
  /// description into part of the traceability chain.
  harvestInspections HarvestInspection[]     @relation("InspectedPlot")
  collections        RawMaterialCollection[] @relation("HarvestedPlot")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmerId])
  @@map("farm_plots")
}

// ===========================================================================
// SUPPLIER MODULE
//
// Suppliers are external entities who deliver raw materials but are NOT
// farmers. They don't have land profiles, seed distribution, training,
// field visits or harvest inspections. Instead of the Collection flow,
// they use Transport for inbound logistics, and Purchase Orders instead
// of Agreements.
// ===========================================================================

// ---------------------------------------------------------------------------
// Supplier (analogous to Farmer, but simpler)
// ---------------------------------------------------------------------------

model Supplier {
  id           String  @id @default(uuid())
  supplierCode String? @unique // SUP-YYYY-NNNNNN - assigned on approval

  fullName      String
  mobile        String
  aadhaarNumber String?
  panNumber     String?

  /// Business/firm name. Many suppliers in India operate as sole
  /// proprietorships and won't have one — keep it optional.
  companyName String?
  /// GST Identification Number for B2B tax invoices.
  gstin       String?

  address  String?
  city     String?
  district String?
  state    String?
  pincode  String?

  bankAccountName String?
  bankName        String?
  bankAccountNo   String?
  ifscCode        String?

  status SupplierStatus @default(PENDING_VERIFICATION)

  createdById String?
  createdBy   User?   @relation("SuppliersCreated", fields: [createdById], references: [id])

  verificationLogs   SupplierVerificationLog[]
  transports         SupplierTransport[]
  purchaseOrders     PurchaseOrder[]
  rawMaterialBatches RawMaterialBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("suppliers")
}

// ---------------------------------------------------------------------------
// Supplier code sequence - backs SUP-YYYY-NNNNNN traceability ID.
// ---------------------------------------------------------------------------

model SupplierCodeCounter {
  year       Int @id
  lastNumber Int @default(0)

  @@map("supplier_code_counters")
}

// ---------------------------------------------------------------------------
// Supplier Verification Audit Trail (same pattern as FarmerVerificationLog)
// ---------------------------------------------------------------------------

model SupplierVerificationLog {
  id         String   @id @default(uuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  action  SupplierVerificationAction
  remarks String?

  verifiedById String
  verifiedBy   User   @relation(fields: [verifiedById], references: [id])

  createdAt DateTime @default(now())

  @@index([supplierId])
  @@map("supplier_verification_logs")
}

// ---------------------------------------------------------------------------
// Purchase Orders (industry-standard supplier agreements)
//
// A Purchase Order is a binding commitment: SVV Balaji agrees to buy a
// specific material at a specific rate, and the supplier commits to deliver
// by a date. Transports reference the PO they fulfil so cost and quantity
// can be reconciled.
// ---------------------------------------------------------------------------

model PurchaseOrder {
  id String @id @default(uuid())

  /// Format: PO-YYYYMMDD-NNN
  poNumber String @unique

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  materialName     String
  expectedQuantity Decimal @db.Decimal(12, 2)
  unit             String  @default("KG")
  purchaseRate     Decimal @db.Decimal(12, 2)
  totalAmount      Decimal @db.Decimal(14, 2)

  orderDate    DateTime
  deliveryDate DateTime?

  qualityStandards String?
  terms            String?

  status PurchaseOrderStatus @default(DRAFT)

  createdById String
  createdBy   User   @relation("PurchaseOrdersCreated", fields: [createdById], references: [id])

  transports SupplierTransport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

// ---------------------------------------------------------------------------
// Supplier Transport (replaces Collection for suppliers)
//
// Lifecycle: SCHEDULED → IN_TRANSIT → DELIVERED (auto-creates batch)
//
// When a transport reaches DELIVERED, a RawMaterialBatch is automatically
// created in the destination warehouse — same as how Collection creates
// one for farmers, but without the inspection gate.
// ---------------------------------------------------------------------------

model SupplierTransport {
  id String @id @default(uuid())

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  /// Optional link to the PO this delivery fulfils.
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  materialName String
  quantity     Decimal @db.Decimal(12, 2)
  unit         String  @default("KG")

  vehicleNumber String?
  driverName    String?
  driverPhone   String?

  scheduledDate DateTime
  dispatchedAt  DateTime?
  deliveredAt   DateTime?

  deliveryLocation String?

  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  purchaseRate  Decimal?      @db.Decimal(12, 2)
  totalAmount   Decimal?      @db.Decimal(14, 2)
  paymentStatus PaymentStatus @default(PENDING)

  /// Receipt issued on delivery, same pattern as RawMaterialCollection.
  receiptNumber String? @unique

  batch RawMaterialBatch?

  status  TransportStatus @default(SCHEDULED)
  remarks String?

  createdById String
  createdBy   User   @relation("TransportsCreated", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([status])
  @@index([warehouseId])
  @@map("supplier_transports")
}

// ===========================================================================
// STOREFRONT IDENTITY (FRD Sections 29-31)
//
// Everything above this line is operated by staff: a User signs in and acts on
// records. The storefront is the first surface where somebody outside the
// company authenticates, and that difference is why identity is modelled here
// rather than by adding a CUSTOMER value to UserRole.
//
// Three things are deliberate:
//
//   1. CustomerAccount is the *login*; Customer is the *commercial record*.
//      They are separate because a B2B retailer signs up before anyone has
//      agreed to trade with them - they need somewhere to exist while pending
//      approval, without occupying a customerCode or appearing in the customer
//      master as though they were a live account. B2C consumers get both at
//      once, since there is nothing to approve.
//   2. Phone is unique here but NOT on Customer. A distributor and its depot
//      legitimately share a phone number in the customer master; a login
//      cannot.
//   3. Customer tokens are signed with their own secret (see
//      CUSTOMER_JWT_ACCESS_SECRET). JwtStrategy.validate() trusts any payload
//      carrying a valid signature without re-reading the user, so sharing the
//      staff secret would make a storefront token a staff token.
// ===========================================================================

enum CustomerAccountStatus {
  /// Signed up, phone not yet proven.
  PENDING_VERIFICATION
  /// B2B only: phone proven, waiting on staff to approve the business.
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  SUSPENDED
}

enum CustomerOtpPurpose {
  LOGIN
  REGISTRATION
}

model CustomerAccount {
  id String @id @default(uuid())

  /// 10-digit Indian mobile number, normalised (country code and punctuation
  /// stripped) before storage so that +91 98765 43210 and 9876543210 are the
  /// same account rather than two.
  phone String  @unique
  email String?

  fullName String

  /// Which storefront they signed up through. B2C self-serves; B2B is the
  /// retailer registration flow and requires approval.
  channel SalesChannel
  status  CustomerAccountStatus @default(PENDING_VERIFICATION)

  phoneVerifiedAt DateTime?
  lastLoginAt     DateTime?

  /// Rotated on every refresh, same contract as User.refreshTokenHash - one
  /// live session per account.
  refreshTokenHash String?

  /// The commercial record orders actually hang off. Null until the account is
  /// approved (B2B) or first verified (B2C).
  customerId String?   @unique
  customer   Customer? @relation(fields: [customerId], references: [id])

  // --- B2B registration details, captured at signup, before a Customer exists
  businessName String?
  gstin        String?
  pan          String?
  addressLine  String?
  city         String?
  district     String?
  state        String?
  pincode      String?

  /// A referral code entered at signup, held here until there is a Customer
  /// row to attach it to. B2C resolves it immediately (the Customer is
  /// created in the same call); B2B carries it until staff approve the
  /// registration, which is when its Customer row - and the Referral - is
  /// created. Re-validated at approval time (referrer must still exist and be
  /// active); if it no longer resolves, the referral is silently skipped
  /// rather than blocking the approval - it is a bonus relationship, not a
  /// gate on the retailer's own account.
  referralCode String?

  reviewedById    String?
  reviewedBy      User?     @relation("CustomerAccountsReviewed", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?

  otpChallenges CustomerOtpChallenge[]

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  sessions  CustomerSession[]

  @@index([status])
  @@index([channel])
  @@map("customer_accounts")
}

/// A single OTP challenge. The code is stored hashed and is never readable
/// back out of the database - the same reason a password is not.
///
/// Rows are kept after use rather than deleted: consumedAt and attempts are
/// the only record of how a session was obtained, and a burst of failures
/// against one number is what abuse looks like.
model CustomerOtpChallenge {
  id String @id @default(uuid())

  phone    String
  codeHash String
  purpose  CustomerOtpPurpose @default(LOGIN)

  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)

  accountId String?
  account   CustomerAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([phone, createdAt])
  @@index([accountId])
  @@map("customer_otp_challenges")
}

// ---------------------------------------------------------------------------
// Storefront banners - Super Admin controlled hero/promo slots, resolved live
// by the customer app. See BannersService in the backend for the exact rules.
// ---------------------------------------------------------------------------

enum BannerPlacement {
  HOMEPAGE
  CATEGORIES_PAGE
  PRODUCTS_PAGE
}

enum BannerAudience {
  ALL
  B2C
  B2B
}

/// One promotional slide. `placement` decides which storefront screen shows
/// it, `targetAudience` narrows it to a channel, `displayOrder` decides slide
/// order within a placement, and `isActive` is the publish switch - the same
/// hide-don't-delete pattern as Category/Product.
model Banner {
  id String @id @default(uuid())

  title            String
  badgeText        String?
  description      String
  imageUrl         String
  ctaTextPrimary   String
  ctaLinkPrimary   String
  ctaTextSecondary String?
  ctaLinkSecondary String?
  backgroundColor  String          @default("#064e3b")
  textColor        String          @default("#ffffff")
  targetAudience   BannerAudience  @default(ALL)
  placement        BannerPlacement @default(HOMEPAGE)
  displayOrder     Int             @default(0)
  isActive         Boolean         @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, isActive, displayOrder])
  @@map("banners")
}

/// A "Today's Schemes & Offers" tile on the customer homepage. `displayOrder`
/// is the row/position Super Admin picks; `isActive` is the same
/// hide-don't-delete publish switch as Banner - deactivating (or deleting)
/// every scheme is how the whole homepage section is hidden, since the
/// storefront renders nothing when the published list is empty.
model Scheme {
  id String @id @default(uuid())

  tag             String
  title           String
  subtitle        String
  ctaText         String
  ctaLink         String         @default("/products/atta-flour")
  backgroundColor String         @default("#fce3cd")
  textColor       String         @default("#452b0d")
  badgeColor      String         @default("#965a0b")
  badgeTextColor  String         @default("#ffffff")
  buttonColor     String         @default("#8a4b08")
  buttonTextColor String         @default("#ffffff")
  targetAudience  BannerAudience @default(ALL)
  displayOrder    Int            @default(0)
  isActive        Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, displayOrder])
  @@map("schemes")
}

// ---------------------------------------------------------------------------
// Loyalty rewards (percentage-based, configured by Super Admin)
//
// Points ARE the coin ledger (`CoinTransaction`, `Customer.coinBalance`) - one
// currency shared with referral rewards, so a customer has one balance.
// ---------------------------------------------------------------------------

enum LoyaltyEligibility {
  INHERIT
  ELIGIBLE
  NOT_ELIGIBLE
}

/// What the percentage is applied to. Delivery/shipping charges are NEVER part
/// of either (they are not on order lines at all); GST is the only switch.
enum LoyaltyCalculationBase {
  /// Line value after the price is applied, before GST. The default: GST is
  /// not the company's revenue, so it should not fund rewards.
  EXCLUDING_TAX
  INCLUDING_TAX
}

/// Single row, lazily created (same pattern as ReferralSettings). Read live
/// when an order is delivered; what was applied is frozen on LoyaltyOrderEarn.
model LoyaltySettings {
  id String @id @default(uuid())

  /// Master switch. Off: delivered orders are recorded as "program off" and
  /// earn nothing - and are NOT retro-credited if it is switched on later.
  isActive Boolean @default(true)

  /// Percent of the eligible amount returned as rewards, per channel.
  /// 0 switches earning off for that channel.
  earnPercentB2C Decimal @default(2) @db.Decimal(5, 2)
  earnPercentB2B Decimal @default(1) @db.Decimal(5, 2)

  /// Rupees one point is worth. 1 = one point is Rs 1. 0.25 = four points per rupee.
  pointValueInr Decimal @default(1) @db.Decimal(10, 4)

  calculationBase LoyaltyCalculationBase @default(EXCLUDING_TAX)

  /// Whether a product with no explicit or category rule earns.
  defaultEligible Boolean @default(true)

  /// A line counts as discounted when its selling price (incl. GST) is below
  /// the product's MRP. Off = such lines earn nothing.
  appliesToDiscountedProducts Boolean @default(true)

  /// Optional guards. Null = no limit.
  minEligibleItemAmount  Decimal? @db.Decimal(12, 2)
  minEligibleOrderAmount Decimal? @db.Decimal(12, 2)
  /// Cap on the rupee value of rewards one order can earn.
  maxRewardPerOrderInr   Decimal? @db.Decimal(12, 2)

  /// Months until earned points lapse. Null/0 = never.
  pointsExpiryMonths Int?

  /// Whether customers may spend points at checkout.
  redemptionEnabled    Boolean @default(false)
  /// Most of an order's value points can pay for.
  maxRedemptionPercent Int     @default(50)
  /// Fewest points a redemption may use.
  minRedeemPoints      Int     @default(0)

  /// Only orders delivered on/after this are ever credited by the catch-up
  /// sweep, so switching the feature on never retro-pays history.
  earningStartsAt DateTime @default(now())

  updatedById String?
  updatedBy   User?    @relation("LoyaltySettingsUpdated", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("loyalty_settings")
}

/// One per DELIVERED order, unique on orderId - which is the idempotency
/// guarantee: an order can never be credited twice. Written even when nothing
/// is earned, so "why did I get no points?" always has a stored answer.
model LoyaltyOrderEarn {
  id String @id @default(uuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  customerId String

  /// Sum of the eligible lines' base amounts.
  eligibleAmount    Decimal                @db.Decimal(14, 2)
  /// The rules that produced this result, frozen at credit time.
  percentApplied    Decimal                @db.Decimal(5, 2)
  pointValueApplied Decimal                @db.Decimal(10, 4)
  calculationBase   LoyaltyCalculationBase
  /// Rupee value of the points credited (points x point value).
  rewardInr         Decimal                @db.Decimal(14, 2)
  points            Int
  cappedByMax       Boolean                @default(false)
  /// Why an order earned nothing: PROGRAM_OFF, NO_RATE, BELOW_MIN_ORDER, NO_ELIGIBLE_ITEMS.
  skipReason        String?

  coinTransactionId String? @unique

  lines LoyaltyOrderEarnLine[]

  createdAt DateTime @default(now())

  @@index([customerId])
  @@map("loyalty_order_earns")
}

model LoyaltyOrderEarnLine {
  id String @id @default(uuid())

  earnId String
  earn   LoyaltyOrderEarn @relation(fields: [earnId], references: [id], onDelete: Cascade)

  orderItemId String    @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  productId  String
  quantity   Int
  baseAmount Decimal @db.Decimal(14, 2)

  eligible          Boolean
  /// PRODUCT_NOT_ELIGIBLE, DISCOUNTED, BELOW_MIN_ITEM when not eligible.
  ineligibleReason  String?
  /// Where the eligibility decision came from: PRODUCT, CATEGORY, PARENT_CATEGORY, DEFAULT.
  eligibilitySource String

  points         Int
  /// How many of `points` have been taken back by returns. Never exceeds `points`.
  reversedPoints Int @default(0)

  @@index([earnId])
  @@map("loyalty_order_earn_lines")
}

/// A delivered item coming back / being refunded. The trigger for reversing
/// the loyalty points that item earned.
model OrderReturn {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  quantity     Int
  reason       String
  /// Money refunded for this return, when known. Informational.
  refundAmount Decimal? @db.Decimal(14, 2)

  recordedById String
  recordedBy   User   @relation("OrderReturnsRecorded", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([orderItemId])
  @@map("order_returns")
}

// ---------------------------------------------------------------------------
// Storefront checkout & fulfilment
// ---------------------------------------------------------------------------

enum WarehouseKind {
  CENTRAL
  OUTLET
}

enum OrderSource {
  STAFF
  STOREFRONT
}

enum FulfillmentMethod {
  LOCAL
  SHIPROCKET
}

enum PaymentMode {
  ONLINE
  COD
  /// B2B on account terms; the credit limit is enforced at placement.
  CREDIT
}

enum CheckoutSessionStatus {
  OPEN
  COMPLETED
  ABORTED
  EXPIRED
}

enum ReservationStatus {
  /// Short-lived (TTL) hold while the customer pays.
  HELD
  /// Firm: an order exists. Stays until packing turns it into batch allocations.
  COMMITTED
  /// Given back (payment failed / abandoned / order cancelled) or converted to allocations.
  RELEASED
  EXPIRED
}

enum PaymentTransactionStatus {
  PENDING
  PAID
  FAILED
  COD
  CREDIT
  REFUNDED
}

enum CouponType {
  PERCENT
  FIXED
}

/// A customer's saved delivery address. Coordinates decide LOCAL vs SHIPROCKET.
model CustomerAddress {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  label     String   @default("Home")
  fullName  String
  phone     String
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  pincode   String
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  isDefault Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@map("customer_addresses")
}

/// Single row of checkout / fulfilment rules, Super Admin editable.
model CheckoutSettings {
  id String @id @default(uuid())

  /// A franchise outlet whose own radius is unset delivers this far.
  localRadiusKm      Decimal @default(5) @db.Decimal(6, 2)
  /// The depot that fulfils everything outside local range and all B2B. Null = first active CENTRAL warehouse.
  centralWarehouseId String?

  localBaseFee   Decimal  @default(30) @db.Decimal(10, 2)
  localFreeAbove Decimal? @default(499) @db.Decimal(12, 2)
  shipBaseFee    Decimal  @default(60) @db.Decimal(10, 2)
  shipFreeAbove  Decimal? @default(999) @db.Decimal(12, 2)
  /// B2B bulk orders ship free above this (null = never free).
  b2bFreeAbove   Decimal? @default(5000) @db.Decimal(12, 2)
  b2bBaseFee     Decimal  @default(150) @db.Decimal(10, 2)

  /// ETA model. LOCAL: prepMinutes + distance x minutesPerKm. SHIPROCKET: whole days.
  prepMinutes  Int @default(30)
  minutesPerKm Int @default(4)
  shipMinDays  Int @default(3)
  shipMaxDays  Int @default(6)

  codEnabled   Boolean  @default(true)
  codMaxAmount Decimal? @default(5000) @db.Decimal(12, 2)

  /// How long stock is held while a customer pays.
  reservationTtlMinutes Int @default(15)
  deliveryOtpDigits     Int @default(4)

  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("checkout_settings")
}

/// One attempt to buy: the server's frozen quote, the stock hold, and the payment.
model CheckoutSession {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  status CheckoutSessionStatus @default(OPEN)

  /// Everything the server decided at the time: lines, prices, node, method, totals.
  quote       Json
  paymentMode PaymentMode

  gatewayProvider String?
  gatewayOrderId  String?

  expiresAt DateTime
  /// Set once the order exists. The unique constraint on Order.checkoutSessionId
  /// is what makes confirming twice return the SAME order.
  orderId   String?

  /// Client-supplied `Idempotency-Key` header on `POST /checkout/sessions`.
  /// A double-tap or retried request with the same key returns the session
  /// already created for it instead of opening a second stock hold - the same
  /// idempotency `Order.checkoutSessionId` already gives confirm(), one step
  /// earlier. Null for a client that sent no key, which is why the unique
  /// constraint is scoped to (customerId, idempotencyKey): Postgres treats
  /// every NULL as distinct, so keyless requests never collide with each
  /// other.
  idempotencyKey String?

  reservations StockReservation[]
  payments     PaymentTransaction[]
  order        Order?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, idempotencyKey])
  @@index([customerId])
  @@index([status, expiresAt])
  @@map("checkout_sessions")
}

/// Product-level stock earmarked for a checkout or a placed order, before
/// packing picks the exact FIFO batch. `available = stock - active reservations`.
model StockReservation {
  id String @id @default(uuid())

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  productId   String

  quantity  Int
  status    ReservationStatus @default(HELD)
  /// Only meaningful while HELD; COMMITTED holds have none.
  expiresAt DateTime?

  sessionId String?
  session   CheckoutSession? @relation(fields: [sessionId], references: [id])
  orderId   String?
  order     Order?           @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([warehouseId, productId, status])
  @@index([sessionId])
  @@index([orderId])
  @@map("stock_reservations")
}

/// The payment ledger. One row per attempt; a session can have several.
model PaymentTransaction {
  id String @id @default(uuid())

  sessionId String?
  session   CheckoutSession? @relation(fields: [sessionId], references: [id])
  orderId   String?
  order     Order?           @relation(fields: [orderId], references: [id])

  provider         String
  mode             PaymentMode
  gatewayOrderId   String?
  gatewayPaymentId String?
  amount           Decimal                  @db.Decimal(14, 2)
  status           PaymentTransactionStatus @default(PENDING)
  failureReason    String?
  raw              Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Defensive guard, not a live race fix: `gatewayPaymentId` is only ever
  /// written once, by `openPayment`, and later rows are `updateMany`'d by
  /// `sessionId`, never re-created - so nothing today can produce a
  /// duplicate. This stops the same real-world payment ever being attributed
  /// to two transaction rows if that assumption ever breaks. Multiple NULLs
  /// (every row before a payment ID exists) are unaffected - Postgres does
  /// not treat NULL as equal to NULL in a unique index.
  @@unique([gatewayPaymentId])
  @@index([sessionId])
  @@index([orderId])
  @@index([gatewayOrderId])
  @@map("payment_transactions")
}

model OrderShipment {
  id String @id @default(uuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  provider    String
  awb         String?
  courier     String?
  trackingUrl String?
  labelUrl    String?
  status      String    @default("CREATED")
  events      Json      @default("[]")
  lastEventAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([awb])
  @@map("order_shipments")
}

/// Append-only timeline of an order (what the customer's tracking screen shows).
model OrderEvent {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// PLACED, CONFIRMED, ALLOCATED, PACKED, DISPATCHED, DELIVERED, CANCELLED,
  /// RIDER_ASSIGNED, SHIPMENT_CREATED, SHIPMENT_UPDATE, ...
  type String
  note String?

  actorId String?
  actor   User?   @relation("OrderEventsActed", fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@map("order_events")
}

model Coupon {
  id String @id @default(uuid())

  code          String     @unique
  title         String
  description   String     @default("")
  type          CouponType
  value         Decimal    @db.Decimal(12, 2)
  minOrderValue Decimal    @default(0) @db.Decimal(12, 2)
  /// Cap for PERCENT coupons.
  maxDiscount   Decimal?   @db.Decimal(12, 2)

  /// ALL | B2C | B2B
  audience         String    @default("ALL")
  validFrom        DateTime?
  expiresAt        DateTime?
  /// Total uses across everyone / per customer. Null = unlimited.
  usageLimit       Int?
  perCustomerLimit Int?
  usedCount        Int       @default(0)
  isActive         Boolean   @default(true)

  redemptions CouponRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("coupons")
}

model CouponRedemption {
  id String @id @default(uuid())

  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  amount Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([couponId, customerId])
  @@map("coupon_redemptions")
}

/// A staff browser that asked to be told about new orders while the dashboard is closed.
model PushSubscription {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint String @unique
  p256dh   String
  auth     String

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

/// One row per signed-in device. The access/refresh tokens both carry this id (`sid`) and every
/// protected request re-reads the row, so logging out (revokedAt) or expiry ends the session
/// immediately - not when a stateless JWT eventually times out.
model CustomerSession {
  id String @id @default(uuid())

  accountId String
  account   CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// bcrypt of the current refresh token; rotated on every refresh. A refresh that does not match
  /// means an old token was replayed, and the whole session is revoked.
  refreshTokenHash String

  userAgent String?
  ipAddress String?

  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?

  @@index([accountId])
  @@index([expiresAt])
  @@map("customer_sessions")
}

/// A product a storefront customer saved for later. One row per customer+product.
model CustomerWishlistItem {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([customerId, productId])
  @@index([customerId])
  @@map("customer_wishlist_items")
}

/// A help-desk request raised by a storefront customer or retailer (the same
/// Customer record, distinguished by `customer.type`). Ticket numbers are
/// generated the same way as the other trace codes (SequenceService) so
/// support staff can read them aloud on the phone.
model SupportTicket {
  id String @id @default(uuid())

  /// Format: TKT-20260921-001.
  ticketNumber String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  category    SupportTicketCategory
  subject     String
  description String

  /// Free text as typed by the customer - not validated against Order, since
  /// a customer may misremember or quote a WhatsApp-shared number.
  orderNumber String?

  status   SupportTicketStatus   @default(OPEN)
  priority SupportTicketPriority @default(MEDIUM)

  /// Staff response, set when the ticket is resolved/closed. Null while open.
  resolutionNote String?
  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     User?     @relation("SupportTicketResolvedBy", fields: [resolvedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@map("support_tickets")
}

enum SupportTicketCategory {
  ORDER_ISSUE
  PAYMENT_REFUND
  DELIVERY_DELAY
  ACCOUNT_GST
  OTHER
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
}

/// A rating + comment a storefront customer or retailer leaves on a product
/// they've bought. One row per (customer, product) - same shape for both
/// channels, since nothing about a rating is channel-specific.
model ProductReview {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// The order this review was left against, if the storefront asked for a
  /// review from a specific delivered order. Null for a review left from the
  /// product page rather than a post-delivery prompt.
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  rating  Int
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([productId])
  @@map("product_reviews")
}
