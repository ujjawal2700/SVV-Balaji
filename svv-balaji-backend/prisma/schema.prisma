// SVV Balaji - Farm-to-Customer Supply Chain Management
// Phase 0 Foundation Schema
// Covers: Auth/RBAC, Branch Master, and the Farmer/Product/Warehouse master
// stubs needed before Phase 1 (Farm Sourcing & Planning) work begins.
//
// NOTE: This is a Phase 0 foundation only. Batch genealogy models
// (RawMaterialBatch, ProductionBatch, FinishedGoodsBatch, Order, etc.)
// get added in Phase 2-4 per the module roadmap - they are intentionally
// NOT included here so the schema doesn't get ahead of the build plan.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  BRANCH_MANAGER
  PROCUREMENT_MANAGER
  AGRICULTURE_EXPERT
  PRODUCTION_MANAGER
  QA_MANAGER
  WAREHOUSE_MANAGER
  SALES_TEAM
  LOGISTICS_TEAM
  // CUSTOMER intentionally excluded from this internal-staff enum -
  // customers are modeled separately (Customer table, Phase 4+) once
  // the D2C app scope is confirmed with the client.
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum FarmerStatus {
  PENDING_VERIFICATION
  ACTIVE
  INACTIVE
  BLACKLISTED
  SUSPENDED
}

enum FarmerVerificationAction {
  APPROVED
  REJECTED
  DOCUMENTS_REQUESTED
}

enum AgreementStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

// --- Phase 2: Procurement & Raw Material Control -------------------------

enum ProcurementPlanStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// FRD 13.4 - outcome of the pre-harvest quality inspection.
enum InspectionResult {
  APPROVED
  REJECTED
  HOLD_FOR_REINSPECTION
}

/// FRD 15.4 - where a raw material batch sits in its lifecycle.
/// Extends through production/dispatch in later phases.
enum BatchStatus {
  COLLECTED
  STORED
  UNDER_PRODUCTION
  PACKAGED
  DISPATCHED
  DELIVERED
  REJECTED
}

/// FRD 26.4. Shared by farmer collection payments and customer order payments -
/// both can fail and both can be refunded, so the states belong to both.
enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  /// An attempted payment that did not go through. Distinct from PENDING:
  /// pending means nobody has tried, failed means someone tried and it bounced,
  /// and collapsing the two hides every failure in the "not yet paid" bucket.
  FAILED
  /// Money returned after being taken. Terminal - a refunded payment is not
  /// pending again, and treating it as such would double-count the receivable.
  REFUNDED
}

/// FRD 17.3 - every inventory change is one of these.
enum StockMovementType {
  /// Packed finished goods entering a warehouse automatically when QA releases the batch.
  PRODUCTION_INWARD
  STOCK_IN
  STOCK_OUT
  TRANSFER
  ADJUSTMENT
  /// A customer/retailer return that passed QC, back into sellable stock.
  RETURN_INWARD
  /// A returned pack that failed QC (or arrived damaged) - into the damaged
  /// bucket (`FinishedGoodsStock.damagedQuantity`), never into sellable stock.
  RETURN_DAMAGED
}

// --- Phase 3: Processing, QA & Packaging ---------------------------------

/// FRD 19.4 - only APPROVED recipes may be used in production.
enum RecipeStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  INACTIVE
}

/// FRD 20.3 / 20.4 - single raw material vs blended.
/// MULTI_GRAIN execution (weigh-per-ratio, blending, homogeneity) is modelled
/// here but gated in the service until the client confirms it is in scope.
enum ProductionType {
  SINGLE_GRAIN
  MULTI_GRAIN
}

/// FRD 20.7
enum ProductionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  PAUSED
  CANCELLED
}

/// FRD 21 - quality is checked at three points in the lifecycle.
enum InspectionStage {
  RAW_MATERIAL
  IN_PROCESS
  FINISHED_GOODS
}

/// FRD 21.4
enum QualityResult {
  PASS
  FAIL
  REWORK_REQUIRED
}

// --- Supplier Module --------------------------------------------------------

enum SupplierStatus {
  PENDING_VERIFICATION
  ACTIVE
  INACTIVE
  BLACKLISTED
  SUSPENDED
}

enum SupplierVerificationAction {
  APPROVED
  REJECTED
  DOCUMENTS_REQUESTED
}

enum TransportStatus {
  SCHEDULED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Auth / Users
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  fullName     String
  phone        String?
  role         UserRole
  status       UserStatus @default(ACTIVE)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  refreshTokenHash String?

  // Phase 0 / 2FA & Security
  isTwoFactorEnabled     Boolean  @default(false)
  twoFactorSecret        String? // AES-256-GCM encrypted
  twoFactorTempSecret    String? // AES-256-GCM encrypted (during setup)
  twoFactorRecoveryCodes String[] @default([]) // Array of bcrypt-hashed recovery codes

  // Phase 1 back-relations
  farmerVerificationLogs    FarmerVerificationLog[]
  seedDistributionsGiven    SeedDistribution[]
  seedStockCreated          SeedStock[]             @relation("SeedStockCreatedBy")
  creditReceiptsRecorded    CreditReceipt[]         @relation("CreditReceiptRecordedBy")
  ridersReviewed            Rider[]                 @relation("RiderReviewedBy")
  riderCashRecorded         RiderCashEntry[]        @relation("RiderCashRecordedBy")
  riderPayoutsRecorded      RiderPayout[]           @relation("RiderPayoutRecordedBy")
  riderPayoutsVoided        RiderPayout[]           @relation("RiderPayoutVoidedBy")
  riderDocumentsReviewed    RiderDocument[]         @relation("RiderDocumentReviewedBy")
  riderDepositsRecorded     RiderDepositEntry[]     @relation("RiderDepositRecordedBy")
  creditReceiptsVoided      CreditReceipt[]         @relation("CreditReceiptVoidedBy")
  invoicesIssued            Invoice[]               @relation("InvoiceIssuedBy")
  invoicesCancelled         Invoice[]               @relation("InvoiceCancelledBy")
  creditNotesIssued         CreditNote[]            @relation("CreditNoteIssuedBy")
  creditNotesCancelled      CreditNote[]            @relation("CreditNoteCancelledBy")
  posShiftsOpened           PosShift[]              @relation("PosShiftCashier")
  posShiftsClosed           PosShift[]              @relation("PosShiftClosedBy")
  posSales                  PosSale[]               @relation("PosSaleCashier")
  posSalesRefunded          PosSale[]               @relation("PosSaleRefundedBy")
  seedStockMovements        SeedStockMovement[]     @relation("SeedStockMovementBy")
  trainingSessionsConducted TrainingSession[]
  fieldVisitsAsExpert       FieldVisit[]
  fieldVisitPlansAssigned   FieldVisitPlan[]        @relation("FieldVisitPlanExpert")
  fieldVisitPlansCreated    FieldVisitPlan[]        @relation("FieldVisitPlanCreatedBy")

  // Phase 2 back-relations
  procurementPlansCreated ProcurementPlan[]       @relation("ProcurementPlansCreated")
  harvestInspections      HarvestInspection[]     @relation("HarvestInspections")
  rawMaterialCollections  RawMaterialCollection[] @relation("RawMaterialCollections")
  stockMovements          StockMovement[]         @relation("StockMovements")

  farmPlotsCreated FarmPlot[] @relation("FarmPlotsCreated")
  farmersCreated   Farmer[]   @relation("FarmersCreated")

  // Phase 3 back-relations
  /// FRD 6.2 - the branch this user is the assigned manager of, if any.
  /// Distinct from `branch` above, which is where they work.
  managedBranch Branch? @relation("BranchManager")

  cleaningGradingRecords   CleaningGradingRecord[] @relation("CleaningGradingOperator")
  cleaningGradingVerified  CleaningGradingRecord[] @relation("CleaningGradingVerifier")
  recipesCreated           Recipe[]                @relation("RecipesCreated")
  recipesApproved          Recipe[]                @relation("RecipesApproved")
  productionBatchesCreated ProductionBatch[]       @relation("ProductionBatchesCreated")
  qualityInspections       QualityInspection[]     @relation("QualityInspections")
  finishedGoodsPacked      FinishedGoodsBatch[]    @relation("FinishedGoodsPacked")
  batchHoldEvents          BatchHoldEvent[]        @relation("BatchHoldEvents")
  orderReturnsRecorded     OrderReturn[]           @relation("OrderReturnsRecorded")
  pushSubscriptions        PushSubscription[]
  pushDevices              PushDevice[]
  appNotifications         AppNotification[]
  pushBroadcastsSent       PushBroadcast[]         @relation("PushBroadcastsSent")
  orderEventsActed         OrderEvent[]            @relation("OrderEventsActed")
  loyaltySettingsUpdated   LoyaltySettings[]       @relation("LoyaltySettingsUpdated")

  // Phase 4 back-relations
  customersAssigned Customer[]        @relation("CustomerAssignedTo")
  priceListsCreated PriceList[]       @relation("PriceListsCreated")
  ordersPlaced      Order[]           @relation("OrdersPlaced")
  orderAllocations  OrderAllocation[] @relation("OrderAllocations")

  // Supplier back-relations
  suppliersCreated          Supplier[]                @relation("SuppliersCreated")
  supplierVerificationLogs  SupplierVerificationLog[]
  supplierTransportsCreated SupplierTransport[]       @relation("TransportsCreated")
  purchaseOrdersCreated     PurchaseOrder[]           @relation("PurchaseOrdersCreated")

  // Storefront back-relations
  customerAccountsReviewed  CustomerAccount[]      @relation("CustomerAccountsReviewed")
  referralSettingsUpdated   ReferralSettings[]
  walletSettingsUpdated     WalletSettings[]
  coinTransactionsPerformed CoinTransaction[]      @relation("CoinTransactionsPerformed")
  supportTicketsResolved    SupportTicket[]        @relation("SupportTicketResolvedBy")
  supportMessagesSent       SupportTicketMessage[] @relation("SupportTicketMessagesSent")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([branchId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Branch Management (FRD Section 6)
// ---------------------------------------------------------------------------

model Branch {
  id           String  @id @default(uuid())
  name         String
  location     String
  address      String
  contactName  String?
  contactPhone String?
  isActive     Boolean @default(true)

  /// FRD 6.2 - the Branch Manager assigned to run this branch.
  ///
  /// The relationship was previously only inferable backwards: find the users
  /// whose `branchId` is this branch and whose role happens to be
  /// BRANCH_MANAGER. That answers "who works here", not "who is accountable
  /// for this branch" - two managers at one site made the question unanswerable,
  /// and a branch with none looked identical to a branch with one.
  ///
  /// Unique because a manager runs one branch: they carry a single `branchId`,
  /// so managing a second would mean being assigned somewhere they do not work.
  managerId String? @unique
  manager   User?   @relation("BranchManager", fields: [managerId], references: [id])

  users            User[]
  farmers          Farmer[]
  warehouses       Warehouse[]
  trainingSessions TrainingSession[]
  fieldVisits      FieldVisit[]
  fieldVisitPlans  FieldVisitPlan[]
  seedStock        SeedStock[]
  posOutlets       PosOutlet[]

  // Phase 2
  procurementPlans       ProcurementPlan[]
  rawMaterialCollections RawMaterialCollection[]
  rawMaterialBatches     RawMaterialBatch[]

  // Phase 3
  productionBatches ProductionBatch[]

  // Phase 4
  customers Customer[]
  orders    Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("branches")
}

// ---------------------------------------------------------------------------
// Farmer Management + Farmer ID & Traceability (FRD Sections 7-8, Phase 1)
// farmerCode is nullable until approval - per FRD 8.1 the unique ID is
// generated for "every approved farmer", not at registration time.
// ---------------------------------------------------------------------------

model Farmer {
  id            String  @id @default(uuid())
  farmerCode    String? @unique // e.g. SVV-2026-000123 - assigned on approval, the traceability anchor
  fullName      String
  mobile        String
  aadhaarNumber String?
  panNumber     String?

  /// FRD 7.1 "Family Details" - free text.
  ///
  /// Deliberately one string rather than a related table. The FRD asks for it
  /// under Personal Information alongside name and mobile, not as a structured
  /// dependants list, and nothing downstream reads it. A `FarmerFamilyMember`
  /// table would be a schema we then have to keep correct for data nobody
  /// queries. Promote it if a requirement ever needs it row-wise.
  familyDetails String?

  village     String
  district    String
  state       String
  address     String?
  gpsLocation String?

  farmSizeAcres  Decimal? @db.Decimal(10, 2)
  landType       String?
  irrigationType String?
  cropDetails    String?

  bankAccountName String?
  bankName        String?
  bankAccountNo   String?
  ifscCode        String?

  status FarmerStatus @default(PENDING_VERIFICATION)

  // --- FRD 7.6 Farmer Performance -------------------------------------------
  //
  // Persisted rather than computed on read, for one concrete reason: FRD 7.4
  // lists Quality Rating as a *search filter*. A score computed in application
  // code cannot be filtered or sorted in SQL without loading every farmer, so
  // the composite lands here and `FarmerPerformanceService` keeps it current.
  //
  // The component scores are stored beside it so the panel can explain a rating
  // without recomputing it, and so a rating can be audited after the fact
  // against the records that produced it.

  /// Composite 0-100. NULL means unrated - no procurement history yet.
  /// Null is not zero: a farmer who has never supplied is not a bad farmer.
  qualityRating Decimal? @db.Decimal(5, 2)

  /// FRD 7.6 components, each 0-100 and each NULL when it has no input.
  cropQualityScore         Decimal? @db.Decimal(5, 2)
  deliveryTimelinessScore  Decimal? @db.Decimal(5, 2)
  procurementQuantityScore Decimal? @db.Decimal(5, 2)

  /// When the scores above were last recomputed. Stale values are a bug, so
  /// this exists to make staleness visible rather than invisible.
  performanceUpdatedAt DateTime?

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  createdById String?
  createdBy   User?   @relation("FarmersCreated", fields: [createdById], references: [id])

  verificationLogs    FarmerVerificationLog[]
  agreements          Agreement[]
  seedDistributions   SeedDistribution[]
  trainingAttendances TrainingAttendance[]
  fieldVisits         FieldVisit[]
  fieldVisitPlans     FieldVisitPlan[]
  plots               FarmPlot[]

  // Phase 2 - the traceability chain from this farmer forward
  harvestInspections     HarvestInspection[]
  rawMaterialCollections RawMaterialCollection[]
  rawMaterialBatches     RawMaterialBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([branchId])
  /// FRD 7.4 filters and sorts farmers by Quality Rating.
  @@index([qualityRating])
  @@map("farmers")
}

// ---------------------------------------------------------------------------
// Farmer code sequence - backs the SVV-YYYY-NNNNNN traceability ID.
// Single row per year, incremented atomically (see FarmersService) so
// concurrent approvals never collide on the same code.
// ---------------------------------------------------------------------------

model FarmerCodeCounter {
  year       Int @id
  lastNumber Int @default(0)

  @@map("farmer_code_counters")
}

// ---------------------------------------------------------------------------
// Farmer Verification Audit Trail (FRD 7.2)
// ---------------------------------------------------------------------------

model FarmerVerificationLog {
  id       String @id @default(uuid())
  farmerId String
  farmer   Farmer @relation(fields: [farmerId], references: [id])

  action  FarmerVerificationAction
  remarks String?

  verifiedById String
  verifiedBy   User   @relation(fields: [verifiedById], references: [id])

  createdAt DateTime @default(now())

  @@index([farmerId])
  @@map("farmer_verification_logs")
}

// ---------------------------------------------------------------------------
// Agreement Management (FRD Section 9)
// ---------------------------------------------------------------------------

model Agreement {
  id       String @id @default(uuid())
  farmerId String
  farmer   Farmer @relation(fields: [farmerId], references: [id])

  cropName         String
  variety          String?
  expectedQuantity Decimal   @db.Decimal(12, 2)
  purchaseRate     Decimal   @db.Decimal(12, 2)
  agreementDate    DateTime
  harvestDate      DateTime?
  qualityStandards String?

  status AgreementStatus @default(PENDING)

  harvestInspections HarvestInspection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmerId])
  @@index([status])
  @@map("agreements")
}

// ---------------------------------------------------------------------------
// Seed & Input Distribution (FRD Section 10)
// ---------------------------------------------------------------------------

model SeedDistribution {
  id       String @id @default(uuid())
  farmerId String
  farmer   Farmer @relation(fields: [farmerId], references: [id])

  seedName         String
  seedVariety      String?
  quantity         Decimal  @db.Decimal(12, 2)
  unit             String   @default("KG")
  batchNumber      String?
  distributionDate DateTime

  distributedById String
  distributedBy   User   @relation(fields: [distributedById], references: [id])

  /// Where the seed came from. COMPANY_STOCK always carries `seedStockId` and was
  /// deducted from that lot; EXTERNAL (farmer-provided or bought outside) never
  /// does. Null only on handouts recorded before the source was captured - they
  /// are left as they were rather than guessed at.
  seedSource SeedSource?

  /// FRD 10.2 - the seed lot this handout was issued from, and deducted from.
  seedStockId String?
  seedStock   SeedStock? @relation(fields: [seedStockId], references: [id])

  createdAt DateTime @default(now())

  @@index([farmerId])
  @@index([seedStockId])
  @@map("seed_distributions")
}

/// FRD 10.2 "maintain inventory". One lot of certified seed or agri-input held
/// at a branch for distribution to that branch's farmers.
///
/// Separate from WarehouseStock on purpose: that table holds farmer produce and
/// is part of the farmer -> batch -> product traceability chain. Seed is a
/// company input going the other way, and mixing the two would put packets of
/// seed into the raw-material ledger and stock reconciliation.
///
/// `quantityOnHand` is only ever changed together with a SeedStockMovement row,
/// the same rule the warehouse ledger follows.
model SeedStock {
  id String @id @default(uuid())

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  seedName    String
  seedVariety String?
  /// Supplier lot / certification number printed on the packaging.
  batchNumber String?
  unit        String  @default("KG")

  quantityOnHand Decimal @db.Decimal(12, 2)

  supplier   String?
  receivedAt DateTime
  expiryDate DateTime?
  notes      String?

  isActive Boolean @default(true)

  createdById String
  createdBy   User   @relation("SeedStockCreatedBy", fields: [createdById], references: [id])

  movements     SeedStockMovement[]
  distributions SeedDistribution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, isActive])
  @@map("seed_stock")
}

enum SeedSource {
  /// Issued from a company seed stock lot and deducted from it.
  COMPANY_STOCK
  /// Farmer-provided or sourced outside company stock. Nothing deducted.
  EXTERNAL
}

enum SeedStockMovementType {
  /// Seed received into the lot.
  RECEIPT
  /// Handed to a farmer (negative).
  DISTRIBUTION
  /// A handout was reduced, moved to another lot, re-sourced or deleted - stock returned (positive).
  DISTRIBUTION_REVERSAL
  /// Physical count correction, either direction. Always carries a reason.
  ADJUSTMENT
  /// Stock removed as unusable - damaged, spoilt, expired. Negative, always with a reason.
  WRITE_OFF
  /// Sent to a lot at another branch (negative). `relatedSeedStockId` is the receiving lot.
  TRANSFER_OUT
  /// Received from a lot at another branch (positive). `relatedSeedStockId` is the sending lot.
  TRANSFER_IN
  /// Not a quantity change: the lot was withdrawn, restored or its expiry changed.
  /// Recorded with quantity 0 so the lot's history is complete.
  LOT_UPDATE
}

/// Append-only ledger for SeedStock. `quantity` is signed; `balanceAfter` is the
/// lot's on-hand quantity once this movement applied.
model SeedStockMovement {
  id String @id @default(uuid())

  seedStockId String
  seedStock   SeedStock @relation(fields: [seedStockId], references: [id])

  type         SeedStockMovementType
  quantity     Decimal               @db.Decimal(12, 2)
  balanceAfter Decimal               @db.Decimal(12, 2)
  reason       String?

  /// The handout this movement belongs to. A plain id, not a relation, so the
  /// ledger keeps its history after a handout is deleted.
  seedDistributionId String?

  /// For a transfer, the lot on the other side. Plain id for the same reason.
  relatedSeedStockId String?

  performedById String
  performedBy   User   @relation("SeedStockMovementBy", fields: [performedById], references: [id])

  createdAt DateTime @default(now())

  @@index([seedStockId, createdAt])
  @@index([seedDistributionId])
  @@map("seed_stock_movements")
}

// ---------------------------------------------------------------------------
// Training Management (FRD Section 11)
// ---------------------------------------------------------------------------

model TrainingSession {
  id            String   @id @default(uuid())
  title         String
  description   String?
  scheduledDate DateTime

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  conductedById String
  conductedBy   User   @relation(fields: [conductedById], references: [id])

  attendances TrainingAttendance[]
  materials   TrainingMaterial[]

  createdAt DateTime @default(now())

  @@index([branchId])
  @@map("training_sessions")
}

model TrainingAttendance {
  id String @id @default(uuid())

  sessionId String
  session   TrainingSession @relation(fields: [sessionId], references: [id])

  farmerId String
  farmer   Farmer @relation(fields: [farmerId], references: [id])

  attended Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([sessionId, farmerId])
  @@map("training_attendances")
}

model TrainingMaterial {
  id String @id @default(uuid())

  sessionId String
  session   TrainingSession @relation(fields: [sessionId], references: [id])

  fileUrl  String
  fileType String // pdf, image, presentation, video

  createdAt DateTime @default(now())

  @@map("training_materials")
}

// ---------------------------------------------------------------------------
// Field Monitoring (FRD Section 12)
// ---------------------------------------------------------------------------

model FieldVisit {
  id String @id @default(uuid())

  farmerId String
  farmer   Farmer @relation(fields: [farmerId], references: [id])

  expertId String
  expert   User   @relation(fields: [expertId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  visitDate DateTime
  cropName  String?

  cropGrowthStage    String?
  cropHealth         String?
  pestStatus         String?
  diseaseObservation String?

  fertilizerAdvice       String?
  irrigationAdvice       String?
  pestControlSuggestions String?
  harvestPreparation     String?

  yieldPredictionQty Decimal? @db.Decimal(12, 2)

  documents FieldVisitDocument[]

  /// The plan this visit fulfilled, if it was scheduled in advance (FRD 12.1).
  plan FieldVisitPlan?

  createdAt DateTime @default(now())

  @@index([farmerId])
  @@index([expertId])
  @@map("field_visits")
}

/// FRD 12.1 "schedule ... farm visits". A visit planned ahead of time.
///
/// Kept separate from FieldVisit on purpose: a FieldVisit is an observation
/// record - everything on it was seen or advised at the farm. A plan is an
/// intention with a date. Recording the visit completes the plan and links the
/// two (`completedVisitId`), so a planned visit that never happened stays
/// visible as overdue rather than silently turning into an empty observation.
model FieldVisitPlan {
  id String @id @default(uuid())

  farmerId String
  farmer   Farmer @relation(fields: [farmerId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  /// The executive expected to make the visit. Defaults to whoever planned it.
  expertId String
  expert   User   @relation("FieldVisitPlanExpert", fields: [expertId], references: [id])

  createdById String
  createdBy   User   @relation("FieldVisitPlanCreatedBy", fields: [createdById], references: [id])

  plannedDate DateTime
  /// Why the visit is needed - crop monitoring, pest follow-up, pre-harvest check...
  purpose     String?
  cropName    String?
  notes       String?

  status FieldVisitPlanStatus @default(PLANNED)

  /// Set when the visit is recorded against this plan. SetNull so deleting the
  /// visit can never be blocked by its plan; the service also reopens the plan.
  completedVisitId String?     @unique
  completedVisit   FieldVisit? @relation(fields: [completedVisitId], references: [id], onDelete: SetNull)
  completedAt      DateTime?

  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmerId])
  @@index([expertId, status])
  @@index([plannedDate])
  @@map("field_visit_plans")
}

enum FieldVisitPlanStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

model FieldVisitDocument {
  id String @id @default(uuid())

  fieldVisitId String
  fieldVisit   FieldVisit @relation(fields: [fieldVisitId], references: [id])

  fileUrl  String
  fileType String // photo, pdf report, inspection doc

  createdAt DateTime @default(now())

  @@map("field_visit_documents")
}

// ===========================================================================
// PHASE 2 - Procurement & Raw Material Control (FRD Sections 13-17)
// ===========================================================================

// ---------------------------------------------------------------------------
// Procurement Planning (FRD 13.1)
// ---------------------------------------------------------------------------

model ProcurementPlan {
  id       String @id @default(uuid())
  cropName String

  plannedQuantity Decimal @db.Decimal(12, 2)
  unit            String  @default("KG")

  scheduledFrom DateTime
  scheduledTo   DateTime

  status ProcurementPlanStatus @default(DRAFT)
  notes  String?

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  createdById String
  createdBy   User   @relation("ProcurementPlansCreated", fields: [createdById], references: [id])

  inspections HarvestInspection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([status])
  @@map("procurement_plans")
}

// ---------------------------------------------------------------------------
// Harvest Inspection (FRD 13.2 - 13.5)
// Gate before collection: only APPROVED inspections may proceed.
// ---------------------------------------------------------------------------

model HarvestInspection {
  id String @id @default(uuid())

  farmerId String
  farmer   Farmer @relation(fields: [farmerId], references: [id])

  /// Optional - inspections can happen against an agreement or ad hoc.
  agreementId String?
  agreement   Agreement? @relation(fields: [agreementId], references: [id])

  procurementPlanId String?
  procurementPlan   ProcurementPlan? @relation(fields: [procurementPlanId], references: [id])

  /// Which of the farmer's plots this harvest came from.
  ///
  /// Optional, and has to stay optional: every inspection recorded before
  /// plots existed has none, and a farmer whose land has not been mapped yet
  /// still needs to be inspectable. A missing plot is a gap in the trace, not
  /// a reason to block procurement.
  plotId String?
  plot   FarmPlot? @relation("InspectedPlot", fields: [plotId], references: [id])

  cropName       String
  inspectionDate DateTime

  // FRD 13.2 inspection checklist
  moistureLevel  Decimal? @db.Decimal(5, 2)
  foreignMatter  Decimal? @db.Decimal(5, 2)
  grainSize      String?
  grainColor     String?
  smell          String?
  physicalDamage String?

  result  InspectionResult
  remarks String?

  inspectedById String
  inspectedBy   User   @relation("HarvestInspections", fields: [inspectedById], references: [id])

  documents  HarvestInspectionDocument[]
  collection RawMaterialCollection?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmerId])
  @@index([result])
  @@index([plotId])
  @@map("harvest_inspections")
}

model HarvestInspectionDocument {
  id String @id @default(uuid())

  inspectionId String
  inspection   HarvestInspection @relation(fields: [inspectionId], references: [id])

  fileUrl  String
  fileType String // crop_image | inspection_photo | pdf | quality_certificate

  createdAt DateTime @default(now())

  @@map("harvest_inspection_documents")
}

// ---------------------------------------------------------------------------
// Raw Material Collection (FRD Section 14)
// One collection per approved inspection - this is the farmer -> batch link.
// ---------------------------------------------------------------------------

model RawMaterialCollection {
  id String @id @default(uuid())

  /// Enforced 1:1 - a harvest is collected once.
  inspectionId String            @unique
  inspection   HarvestInspection @relation(fields: [inspectionId], references: [id])

  farmerId String
  farmer   Farmer @relation(fields: [farmerId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  /// Copied from the inspection at collection time rather than read through
  /// it. The collection is the row the batch and every downstream trace hangs
  /// off, and denormalising one nullable id here saves a join on the hottest
  /// read in the system - the consumer trace page.
  plotId String?
  plot   FarmPlot? @relation("HarvestedPlot", fields: [plotId], references: [id])

  cropName           String
  collectionDate     DateTime
  collectionLocation String?

  // FRD 14.2 weight measurement
  grossWeight Decimal @db.Decimal(12, 2)
  netWeight   Decimal @db.Decimal(12, 2)
  unit        String  @default("KG")

  // FRD 14.3 purchase details
  purchaseRate  Decimal       @db.Decimal(12, 2)
  totalAmount   Decimal       @db.Decimal(14, 2)
  paymentStatus PaymentStatus @default(PENDING)

  /// FRD 14.4 - receipt issued to farmer and company.
  receiptNumber String @unique

  collectedById String
  collectedBy   User   @relation("RawMaterialCollections", fields: [collectedById], references: [id])

  batch RawMaterialBatch?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmerId])
  @@index([branchId])
  @@index([plotId])
  @@map("raw_material_collections")
}

// ---------------------------------------------------------------------------
// Batch Management (FRD Section 15)
// The traceability spine: Farmer -> Collection -> RawMaterialBatch -> (Phase 3
// production) -> (Phase 4 order/delivery).
// ---------------------------------------------------------------------------

model RawMaterialBatch {
  id String @id @default(uuid())

  /// FRD 15.1 format: RM-YYYYMMDD-NNN
  batchNumber String @unique

  // -------------------------------------------------------------------------
  // Origin Link - either from a Farmer Collection or a Supplier Transport
  // -------------------------------------------------------------------------

  collectionId String?                @unique
  collection   RawMaterialCollection? @relation(fields: [collectionId], references: [id])

  supplierTransportId String?            @unique
  supplierTransport   SupplierTransport? @relation(fields: [supplierTransportId], references: [id])

  farmerId String?
  farmer   Farmer? @relation(fields: [farmerId], references: [id])

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  // -------------------------------------------------------------------------

  cropName String
  quantity Decimal @db.Decimal(12, 2)
  unit     String  @default("KG")

  status BatchStatus @default(COLLECTED)

  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  stock          WarehouseStock[]
  stockMovements StockMovement[]

  // Phase 3 - consumed into production, and inspected along the way
  cleaningGradingRecords CleaningGradingRecord[]
  consumptions           ProductionConsumption[]
  qualityInspections     QualityInspection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmerId])
  @@index([status])
  @@index([warehouseId])
  @@map("raw_material_batches")
}

/// Per-day sequence backing RM-YYYYMMDD-NNN. Same atomic-increment pattern as
/// FarmerCodeCounter so concurrent collections never collide on a batch number.
model BatchNumberCounter {
  /// YYYYMMDD as an integer, e.g. 20260807
  dateKey    Int @id
  lastNumber Int @default(0)

  @@map("batch_number_counters")
}

// ---------------------------------------------------------------------------
// Warehouse Stock + Inventory Ledger (FRD Sections 16-17)
// ---------------------------------------------------------------------------

/// Current on-hand quantity per (warehouse, batch). Mutated only alongside a
/// StockMovement row so the ledger and the balance can never drift apart.
model WarehouseStock {
  id String @id @default(uuid())

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  batchId String
  batch   RawMaterialBatch @relation(fields: [batchId], references: [id])

  quantity         Decimal @db.Decimal(12, 2)
  reservedQuantity Decimal @default(0) @db.Decimal(12, 2)
  unit             String  @default("KG")

  storageLocation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([warehouseId, batchId])
  @@index([warehouseId])
  @@map("warehouse_stock")
}

/// FRD 17.3/17.5 - append-only audit trail of every inventory change.
/// Every change to stock, of either kind.
///
/// Raw material has always held the invariant that quantity is never mutated
/// except alongside a row here. Finished goods did not - `FinishedGoodsStock`
/// was decremented on dispatch and left no trace, so "why is the count wrong"
/// had no answer. A-13 (16 Aug) closed that by widening this table rather than
/// adding a second one: one ledger means one place to read, one report, one
/// screen, instead of every inventory question being asked twice and joined.
///
/// Exactly one of `batchId` / `fgBatchId` is set. Enforced by a CHECK
/// constraint in the migration, because Prisma cannot express it.
model StockMovement {
  id String @id @default(uuid())

  /// Set for raw material movements.
  batchId String?
  batch   RawMaterialBatch? @relation(fields: [batchId], references: [id])

  /// Set for finished goods movements.
  fgBatchId String?
  fgBatch   FinishedGoodsBatch? @relation(fields: [fgBatchId], references: [id])

  fromWarehouseId String?
  fromWarehouse   Warehouse? @relation("StockMovementFrom", fields: [fromWarehouseId], references: [id])

  toWarehouseId String?
  toWarehouse   Warehouse? @relation("StockMovementTo", fields: [toWarehouseId], references: [id])

  movementType StockMovementType
  quantity     Decimal           @db.Decimal(12, 2)
  unit         String            @default("KG")
  reason       String?
  /// Machine-readable origin, e.g. QA_RELEASE_AUTO.
  reference    String?

  performedById String
  performedBy   User   @relation("StockMovements", fields: [performedById], references: [id])

  createdAt DateTime @default(now())

  @@index([batchId])
  @@index([fgBatchId])
  @@index([movementType])
  @@map("stock_movements")
}

// ===========================================================================
// PHASE 3 - Processing, QA & Packaging (FRD Sections 18-23)
// ===========================================================================

// ---------------------------------------------------------------------------
// Cleaning & Grading (FRD Section 18)
// Happens to a raw material batch before it can enter production.
// ---------------------------------------------------------------------------

model CleaningGradingRecord {
  id String @id @default(uuid())

  rawMaterialBatchId String
  rawMaterialBatch   RawMaterialBatch @relation(fields: [rawMaterialBatchId], references: [id])

  // FRD 18.1 cleaning activities
  dustRemoved            Boolean @default(false)
  stonesRemoved          Boolean @default(false)
  foreignMaterialRemoved Boolean @default(false)
  impuritiesSeparated    Boolean @default(false)

  // FRD 18.2 grading parameters
  grainSize     String?
  color         String?
  texture       String?
  moistureLevel Decimal? @db.Decimal(5, 2)
  purity        Decimal? @db.Decimal(5, 2)

  /// Weight lost to cleaning - matters for yield reconciliation.
  wastageQuantity Decimal? @db.Decimal(12, 2)

  /// FRD loss/yield tracking - material removed during cleaning that still has
  /// resale value (bran, choker, husk), distinct from pure wastage above.
  /// `wastageQuantity` stays pure loss; this is loss that has value.
  byProductQuantity Decimal? @db.Decimal(12, 2)
  byProductName     String?

  /// FRD 18.3 - QA sign-off before the batch is production-ready.
  /// FRD 18.3. Set only through `PATCH /cleaning-grading/:id/verify`, which
  /// requires `quality.create` - never by the operator submitting the record.
  /// Production refuses a batch whose cleaning record is not verified.
  qaVerified     Boolean   @default(false)
  /// Who verified, and when. A sign-off nobody is named against is not a sign-off.
  qaVerifiedById String?
  qaVerifiedBy   User?     @relation("CleaningGradingVerifier", fields: [qaVerifiedById], references: [id])
  qaVerifiedAt   DateTime?

  remarks String?

  operatorId String
  operator   User   @relation("CleaningGradingOperator", fields: [operatorId], references: [id])

  createdAt DateTime @default(now())

  @@index([rawMaterialBatchId])
  @@map("cleaning_grading_records")
}

// ---------------------------------------------------------------------------
// Recipe / Formula Management (FRD Section 19)
// Created by Super Admin only, versioned, and approved before use.
// ---------------------------------------------------------------------------

model Recipe {
  id String @id @default(uuid())

  recipeCode String
  version    Int    @default(1)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  name        String
  category    String?
  description String?

  productionType ProductionType @default(SINGLE_GRAIN)

  // FRD 19.3 production formula
  mixingRatio           String?
  processingSequence    String?
  grindingInstructions  String?
  roastingInstructions  String?
  oilExtractionProcess  String?
  packagingInstructions String?

  /// Expected output for one full batch, used to scale ingredient quantities.
  batchYieldQuantity Decimal? @db.Decimal(12, 2)
  unit               String   @default("KG")

  status RecipeStatus @default(DRAFT)

  createdById String
  createdBy   User   @relation("RecipesCreated", fields: [createdById], references: [id])

  approvedById String?
  approvedBy   User?     @relation("RecipesApproved", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  ingredients       RecipeIngredient[]
  productionBatches ProductionBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Same code may exist at multiple versions, but only once per version.
  @@unique([recipeCode, version])
  @@index([status])
  @@map("recipes")
}

/// FRD 19.2 - one row per raw material in the formula.
/// For SINGLE_GRAIN recipes there is exactly one; MULTI_GRAIN has several
/// whose percentages should total 100.
model RecipeIngredient {
  id String @id @default(uuid())

  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  /// Matches RawMaterialBatch.cropName - what to pull from stock.
  cropName String

  quantity   Decimal  @db.Decimal(12, 3)
  unit       String   @default("KG")
  /// Share of the finished blend, 0-100.
  percentage Decimal? @db.Decimal(5, 2)

  createdAt DateTime @default(now())

  @@index([recipeId])
  @@map("recipe_ingredients")
}

// ---------------------------------------------------------------------------
// Production Management (FRD Section 20)
// ---------------------------------------------------------------------------

model ProductionBatch {
  id String @id @default(uuid())

  /// Format: PB-YYYYMMDD-NNN
  productionBatchNumber String @unique

  productId String
  product   Product @relation(fields: [productId], references: [id])

  recipeId      String
  recipe        Recipe @relation(fields: [recipeId], references: [id])
  /// Pinned at creation - recipes are versioned and may change afterwards.
  recipeVersion Int

  productionType ProductionType

  plannedQuantity Decimal  @db.Decimal(12, 2)
  actualQuantity  Decimal? @db.Decimal(12, 2)
  /// FRD 20.5 - planned minus actual, i.e. process loss.
  productionLoss  Decimal? @db.Decimal(12, 2)
  unit            String   @default("KG")

  /// Loss/yield tracking - material recovered during production with resale
  /// value (e.g. oil cake, screenings), distinct from pure process loss above.
  byProductQuantity Decimal? @db.Decimal(12, 2)
  byProductName     String?
  /// Revenue if/when the by-product is sold. A recorded figure, not a sales workflow.
  byProductRevenue  Decimal? @db.Decimal(12, 2)

  productionDate DateTime
  status         ProductionStatus @default(PLANNED)

  // FRD 20.6 machine allocation
  machineName    String?
  machineNumber  String?
  operatorName   String?
  productionLine String?

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  /// Warehouse the raw material is drawn from.
  ///
  /// Added with FRD 17.2 reservation. A PLANNED run holds a reservation against
  /// stock rows in a specific warehouse, and the release has to find exactly
  /// those rows again when the run starts or is cancelled - so the warehouse
  /// stops being a create-time argument and becomes a property of the run.
  ///
  /// Nullable only because runs created before reservation existed have no
  /// value to backfill; every new run sets it.
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  createdById String
  createdBy   User   @relation("ProductionBatchesCreated", fields: [createdById], references: [id])

  consumptions         ProductionConsumption[]
  qualityInspections   QualityInspection[]
  finishedGoodsBatches FinishedGoodsBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([branchId])
  @@map("production_batches")
}

/// FRD 20.5 - the traceability link across the processing step.
/// Every raw material batch consumed by a production run is recorded here,
/// which is what lets a finished pack resolve back to specific farmers.
model ProductionConsumption {
  id String @id @default(uuid())

  productionBatchId String
  productionBatch   ProductionBatch @relation(fields: [productionBatchId], references: [id], onDelete: Cascade)

  rawMaterialBatchId String
  rawMaterialBatch   RawMaterialBatch @relation(fields: [rawMaterialBatchId], references: [id])

  quantityUsed Decimal @db.Decimal(12, 2)
  unit         String  @default("KG")

  createdAt DateTime @default(now())

  @@unique([productionBatchId, rawMaterialBatchId])
  @@index([rawMaterialBatchId])
  @@map("production_consumptions")
}

// ---------------------------------------------------------------------------
// Quality Management (FRD Section 21)
// ---------------------------------------------------------------------------

model QualityInspection {
  id String @id @default(uuid())

  stage InspectionStage

  /// Exactly one of these is set, depending on stage.
  rawMaterialBatchId String?
  rawMaterialBatch   RawMaterialBatch? @relation(fields: [rawMaterialBatchId], references: [id])

  productionBatchId String?
  productionBatch   ProductionBatch? @relation(fields: [productionBatchId], references: [id])

  finishedGoodsBatchId String?
  finishedGoodsBatch   FinishedGoodsBatch? @relation(fields: [finishedGoodsBatchId], references: [id])

  // FRD 21.1 raw material parameters
  moisture      Decimal? @db.Decimal(5, 2)
  purity        Decimal? @db.Decimal(5, 2)
  grainSize     String?
  color         String?
  foreignMatter Decimal? @db.Decimal(5, 2)
  odor          String?

  // FRD 21.2 in-process parameters
  ingredientRatio    String?
  mixingAccuracy     String?
  grindingQuality    String?
  temperature        Decimal? @db.Decimal(6, 2)
  productConsistency String?

  // FRD 21.3 finished goods parameters
  productAppearance String?
  productWeight     Decimal? @db.Decimal(12, 3)
  packagingQuality  String?
  labelAccuracy     String?
  shelfLifeVerified Boolean?

  result  QualityResult
  remarks String?

  inspectedById String
  inspectedBy   User   @relation("QualityInspections", fields: [inspectedById], references: [id])

  createdAt DateTime @default(now())

  @@index([stage])
  @@index([result])
  @@map("quality_inspections")
}

// ---------------------------------------------------------------------------
// Packaging + Finished Goods (FRD Sections 22-23)
// ---------------------------------------------------------------------------

model FinishedGoodsBatch {
  id String @id @default(uuid())

  /// Format: FG-YYYYMMDD-NNN. This is what the consumer QR resolves to.
  fgBatchNumber String @unique

  productionBatchId String
  productionBatch   ProductionBatch @relation(fields: [productionBatchId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  // FRD 22.2 label information
  packagingType     String // pouch | box | bottle | jar | sack
  netWeight         Decimal   @db.Decimal(12, 3)
  weightUnit        String    @default("KG")
  mrp               Decimal?  @db.Decimal(12, 2)
  packagingDate     DateTime
  manufacturingDate DateTime
  expiryDate        DateTime?
  shelfLifeDays     Int?

  /// Number of packs produced at this net weight.
  packCount Int

  /// Public traceability URL encoded in the QR (FRD 22.3). Stored so the
  /// printed code and the record can never disagree.
  qrPayload String?

  /// FRD 21.5 - only QA-released batches may be stocked or dispatched.
  qaReleased Boolean @default(false)

  /// Recall control, separate from QA release on purpose: `qaReleased` says the
  /// batch PASSED inspection, `holdStatus` says whether it may still be sold.
  /// A complaint can freeze a batch that passed. Only ACTIVE batches are
  /// allocated, dispatched, counted as storefront stock or vouched for on the
  /// public trace page. Every change is written to `BatchHoldEvent`.
  holdStatus    BatchHoldStatus @default(ACTIVE)
  holdReason    String?
  holdChangedAt DateTime?

  holdEvents BatchHoldEvent[]

  packedById String
  packedBy   User   @relation("FinishedGoodsPacked", fields: [packedById], references: [id])

  qualityInspections QualityInspection[]
  stock              FinishedGoodsStock[]
  /// Every stock-in, dispatch and adjustment of this batch (A-13).
  stockMovements     StockMovement[]

  // Phase 4 - every allocation is a traceability link from an order line to a
  // specific pack batch, and through it back to the farmer.
  allocations            OrderAllocation[]
  /// The same link for counter (POS) sales.
  posAllocations         PosSaleAllocation[]
  /// Packs that came back on a return/exchange, and packs sent out as replacements.
  returnBatchLines       ReturnBatchLine[]
  replacementAllocations ReturnReplacementAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productionBatchId])
  @@index([qaReleased])
  @@index([holdStatus])
  @@map("finished_goods_batches")
}

/// FRD Section 23 - packaged stock awaiting dispatch.
enum BatchHoldStatus {
  ACTIVE
  ON_HOLD
  RECALLED
}

/// Append-only audit of every freeze, recall and release of a finished goods batch.
model BatchHoldEvent {
  id String @id @default(uuid())

  fgBatchId String
  fgBatch   FinishedGoodsBatch @relation(fields: [fgBatchId], references: [id])

  fromStatus BatchHoldStatus
  toStatus   BatchHoldStatus
  reason     String

  performedById String
  performedBy   User   @relation("BatchHoldEvents", fields: [performedById], references: [id])

  createdAt DateTime @default(now())

  @@index([fgBatchId])
  @@map("batch_hold_events")
}

model FinishedGoodsStock {
  id String @id @default(uuid())

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  fgBatchId String
  fgBatch   FinishedGoodsBatch @relation(fields: [fgBatchId], references: [id])

  quantity         Int
  reservedQuantity Int @default(0)
  /// Returned packs that failed QC / arrived damaged. Never sellable and never
  /// part of `quantity`, so no availability calculation has to know about it.
  damagedQuantity  Int @default(0)

  storageLocation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([warehouseId, fgBatchId])
  @@index([warehouseId])
  @@map("finished_goods_stock")
}

/// Shared per-day sequence for PB- and FG- numbers, keyed by prefix+date so
/// the two series increment independently.
model SequenceCounter {
  /// e.g. "PB-20260807" or "FG-20260807"
  key        String @id
  lastNumber Int    @default(0)

  @@map("sequence_counters")
}

// ---------------------------------------------------------------------------
// Product Master
// ---------------------------------------------------------------------------

model Product {
  id       String  @id @default(uuid())
  name     String
  sku      String  @unique
  unit     String // e.g. KG, LITRE, PACK
  isActive Boolean @default(true)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  // --- Storefront catalogue metadata -----------------------------------
  // Nothing above this line was written with a shopper in mind - `name` is an
  // operations label, not marketing copy. These fields are additive and
  // optional so every screen and API caller that already reads Product is
  // unaffected; they matter only once `showOnStorefront` is turned on.
  description      String?
  images           String[] @default([])
  /// Off by default: an internal SKU does not appear to a shopper until staff
  /// deliberately publish it, same reasoning as isActive gating pickers.
  showOnStorefront Boolean  @default(false)

  /// URL-safe, unique when set. Null is fine - a product not yet published
  /// does not need one, and requiring it up front would block creating a
  /// product before its storefront copy is ready.
  slug            String? @unique
  metaTitle       String?
  metaDescription String?

  /// Inventory thresholds, product-level rather than per-warehouse for now -
  /// the catalogue asks "should this be flagged low" as one number, not one
  /// per location. Per-warehouse thresholds are a real future need (a branch
  /// with its own reorder cadence) but nothing today asks for it, so it is
  /// not built. Sellable quantity itself stays computed from
  /// FinishedGoodsStock, never duplicated here - these are only the trip
  /// wires against that live number.
  reorderPoint   Int?    @default(0)
  safetyStock    Int?    @default(0)
  allowBackorder Boolean @default(false)

  // --- Product detail page content (added 19 Sep) -----------------------
  // Everything below drives a section of the storefront product page, which
  // until now read a hardcoded mock array in the customer app. All optional
  // and additive: a product with none of it still renders, it just shows
  // fewer sections. Prices are deliberately NOT here - they stay dated
  // PriceList rules so historical invoices reproduce (see PriceList).

  /// Marketing brand, distinct from the manufacturer entity below.
  brand            String?
  /// The pack descriptor a shopper reads under the name - "10kg Bag",
  /// "100g x 20". Not `unit`, which is the operational measure (KG/PACK).
  packLabel        String?
  /// Shipping weight of one pack in kg (goods + packaging). Drives which rider
  /// vehicle may carry a delivery; null = not recorded (no vehicle limit applied).
  packWeightKg     Decimal? @db.Decimal(10, 3)
  /// Days after delivery this product can be returned / exchanged. Null = the
  /// channel default in Return Settings; 0 = not returnable. Also how long an
  /// affiliate's commission on it is held. Copied onto each order line.
  returnWindowDays Int?
  /// Struck-through reference price. The sell price is a PriceList rule;
  /// this is the "was" figure a discount is calculated against, and it is a
  /// property of the pack, not of a channel.
  mrp              Decimal? @db.Decimal(12, 2)
  /// Small overlay on the product card - "Buy 10 Get 1", "100% Sharbati".
  badge            String?
  hsnCode          String?

  /// Display-only until a real review subsystem exists. Staff-entered, so a
  /// seeded catalogue does not show "0 ratings" on every card.
  rating      Decimal? @db.Decimal(3, 2)
  reviewCount Int?

  /// Bullet list above the fold on the product page.
  highlights String[] @default([])

  manufacturer    String?
  countryOfOrigin String?
  shelfLife       String?
  disclaimer      String?
  returnPolicy    String?
  warranty        String?

  /// B2C order limits, per order line.
  minOrderQuantity Int?
  maxOrderQuantity Int?

  /// B2B wholesale order parameters - the MOQ / max / master-pack trio the
  /// retailer view of the product page is built around.
  moqB2B              Int?
  maxOrderQuantityB2B Int?
  packBoxSize         Int?
  bulkAvailable       Boolean @default(false)

  /// The "Business & GST Compliance" panel, shown only to retailers.
  gstInvoiceAvailable    Boolean @default(true)
  businessSupportContact String?
  deliveryTerms          String?

  /// Which curated storefront shelves this product is pinned to. Homepage
  /// sections read these rather than a hardcoded list, so a Super Admin
  /// changing a product's price or name changes it everywhere it appears.
  /// `isTopPick` feeds "Popular Products" and each category's Top Picks tab;
  /// `isDailyStaple` feeds "Best of the Basics".
  /// How the B2B tier table is ENTERED. false = each tier is a per-unit price;
  /// true = each tier is the TOTAL for that quantity (5 packs -> 2750), and the
  /// per-unit price is derived from it. Either way PriceList.unitPrice holds the
  /// per-unit figure the order engine multiplies by quantity - see PriceList.tierTotal.
  b2bTiersAreTotals Boolean @default(false)

  isTopPick     Boolean @default(false)
  isDailyStaple Boolean @default(false)

  /// Per-product loyalty override. INHERIT = use the category rule.
  loyaltyEligibility LoyaltyEligibility @default(INHERIT)

  recipes              Recipe[]
  productionBatches    ProductionBatch[]
  finishedGoodsBatches FinishedGoodsBatch[]

  variants       ProductVariant[]
  specifications ProductSpecification[]
  faqs           ProductFaq[]
  offers         ProductOffer[]

  // Phase 4
  priceLists          PriceList[]
  replacementRequests ReturnRequest[] @relation("ReturnReplacementProduct")
  orderItems          OrderItem[]
  posSaleLines        PosSaleLine[]

  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  wishlistedBy CustomerWishlistItem[]
  reviews      ProductReview[]

  @@index([categoryId])
  @@map("products")
}

/// Customer-facing taxonomy (added 16 Sep for the storefront catalogue).
/// Deliberately separate from the operational `category` string Product used
/// to carry - that was free text with no uniqueness, no hierarchy and no way
/// to render a collection page. A self-relation gives two levels of nesting
/// (e.g. "Flours" -> "Multigrain Flours") without a fixed depth limit; the
/// service refuses a category becoming its own ancestor.
model Category {
  id           String  @id @default(uuid())
  name         String
  /// URL-safe, unique - what a storefront collection page resolves on.
  slug         String  @unique
  description  String?
  imageUrl     String?
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  /// Loyalty default for everything filed here. INHERIT = ask the parent
  /// category, then the program default. A product can override it.
  loyaltyEligibility LoyaltyEligibility @default(INHERIT)

  products Product[]

  /// Affiliate commission % for this category, when Super Admin set one.
  affiliateRate AffiliateCategoryRate?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@map("categories")
}

// ---------------------------------------------------------------------------
// Product detail page content (added 19 Sep)
//
// Four child tables rather than JSON columns on Product: each is an ordered
// list a Super Admin edits row by row, and the admin screen needs to reorder
// and delete individual entries. JSON would make every edit a
// read-modify-write of the whole blob, and would put no constraint on shape.
// ---------------------------------------------------------------------------

/// A pack size / SKU variation of the same product - "5kg Bag" vs "10kg Bag".
///
/// A variant carries its own SKU and MRP, but NOT its own price column:
/// prices are PriceList rules keyed on (product, variant, channel, quantity),
/// so a variant's rate is superseded and dated exactly like a product's.
model ProductVariant {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name   String
  /// Unique across the catalogue, same rule as Product.sku - a variant is a
  /// distinct sellable unit and a picking slip has to resolve it.
  sku    String   @unique
  /// Falls back to the parent product's unit when null.
  unit   String?
  mrp    Decimal? @db.Decimal(12, 2)
  images String[] @default([])

  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  priceLists PriceList[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, displayOrder])
  @@map("product_variants")
}

/// One row of the specifications table - "Net Weight" / "10 KG".
model ProductSpecification {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  label        String
  value        String
  displayOrder Int    @default(0)

  @@index([productId, displayOrder])
  @@map("product_specifications")
}

/// One question and answer in the product page's FAQ accordion.
model ProductFaq {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  question     String
  answer       String
  displayOrder Int    @default(0)

  @@index([productId, displayOrder])
  @@map("product_faqs")
}

/// A bank/promotional offer line shown on the product page. Distinct from
/// `Scheme`, which is a homepage tile and belongs to no product.
model ProductOffer {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  title        String
  description  String
  displayOrder Int    @default(0)

  @@index([productId, displayOrder])
  @@map("product_offers")
}

// ---------------------------------------------------------------------------
// Warehouse Master (stub - stock/batch relations added in Phase 2-3)
// ---------------------------------------------------------------------------

model Warehouse {
  id       String   @id @default(uuid())
  name     String
  location String
  capacity Decimal? @db.Decimal(12, 2)
  isActive Boolean  @default(true)

  /// CENTRAL = the depot that ships nationally through the 3PL. OUTLET = a
  /// franchise store that delivers locally with its own riders. Both hold
  /// finished goods stock in the same table, so there is one inventory truth.
  kind            WarehouseKind @default(CENTRAL)
  city            String?
  state           String?
  pincode         String?
  /// Where the node physically is, for the distance test at checkout.
  latitude        Decimal?      @db.Decimal(9, 6)
  longitude       Decimal?      @db.Decimal(9, 6)
  /// How far this outlet delivers. Null = the program default (CheckoutSettings).
  serviceRadiusKm Decimal?      @db.Decimal(6, 2)
  contactPhone    String?

  stockReservations StockReservation[]
  deliveryZones     DeliveryZone[]
  riders            Rider[]
  deliveryTasks     DeliveryTask[]

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  // Phase 2
  batches           RawMaterialBatch[]
  stock             WarehouseStock[]
  movementsOutgoing StockMovement[]    @relation("StockMovementFrom")
  movementsIncoming StockMovement[]    @relation("StockMovementTo")

  // Phase 3
  finishedGoodsStock FinishedGoodsStock[]

  /// Set when this warehouse is a POS store's stock location.
  posOutlet PosOutlet?

  // Phase 4
  orders                       Order[]
  orderAllocations             OrderAllocation[]
  returnRequests               ReturnRequest[]               @relation("ReturnReceivingWarehouse")
  returnReplacementAllocations ReturnReplacementAllocation[]

  /// Runs drawing raw material from here (FRD 17.2 reservation).
  productionBatches ProductionBatch[]

  // Supplier transports destined for this warehouse
  supplierTransports SupplierTransport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("warehouses")
}

// ===========================================================================
// PHASE 4 - SALES, ORDER FULFILMENT & DELIVERY (FRD Sections 24-28)
//
// Client decision, 11-Aug-2026: the system sells through BOTH channels, B2B
// (distributors and retailers, taken by a sales executive) and B2C (consumers
// buying directly), at DIFFERENT PRICES.
//
// Two consequences are baked into the model rather than bolted on later:
//
//   1. `channel` is a first-class column on Customer and Order. Nothing in the
//      order path is allowed to assume a single channel.
//   2. Price is not a column on Product. It lives in a dated PriceList keyed on
//      (product, channel, customerType), so the two channels can never collide
//      and an invoice raised last quarter still reprints at last quarter's rate.
// ===========================================================================

enum SalesChannel {
  B2B
  B2C
}

enum CustomerType {
  DISTRIBUTOR
  RETAILER
  INSTITUTIONAL
  CONSUMER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

/// Credit is a B2B concept. Consumers pay up front, always.
enum PaymentTerms {
  PREPAID
  CREDIT_7
  CREDIT_15
  CREDIT_30
  CREDIT_45
}

/// The day a credit order's "Net N days" starts counting from. A commercial
/// decision the client has not confirmed (SVV_Balaji_FRD34_Reporting_Gaps.md
/// section 3), so it is a Super Admin setting rather than code: DISPATCH is the
/// documented recommendation and the default.
enum CreditPeriodStart {
  DISPATCH
  ORDER_DATE
}

/// How a retailer settled a credit bill. Recorded by staff; no money moves
/// through the system for these.
enum ReceiptMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  OTHER
}

enum OrderStatus {
  DRAFT
  PLACED
  CONFIRMED
  ALLOCATED
  PACKED
  DISPATCHED
  DELIVERED
  CANCELLED
}

model Customer {
  id String @id @default(uuid())

  /// Format: CUST-B2B-000001 / CUST-B2C-000001. Channel is visible in the code
  /// itself because operations staff read these aloud on the phone.
  customerCode String @unique

  channel SalesChannel
  type    CustomerType

  name        String
  contactName String?
  phone       String
  email       String?

  /// Required for B2B (needed on the tax invoice), never required for B2C.
  /// Enforced in CustomersService, not by the database, so the rule is testable.
  gstin             String?
  udyamRegistration String?
  pan               String?
  aadhaar           String?

  billingAddress  String
  shippingAddress String?
  city            String?
  district        String?
  state           String?
  pincode         String?

  creditLimit    Decimal?        @db.Decimal(14, 2)
  paymentTerms   PaymentTerms    @default(PREPAID)
  creditReceipts CreditReceipt[]
  invoices       Invoice[]
  creditNotes    CreditNote[]

  status CustomerStatus @default(ACTIVE)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  /// Sales executive who owns the relationship. B2C customers have none.
  assignedToId String?
  assignedTo   User?   @relation("CustomerAssignedTo", fields: [assignedToId], references: [id])

  orders Order[]

  /// The storefront login attached to this record, if they shop online.
  /// Staff-created customers who only ever order by phone have none.
  account CustomerAccount?

  /// Auto-generated on creation (every channel, every creation path - staff
  /// form and self-registration alike), unique, human-shareable
  /// (e.g. "RAUNAK4821"). This is the code printed into their referral link;
  /// see Referral below for the relationship it is used to create.
  referralCode String @unique

  /// The relationship that brought this customer in, if any - null for
  /// everyone who signed up without a code or was created by staff.
  referredAs Referral? @relation("ReferralReferee")

  /// Everyone this customer has successfully referred.
  referralsGiven Referral[] @relation("ReferralReferrer")

  /// Denormalised running total across BOTH pools - see CoinTransaction for
  /// the ledger that is the actual source of truth. Always equal to
  /// referralCoinBalance + loyaltyCoinBalance; kept because most reads (order
  /// totals, staff-facing "coin balance" columns) only ever want the sum.
  coinBalance Int @default(0)

  /// Denormalised per-pool running totals, updated in the same transaction as
  /// coinBalance and the CoinTransaction row that explains the change - never
  /// written to directly. Split out so WalletService can show/redeem each
  /// pool independently without summing the ledger on every read.
  referralCoinBalance Int @default(0)
  loyaltyCoinBalance  Int @default(0)

  coinTransactions CoinTransaction[]

  addresses         CustomerAddress[]
  checkoutSessions  CheckoutSession[]
  couponRedemptions CouponRedemption[]

  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  wishlistItems  CustomerWishlistItem[]
  supportTickets SupportTicket[]
  productReviews ProductReview[]

  /// Rupee Refund Wallet - money, unlike the coin pools above. Denormalised
  /// running total; RefundWalletTransaction is the ledger and the truth, and the
  /// two are only ever written together (RefundWalletService).
  refundWalletBalance      Decimal                   @default(0) @db.Decimal(14, 2)
  refundWalletTransactions RefundWalletTransaction[]
  returnRequests           ReturnRequest[]

  @@index([channel])
  @@index([status])
  @@index([branchId])
  @@map("customers")
}

/// One row per successful referral. Deliberately not just a `referredById`
/// field on Customer: a dedicated row gives an audit trail (the code as it was
/// entered, when) that survives the referrer later regenerating their own
/// code, and `refereeId` being unique is what makes "this customer already has
/// a referral relationship" a database guarantee rather than an application
/// check that something could race.
///
/// Created exactly once, at the moment the referee's Customer row is created
/// (B2C: first OTP verify; B2B: staff approval) - never on code entry or link
/// open, which is not a successful referral yet. See
/// storefront-auth.service.ts's `resolveReferral`.
model Referral {
  id String @id @default(uuid())

  referrerId String
  referrer   Customer @relation("ReferralReferrer", fields: [referrerId], references: [id])

  refereeId String   @unique
  referee   Customer @relation("ReferralReferee", fields: [refereeId], references: [id])

  /// The code as entered at signup, kept even if the referrer's own code is
  /// later regenerated - the audit trail should not silently change under it.
  code String

  /// Set once the configured reward trigger has fired and coins have been
  /// credited to both sides - null means "not yet rewarded", not "never will
  /// be". Checked before crediting so a relationship is never paid out twice,
  /// including across an admin changing the trigger after some referrals
  /// already earned their reward under the old one.
  rewardedAt DateTime?

  coinTransactions CoinTransaction[]

  createdAt DateTime @default(now())

  @@index([referrerId])
  @@map("referrals")
}

enum ReferralRewardTrigger {
  REGISTRATION
  ACCOUNT_VERIFICATION
  FIRST_ORDER
  FIRST_DELIVERY
}

enum CoinTransactionReason {
  REFERRAL_REFERRER_REWARD
  REFERRAL_REFEREE_REWARD
  /// Negative. Referral coins spent to pay part of an order at checkout.
  REFERRAL_REDEMPTION
  /// Positive. Redeemed referral coins given back because the order was cancelled.
  REFERRAL_REDEMPTION_REFUND
  /// Loyalty points earned on a DELIVERED order. `expiresAt`/`remainingAmount`
  /// are set on these rows only.
  LOYALTY_EARN
  /// Negative. Points taken back because eligible items were returned/refunded.
  LOYALTY_REVERSAL
  /// Negative. Unspent points that passed their `expiresAt`.
  LOYALTY_EXPIRY
  /// Negative. Points spent to pay part of an order at checkout.
  LOYALTY_REDEMPTION
  /// Positive. Redeemed points given back because the order was cancelled.
  LOYALTY_REDEMPTION_REFUND
  /// A Super Admin correction - refund, reversal, or any other manual fix.
  /// `amount` carries the sign (negative claws back); `note` is required at
  /// the API layer for this reason, because unlike the two above there is no
  /// automatic event to point back to.
  MANUAL_ADJUSTMENT
}

/// Which pool of the wallet a CoinTransaction belongs to. Deliberately a
/// separate field from `reason` (rather than parsed out of the reason string)
/// so wallet-wide queries - balance-by-source, redemption FIFO lot selection -
/// never depend on string-matching an enum meant to describe the *event*.
enum CoinSource {
  REFERRAL
  LOYALTY
}

/// Staff-configured, single row (see ReferralService.getSettings, which
/// lazily creates it - there is no seed script for a fresh database).
/// Read live at every candidate trigger event rather than frozen onto a
/// Referral at creation, so changing the trigger applies to relationships
/// already in flight, not only ones created after the change.
model ReferralSettings {
  id String @id @default(uuid())

  referrerRewardCoins Int                   @default(100)
  refereeRewardCoins  Int                   @default(50)
  rewardTrigger       ReferralRewardTrigger @default(REGISTRATION)

  /// The program-wide kill switch. While false: no new referral code may be
  /// entered at signup, and nothing already in flight is credited, regardless
  /// of when its Referral row was created.
  isActive Boolean @default(true)

  // --- Redemption --------------------------------------------------------
  // Mirrors LoyaltySettings' redemption fields exactly, so WalletService can
  // treat both pools identically at checkout - the two schemes are meant to
  // read as siblings, not as one canonical design and one bolted-on copy.

  /// Whether referral coins can be spent at checkout at all. While false,
  /// referral coins can still be earned and viewed but never redeemed.
  redemptionEnabled Boolean @default(false)

  /// What one referral coin is worth when redeemed.
  pointValueInr Decimal @default(1) @db.Decimal(10, 4)

  /// Ceiling on how much of an order's payable amount referral coins may
  /// cover, as a percentage. Same semantics as LoyaltySettings.maxRedemptionPercent.
  maxRedemptionPercent Int @default(50)

  /// A redemption below this many coins is refused outright (avoids a
  /// customer spending, say, 2 coins for a token discount).
  minRedeemPoints Int @default(0)

  /// Months until an earned referral coin lapses if unspent - null means
  /// referral coins never expire (the historical behaviour, kept as default).
  pointsExpiryMonths Int?

  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("referral_settings")
}

/// Wallet-wide configuration that belongs to neither the referral nor the
/// loyalty program specifically - today, just whether the two coin pools are
/// redeemed as one merged balance or kept independent at checkout. Singleton,
/// same lazy-create-on-first-read pattern as ReferralSettings/LoyaltySettings.
model WalletSettings {
  id String @id @default(uuid())

  /// SEPARATE: each pool has its own cap (its own maxRedemptionPercent) and
  /// the customer applies them as two distinct amounts at checkout.
  /// COMBINED: the two balances are pooled into one number and one cap - the
  /// smaller of the two configured maxRedemptionPercent values is used as the
  /// pooled cap, so combining coins never grants more spending power than
  /// either program alone would allow.
  redemptionMode WalletRedemptionMode @default(SEPARATE)

  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("wallet_settings")
}

enum WalletRedemptionMode {
  SEPARATE
  COMBINED
}

/// The coin ledger. `Customer.coinBalance` is a denormalised running total for
/// cheap reads - never written to directly outside ReferralService.creditReward,
/// which always writes the matching row here in the same transaction. Same
/// invariant this project already holds for warehouse stock and StockMovement:
/// a balance never moves without a ledger entry explaining why.
model CoinTransaction {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  /// Positive credits, negative debits. The two referral reasons are always
  /// positive (nothing spends coins yet); MANUAL_ADJUSTMENT is the one reason
  /// that can go either way - a refund/bonus is positive, a clawback/reversal
  /// is negative. `Customer.coinBalance` is always incremented by exactly
  /// this value, so the balance is correct under either sign without a
  /// separate debit code path.
  amount Int
  reason CoinTransactionReason

  /// Which wallet pool this row belongs to - see CoinSource. Every reason
  /// maps to exactly one source (enforced in code at the two write sites:
  /// ReferralService and LoyaltyService); MANUAL_ADJUSTMENT is the one
  /// reason a staff member picks the source for explicitly, since it can
  /// correct either pool.
  source CoinSource

  /// Free text. Required at the API layer for MANUAL_ADJUSTMENT (the "why" -
  /// there is no automatic event to point back to); optional and usually
  /// unset for the two referral reasons, which speak for themselves via
  /// `referralId`.
  note String?

  referralId String?
  referral   Referral? @relation(fields: [referralId], references: [id])

  /// The order whose CONFIRMED/DELIVERED transition triggered this reward,
  /// when the configured trigger is order-based. Null for REGISTRATION/
  /// ACCOUNT_VERIFICATION rewards (no order exists yet) and for every
  /// MANUAL_ADJUSTMENT.
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  /// LOYALTY_EARN only: when these points lapse (null = never), and how many of
  /// them are still live. Reversals and expiry both draw `remainingAmount` down,
  /// which is what stops a return reversing points that already expired.
  expiresAt       DateTime?
  remainingAmount Int?

  /// Staff who made a MANUAL_ADJUSTMENT. Null for every system-generated row
  /// (both referral reward reasons) - there is no "performer" for those,
  /// only a trigger event.
  performedById String?
  performedBy   User?   @relation("CoinTransactionsPerformed", fields: [performedById], references: [id])

  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([reason, expiresAt])
  @@index([customerId, source])
  @@map("coin_transactions")
}

/// A dated price for one product in one channel.
///
/// Rows are never edited once orders reference them - supersede by closing
/// `effectiveTo` and inserting a new row. That is what keeps historical
/// invoices reproducible.
model PriceList {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  /// Which pack size this rate is for. Null means the rule prices the product
  /// itself, which is every row written before 19 Sep 2026 and every row an
  /// order line resolves today.
  ///
  /// Resolution treats null as a value, not a wildcard: a product-level
  /// lookup matches ONLY null rows, so a variant rate can never leak into a
  /// line that did not ask for that variant.
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  channel SalesChannel

  /// Optional refinement within a channel - e.g. distributors get a keener
  /// rate than retailers. Null means "any customer type in this channel".
  customerType CustomerType?

  unitPrice Decimal @db.Decimal(12, 2)
  currency  String  @default("INR")

  /// Held per price row because GST rate is a property of what is being sold
  /// and can change by notification.
  gstRatePercent Decimal @default(5) @db.Decimal(5, 2)

  /// Quantity break. A row with minQuantity 50 beats one with minQuantity 1
  /// when the line qualifies.
  minQuantity Int @default(1)

  /// Set only when the tier was entered as a total for minQuantity units. Kept so
  /// the admin form shows back exactly what was typed (1000 over 3 units is 333.33
  /// per unit, and 333.33 x 3 would read 999.99). unitPrice = tierTotal / minQuantity.
  tierTotal Decimal? @db.Decimal(12, 2)

  effectiveFrom DateTime
  effectiveTo   DateTime?

  isActive Boolean @default(true)

  createdById String
  createdBy   User   @relation("PriceListsCreated", fields: [createdById], references: [id])

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, channel, effectiveFrom])
  @@index([variantId])
  @@index([channel])
  @@map("price_lists")
}

model Order {
  id String @id @default(uuid())

  /// Format: SO-YYYYMMDD-NNN
  orderNumber String @unique

  /// Denormalised from the customer deliberately: the channel an order was
  /// taken through is a fact about the order, and must not change if the
  /// customer record is later edited.
  channel SalesChannel

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  status OrderStatus @default(DRAFT)

  orderDate      DateTime
  requiredByDate DateTime?

  /// Warehouse the order is fulfilled from - allocation only draws stock here.
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  subtotal Decimal @default(0) @db.Decimal(14, 2)
  taxTotal Decimal @default(0) @db.Decimal(14, 2)
  total    Decimal @default(0) @db.Decimal(14, 2)

  paymentStatus     PaymentStatus             @default(PENDING)
  paymentTerms      PaymentTerms              @default(PREPAID)
  /// Credit orders: how much of `total` has been settled by receipts (sum of
  /// this order's live CreditReceiptAllocation rows). PARTIAL / PAID follow
  /// from it. Outstanding = total - amountPaid.
  amountPaid        Decimal                   @default(0) @db.Decimal(14, 2)
  creditAllocations CreditReceiptAllocation[]

  /// Sales executive who captured the order. Null for a B2C order the consumer
  /// placed themselves.
  placedById String?
  placedBy   User?   @relation("OrdersPlaced", fields: [placedById], references: [id])

  /// Where this order was shipped, captured at the moment it was raised.
  ///
  /// A snapshot, not a lookup. It used to be inferred from the customer's
  /// current `shippingAddress`, which meant editing a customer retroactively
  /// rewrote where every past order had been delivered - the same class of
  /// error the denormalised `channel` above already guards against. Defaults
  /// from the customer at create time and can be overridden per order, which
  /// is what a one-off delivery to a different site actually needs.
  deliveryAddress String?

  notes           String?
  cancelledReason String?
  cancelledAt     DateTime?

  /// When the goods physically left the warehouse.
  ///
  /// Written by `advance()` at the DISPATCHED transition. Exists because
  /// "Delayed Shipments" (FRD 34, Delivery Reports) compares this against
  /// `requiredByDate`, and status alone cannot answer it - an order that is
  /// DISPATCHED tells you it left, never when.
  ///
  /// It is also the only defensible start for the credit period: CREDIT_30 has
  /// to count from something, and dispatch is the point the customer actually
  /// received value. See SVV_Balaji_FRD34_Reporting_Gaps.md - the client has
  /// not confirmed this yet.
  dispatchedAt DateTime?

  /// When the customer took delivery. Written by `advance()` at DELIVERED.
  ///
  /// The other half of "Delivery Performance". Deliberately separate from
  /// `dispatchedAt` rather than derived from it: transit time is the number
  /// worth watching, and it is the difference between the two.
  deliveredAt DateTime?

  items       OrderItem[]
  allocations OrderAllocation[]

  /// Set on a referral reward's ledger rows when a FIRST_ORDER/FIRST_DELIVERY
  /// trigger paid out because of this specific order - see CoinTransaction.
  coinTransactions CoinTransaction[]

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  loyaltyEarn    LoyaltyOrderEarn?
  returns        OrderReturn[]
  returnRequests ReturnRequest[]

  // ---- Storefront checkout (all null/default for staff-placed orders) ----
  source            OrderSource        @default(STAFF)
  /// LOCAL (franchise outlet, in-house rider) or SHIPROCKET (central depot, 3PL).
  /// Decided by the server from the delivery address; the customer never picks it.
  fulfillmentMethod FulfillmentMethod?
  /// Immutable copy of the delivery address as it was when the order was placed.
  addressSnapshot   Json?
  /// The full server-side quote (lines, tax, discounts, fee, ETA) frozen at placement.
  pricingSnapshot   Json?
  distanceKm        Decimal?           @db.Decimal(8, 2)
  etaMin            DateTime?
  etaMax            DateTime?

  /// Doorstep proof-of-delivery code. Shown only to the customer who owns the
  /// order; staff enter what the customer reads out.
  deliveryOtp           String?
  deliveryOtpAttempts   Int       @default(0)
  deliveryOtpVerifiedAt DateTime?

  paymentMode      PaymentMode?
  gatewayOrderId   String?
  gatewayPaymentId String?

  discountTotal            Decimal                   @default(0) @db.Decimal(14, 2)
  deliveryFee              Decimal                   @default(0) @db.Decimal(14, 2)
  couponCode               String?
  loyaltyRedeemedPoints    Int                       @default(0)
  loyaltyRedeemedInr       Decimal                   @default(0) @db.Decimal(14, 2)
  referralRedeemedPoints   Int                       @default(0)
  referralRedeemedInr      Decimal                   @default(0) @db.Decimal(14, 2)
  /// Paid from the customer's Refund Wallet. A payment, not a discount: `total`
  /// (the invoice value) is unchanged; cash/gateway/COD due = total - this.
  refundWalletPaidInr      Decimal                   @default(0) @db.Decimal(14, 2)
  refundWalletTransactions RefundWalletTransaction[]

  riderName  String?
  riderPhone String?

  /// STANDARD unless the customer chose Quick Delivery in an eligible zone.
  deliverySpeed  DeliverySpeed  @default(STANDARD)
  deliveryZoneId String?
  deliveryZone   DeliveryZone?  @relation(fields: [deliveryZoneId], references: [id])
  deliveryTasks  DeliveryTask[]

  checkoutSessionId String?          @unique
  checkoutSession   CheckoutSession? @relation(fields: [checkoutSessionId], references: [id])

  shipment            OrderShipment?
  invoices            Invoice[]
  events              OrderEvent[]
  paymentTransactions PaymentTransaction[]
  stockReservations   StockReservation[]
  couponRedemption    CouponRedemption?
  productReviews      ProductReview[]

  /// Card / UPI / contact identifiers of the payment, read back from the
  /// gateway after it was verified ("upi:name@bank", "token:...", "phone:...").
  /// Only ever compared - the affiliate self-referral check matches a buyer's
  /// payment against the affiliate's own past payments. Empty for COD/credit.
  paymentFingerprints  String[]              @default([])
  affiliateAttribution AffiliateAttribution?
  affiliateCommissions AffiliateCommission[]

  @@index([channel])
  @@index([status])
  @@index([customerId])
  @@index([orderDate])
  /// Every delivery report is a date-range scan over dispatches. Partial,
  /// because an order that has not shipped is never in one of those answers.
  @@index([dispatchedAt])
  @@map("orders")
}

model OrderItem {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  /// Packs ordered.
  quantity Int

  /// Resolved from the price list at placement and then frozen. A later price
  /// change must never silently restate an order that is already out.
  unitPrice Decimal @db.Decimal(12, 2)

  /// Which price rule was applied. Kept so a disputed invoice can be answered
  /// with "this row, effective this date" rather than an opinion.
  priceListId String?
  priceList   PriceList? @relation(fields: [priceListId], references: [id])

  gstRatePercent Decimal @db.Decimal(5, 2)

  lineSubtotal Decimal @db.Decimal(14, 2)
  /// This line's pro-rata share of the order-level discount (coupon + points
  /// redeemed). GST is charged on subtotal minus this.
  lineDiscount Decimal @default(0) @db.Decimal(14, 2)
  lineTax      Decimal @db.Decimal(14, 2)
  lineTotal    Decimal @db.Decimal(14, 2)

  /// Frozen at placement so a later rename or re-SKU never rewrites history.
  skuSnapshot      String?
  nameSnapshot     String?
  /// The product's return window when ordered (frozen like the price). Null =
  /// the channel default at the time of the return; 0 = not returnable.
  returnWindowDays Int?

  allocations OrderAllocation[]

  loyaltyLine    LoyaltyOrderEarnLine?
  returns        OrderReturn[]
  returnRequests ReturnRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, productId])
  @@index([orderId])
  @@map("order_items")
}

/// Which physical pack batches satisfy an order line.
///
/// This is the row that keeps the traceability promise alive through the sales
/// half of the system: order -> allocation -> FG batch -> production run ->
/// raw material batch -> farmer. Without it, a delivered order is anonymous.
model OrderAllocation {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  fgBatchId String
  fgBatch   FinishedGoodsBatch @relation(fields: [fgBatchId], references: [id])

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  quantity Int

  allocatedById String
  allocatedBy   User   @relation("OrderAllocations", fields: [allocatedById], references: [id])

  /// Set when the reservation is given back - cancelling the order, or a
  /// re-allocation. The row is never deleted.
  ///
  /// A-13 (16 Aug): cancel() used to `deleteMany` these after releasing the
  /// reservations. The stock was returned correctly, but the record of WHICH
  /// batches were promised to this customer was destroyed - so "you allocated
  /// me FG-20260812-003 and then cancelled" had no answer in the data. For a
  /// traceability product that is a strange place to economise, and once
  /// finished goods have movements the release would show as stock activity
  /// with nothing to explain it.
  ///
  /// Every read of LIVE allocations filters `releasedAt: null`.
  releasedAt     DateTime?
  releasedReason String?

  /// Set when packing staff scan this batch's label against the order, proving
  /// the pack physically in the box is the batch the system allocated (FIFO).
  scannedAt   DateTime?
  scannedById String?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([fgBatchId])
  @@map("order_allocations")
}

// ---------------------------------------------------------------------------
// Role-based access control (WS2.x, 15 Aug)
// ---------------------------------------------------------------------------

/// One grant: this role holds this permission.
///
/// The row's existence IS the grant - there is no `allowed` boolean, because a
/// row saying "denied" and no row at all would mean the same thing and would
/// eventually disagree. Revoking deletes.
///
/// `permission` is a plain string rather than an enum on purpose. The
/// authoritative list lives in src/auth/permissions/registry.ts, and writes are
/// validated against it. Making it a Postgres enum would mean a migration every
/// time a screen is added - which is the exact coupling this table exists to
/// remove.
///
/// SUPER_ADMIN never appears here. PermissionsGuard short-circuits for it, so
/// storing its grants would create a state where the last administrator can be
/// locked out of the administration screen.
model RolePermission {
  id String @id @default(uuid())

  role       UserRole
  permission String

  createdAt DateTime @default(now())

  @@unique([role, permission])
  @@index([role])
  @@map("role_permissions")
}

/// Marks a role as having been configured at least once.
///
/// Without this, "this role holds no permissions" and "this role has never been
/// set up" are the same empty result, and the seeder could not tell whether an
/// empty grant set was deliberate. A Super Admin who deliberately strips a role
/// bare must not have the defaults handed back to it on the next restart.
/// Every permission key the system has already reconciled against role grants.
///
/// This is what lets boot tell a NEW key from one an administrator deliberately
/// revoked (A-14). A key absent here is new: configured roles whose registry
/// defaults include it are granted it once, then it is recorded. A key present
/// here is never re-granted, so revocations stick across restarts.
model PermissionKeyState {
  permission String   @id
  seenAt     DateTime @default(now())

  @@map("permission_key_state")
}

model RolePermissionState {
  role UserRole @id

  seededAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@map("role_permission_state")
}

// ---------------------------------------------------------------------------
// Land profiling (WS3.1, 16 Aug)
// ---------------------------------------------------------------------------

/// One cultivable plot belonging to a farmer.
///
/// Farmers here rarely hold a single contiguous field - two or three scattered
/// plots with different soil, irrigation and crops is the norm. The summary
/// fields on `Farmer` (farmSizeAcres, landType, irrigationType, cropDetails)
/// average all of that into one row, which is fine for a registry and useless
/// for advisory work: an Agriculture Expert advising on irrigation needs to
/// know WHICH plot is rain-fed.
///
/// Those Farmer fields are deliberately left in place. They are what the
/// onboarding desk captures at registration and what every existing screen
/// reads; plots are the detail the field executive adds afterwards. Removing
/// them would be a migration across six screens for no gain.
model FarmPlot {
  id String @id @default(uuid())

  farmerId String
  farmer   Farmer @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  /// What the farmer calls it, or the revenue survey number.
  name         String
  surveyNumber String?

  areaAcres Decimal @db.Decimal(10, 2)

  soilType       String?
  irrigationType String?
  waterSource    String?

  /// What is growing on it now. Free text, because the crop list is not a
  /// master in this system and inventing one here would fork it from the
  /// crop names used on agreements and collections.
  currentCrop     String?
  sowingDate      DateTime?
  expectedHarvest DateTime?

  /// "lat,lng" captured on the plot, same format as Farmer.gpsLocation. Held
  /// as text rather than two Decimals to match what is already stored and read
  /// by the trace page - one format, one parser.
  gpsLocation String?

  notes String?

  isActive Boolean @default(true)

  createdById String
  createdBy   User   @relation("FarmPlotsCreated", fields: [createdById], references: [id])

  /// What has been harvested from this plot. These are what turn a plot from a
  /// description into part of the traceability chain.
  harvestInspections HarvestInspection[]     @relation("InspectedPlot")
  collections        RawMaterialCollection[] @relation("HarvestedPlot")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmerId])
  @@map("farm_plots")
}

// ===========================================================================
// SUPPLIER MODULE
//
// Suppliers are external entities who deliver raw materials but are NOT
// farmers. They don't have land profiles, seed distribution, training,
// field visits or harvest inspections. Instead of the Collection flow,
// they use Transport for inbound logistics, and Purchase Orders instead
// of Agreements.
// ===========================================================================

// ---------------------------------------------------------------------------
// Supplier (analogous to Farmer, but simpler)
// ---------------------------------------------------------------------------

model Supplier {
  id           String  @id @default(uuid())
  supplierCode String? @unique // SUP-YYYY-NNNNNN - assigned on approval

  fullName      String
  mobile        String
  aadhaarNumber String?
  panNumber     String?

  /// Business/firm name. Many suppliers in India operate as sole
  /// proprietorships and won't have one — keep it optional.
  companyName String?
  /// GST Identification Number for B2B tax invoices.
  gstin       String?

  address  String?
  city     String?
  district String?
  state    String?
  pincode  String?

  bankAccountName String?
  bankName        String?
  bankAccountNo   String?
  ifscCode        String?

  status SupplierStatus @default(PENDING_VERIFICATION)

  createdById String?
  createdBy   User?   @relation("SuppliersCreated", fields: [createdById], references: [id])

  verificationLogs   SupplierVerificationLog[]
  transports         SupplierTransport[]
  purchaseOrders     PurchaseOrder[]
  rawMaterialBatches RawMaterialBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("suppliers")
}

// ---------------------------------------------------------------------------
// Supplier code sequence - backs SUP-YYYY-NNNNNN traceability ID.
// ---------------------------------------------------------------------------

model SupplierCodeCounter {
  year       Int @id
  lastNumber Int @default(0)

  @@map("supplier_code_counters")
}

// ---------------------------------------------------------------------------
// Supplier Verification Audit Trail (same pattern as FarmerVerificationLog)
// ---------------------------------------------------------------------------

model SupplierVerificationLog {
  id         String   @id @default(uuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  action  SupplierVerificationAction
  remarks String?

  verifiedById String
  verifiedBy   User   @relation(fields: [verifiedById], references: [id])

  createdAt DateTime @default(now())

  @@index([supplierId])
  @@map("supplier_verification_logs")
}

// ---------------------------------------------------------------------------
// Purchase Orders (industry-standard supplier agreements)
//
// A Purchase Order is a binding commitment: SVV Balaji agrees to buy a
// specific material at a specific rate, and the supplier commits to deliver
// by a date. Transports reference the PO they fulfil so cost and quantity
// can be reconciled.
// ---------------------------------------------------------------------------

model PurchaseOrder {
  id String @id @default(uuid())

  /// Format: PO-YYYYMMDD-NNN
  poNumber String @unique

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  materialName     String
  expectedQuantity Decimal @db.Decimal(12, 2)
  unit             String  @default("KG")
  purchaseRate     Decimal @db.Decimal(12, 2)
  totalAmount      Decimal @db.Decimal(14, 2)

  orderDate    DateTime
  deliveryDate DateTime?

  qualityStandards String?
  terms            String?

  status PurchaseOrderStatus @default(DRAFT)

  createdById String
  createdBy   User   @relation("PurchaseOrdersCreated", fields: [createdById], references: [id])

  transports SupplierTransport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

// ---------------------------------------------------------------------------
// Supplier Transport (replaces Collection for suppliers)
//
// Lifecycle: SCHEDULED → IN_TRANSIT → DELIVERED (auto-creates batch)
//
// When a transport reaches DELIVERED, a RawMaterialBatch is automatically
// created in the destination warehouse — same as how Collection creates
// one for farmers, but without the inspection gate.
// ---------------------------------------------------------------------------

model SupplierTransport {
  id String @id @default(uuid())

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  /// Optional link to the PO this delivery fulfils.
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  materialName String
  quantity     Decimal @db.Decimal(12, 2)
  unit         String  @default("KG")

  vehicleNumber String?
  driverName    String?
  driverPhone   String?

  scheduledDate DateTime
  dispatchedAt  DateTime?
  deliveredAt   DateTime?

  deliveryLocation String?

  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  purchaseRate  Decimal?      @db.Decimal(12, 2)
  totalAmount   Decimal?      @db.Decimal(14, 2)
  paymentStatus PaymentStatus @default(PENDING)

  /// Receipt issued on delivery, same pattern as RawMaterialCollection.
  receiptNumber String? @unique

  batch RawMaterialBatch?

  status  TransportStatus @default(SCHEDULED)
  remarks String?

  createdById String
  createdBy   User   @relation("TransportsCreated", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([status])
  @@index([warehouseId])
  @@map("supplier_transports")
}

// ===========================================================================
// STOREFRONT IDENTITY (FRD Sections 29-31)
//
// Everything above this line is operated by staff: a User signs in and acts on
// records. The storefront is the first surface where somebody outside the
// company authenticates, and that difference is why identity is modelled here
// rather than by adding a CUSTOMER value to UserRole.
//
// Three things are deliberate:
//
//   1. CustomerAccount is the *login*; Customer is the *commercial record*.
//      They are separate because a B2B retailer signs up before anyone has
//      agreed to trade with them - they need somewhere to exist while pending
//      approval, without occupying a customerCode or appearing in the customer
//      master as though they were a live account. B2C consumers get both at
//      once, since there is nothing to approve.
//   2. Phone is unique here but NOT on Customer. A distributor and its depot
//      legitimately share a phone number in the customer master; a login
//      cannot.
//   3. Customer tokens are signed with their own secret (see
//      CUSTOMER_JWT_ACCESS_SECRET). JwtStrategy.validate() trusts any payload
//      carrying a valid signature without re-reading the user, so sharing the
//      staff secret would make a storefront token a staff token.
// ===========================================================================

enum CustomerAccountStatus {
  /// Signed up, phone not yet proven.
  PENDING_VERIFICATION
  /// B2B only: phone proven, waiting on staff to approve the business.
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  SUSPENDED
}

enum CustomerOtpPurpose {
  LOGIN
  REGISTRATION
}

model CustomerAccount {
  id String @id @default(uuid())

  /// 10-digit Indian mobile number, normalised (country code and punctuation
  /// stripped) before storage so that +91 98765 43210 and 9876543210 are the
  /// same account rather than two.
  phone String  @unique
  email String?

  fullName String

  /// Which storefront they signed up through. B2C self-serves; B2B is the
  /// retailer registration flow and requires approval.
  channel SalesChannel
  status  CustomerAccountStatus @default(PENDING_VERIFICATION)

  phoneVerifiedAt DateTime?
  lastLoginAt     DateTime?

  /// Rotated on every refresh, same contract as User.refreshTokenHash - one
  /// live session per account.
  refreshTokenHash String?

  /// The commercial record orders actually hang off. Null until the account is
  /// approved (B2B) or first verified (B2C).
  customerId String?   @unique
  customer   Customer? @relation(fields: [customerId], references: [id])

  // --- B2B registration details, captured at signup, before a Customer exists
  businessName      String?
  gstin             String?
  udyamRegistration String?
  pan               String?
  aadhaar           String?
  addressLine       String?
  city              String?
  district          String?
  state             String?
  pincode           String?

  /// A referral code entered at signup, held here until there is a Customer
  /// row to attach it to. B2C resolves it immediately (the Customer is
  /// created in the same call); B2B carries it until staff approve the
  /// registration, which is when its Customer row - and the Referral - is
  /// created. Re-validated at approval time (referrer must still exist and be
  /// active); if it no longer resolves, the referral is silently skipped
  /// rather than blocking the approval - it is a bonus relationship, not a
  /// gate on the retailer's own account.
  referralCode String?

  reviewedById    String?
  reviewedBy      User?     @relation("CustomerAccountsReviewed", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?

  otpChallenges CustomerOtpChallenge[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessions         CustomerSession[]
  pushDevices      PushDevice[]
  appNotifications AppNotification[]
  /// Set when this login applied to the affiliate program (one per account).
  affiliate        Affiliate?

  @@index([status])
  @@index([channel])
  @@map("customer_accounts")
}

/// A single OTP challenge. The code is stored hashed and is never readable
/// back out of the database - the same reason a password is not.
///
/// Rows are kept after use rather than deleted: consumedAt and attempts are
/// the only record of how a session was obtained, and a burst of failures
/// against one number is what abuse looks like.
model CustomerOtpChallenge {
  id String @id @default(uuid())

  phone    String
  codeHash String
  purpose  CustomerOtpPurpose @default(LOGIN)

  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)

  accountId String?
  account   CustomerAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([phone, createdAt])
  @@index([accountId])
  @@map("customer_otp_challenges")
}

// ---------------------------------------------------------------------------
// Storefront banners - Super Admin controlled hero/promo slots, resolved live
// by the customer app. See BannersService in the backend for the exact rules.
// ---------------------------------------------------------------------------

enum BannerPlacement {
  HOMEPAGE
  CATEGORIES_PAGE
  PRODUCTS_PAGE
}

enum BannerAudience {
  ALL
  B2C
  B2B
}

/// One promotional slide. `placement` decides which storefront screen shows
/// it, `targetAudience` narrows it to a channel, `displayOrder` decides slide
/// order within a placement, and `isActive` is the publish switch - the same
/// hide-don't-delete pattern as Category/Product.
model Banner {
  id String @id @default(uuid())

  title            String
  badgeText        String?
  description      String
  imageUrl         String
  ctaTextPrimary   String
  ctaLinkPrimary   String
  ctaTextSecondary String?
  ctaLinkSecondary String?
  backgroundColor  String          @default("#064e3b")
  textColor        String          @default("#ffffff")
  targetAudience   BannerAudience  @default(ALL)
  placement        BannerPlacement @default(HOMEPAGE)
  displayOrder     Int             @default(0)
  isActive         Boolean         @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, isActive, displayOrder])
  @@map("banners")
}

/// A "Today's Schemes & Offers" tile on the customer homepage. `displayOrder`
/// is the row/position Super Admin picks; `isActive` is the same
/// hide-don't-delete publish switch as Banner - deactivating (or deleting)
/// every scheme is how the whole homepage section is hidden, since the
/// storefront renders nothing when the published list is empty.
model Scheme {
  id String @id @default(uuid())

  tag             String
  title           String
  subtitle        String
  ctaText         String
  ctaLink         String         @default("/products/atta-flour")
  backgroundColor String         @default("#fce3cd")
  textColor       String         @default("#452b0d")
  badgeColor      String         @default("#965a0b")
  badgeTextColor  String         @default("#ffffff")
  buttonColor     String         @default("#8a4b08")
  buttonTextColor String         @default("#ffffff")
  targetAudience  BannerAudience @default(ALL)
  displayOrder    Int            @default(0)
  isActive        Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, displayOrder])
  @@map("schemes")
}

/// Super Admin managed homepage product sections (e.g. "Best of the Basics").
model HomeSection {
  id String @id @default(uuid())

  title          String
  subtitle       String?
  targetAudience BannerAudience @default(ALL)
  displayOrder   Int            @default(0)
  isActive       Boolean        @default(true)
  productIds     String[]       @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, displayOrder])
  @@map("home_sections")
}

// ---------------------------------------------------------------------------
// Loyalty rewards (percentage-based, configured by Super Admin)
//
// Points ARE the coin ledger (`CoinTransaction`, `Customer.coinBalance`) - one
// currency shared with referral rewards, so a customer has one balance.
// ---------------------------------------------------------------------------

enum LoyaltyEligibility {
  INHERIT
  ELIGIBLE
  NOT_ELIGIBLE
}

/// What the percentage is applied to. Delivery/shipping charges are NEVER part
/// of either (they are not on order lines at all); GST is the only switch.
enum LoyaltyCalculationBase {
  /// Line value after the price is applied, before GST. The default: GST is
  /// not the company's revenue, so it should not fund rewards.
  EXCLUDING_TAX
  INCLUDING_TAX
}

/// Single row, lazily created (same pattern as ReferralSettings). Read live
/// when an order is delivered; what was applied is frozen on LoyaltyOrderEarn.
model LoyaltySettings {
  id String @id @default(uuid())

  /// Master switch. Off: delivered orders are recorded as "program off" and
  /// earn nothing - and are NOT retro-credited if it is switched on later.
  isActive Boolean @default(true)

  /// Percent of the eligible amount returned as rewards, per channel.
  /// 0 switches earning off for that channel.
  earnPercentB2C Decimal @default(2) @db.Decimal(5, 2)
  earnPercentB2B Decimal @default(1) @db.Decimal(5, 2)

  /// Rupees one point is worth. 1 = one point is Rs 1. 0.25 = four points per rupee.
  pointValueInr Decimal @default(1) @db.Decimal(10, 4)

  calculationBase LoyaltyCalculationBase @default(EXCLUDING_TAX)

  /// Whether a product with no explicit or category rule earns.
  defaultEligible Boolean @default(true)

  /// A line counts as discounted when its selling price (incl. GST) is below
  /// the product's MRP. Off = such lines earn nothing.
  appliesToDiscountedProducts Boolean @default(true)

  /// Optional guards. Null = no limit.
  minEligibleItemAmount  Decimal? @db.Decimal(12, 2)
  minEligibleOrderAmount Decimal? @db.Decimal(12, 2)
  /// Cap on the rupee value of rewards one order can earn.
  maxRewardPerOrderInr   Decimal? @db.Decimal(12, 2)

  /// Months until earned points lapse. Null/0 = never.
  pointsExpiryMonths Int?

  /// Whether customers may spend points at checkout.
  redemptionEnabled    Boolean @default(false)
  /// Most of an order's value points can pay for.
  maxRedemptionPercent Int     @default(50)
  /// Fewest points a redemption may use.
  minRedeemPoints      Int     @default(0)

  /// Only orders delivered on/after this are ever credited by the catch-up
  /// sweep, so switching the feature on never retro-pays history.
  earningStartsAt DateTime @default(now())

  updatedById String?
  updatedBy   User?    @relation("LoyaltySettingsUpdated", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("loyalty_settings")
}

/// One per DELIVERED order, unique on orderId - which is the idempotency
/// guarantee: an order can never be credited twice. Written even when nothing
/// is earned, so "why did I get no points?" always has a stored answer.
model LoyaltyOrderEarn {
  id String @id @default(uuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  customerId String

  /// Sum of the eligible lines' base amounts.
  eligibleAmount    Decimal                @db.Decimal(14, 2)
  /// The rules that produced this result, frozen at credit time.
  percentApplied    Decimal                @db.Decimal(5, 2)
  pointValueApplied Decimal                @db.Decimal(10, 4)
  calculationBase   LoyaltyCalculationBase
  /// Rupee value of the points credited (points x point value).
  rewardInr         Decimal                @db.Decimal(14, 2)
  points            Int
  cappedByMax       Boolean                @default(false)
  /// Why an order earned nothing: PROGRAM_OFF, NO_RATE, BELOW_MIN_ORDER, NO_ELIGIBLE_ITEMS.
  skipReason        String?

  coinTransactionId String? @unique

  lines LoyaltyOrderEarnLine[]

  createdAt DateTime @default(now())

  @@index([customerId])
  @@map("loyalty_order_earns")
}

model LoyaltyOrderEarnLine {
  id String @id @default(uuid())

  earnId String
  earn   LoyaltyOrderEarn @relation(fields: [earnId], references: [id], onDelete: Cascade)

  orderItemId String    @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  productId  String
  quantity   Int
  baseAmount Decimal @db.Decimal(14, 2)

  eligible          Boolean
  /// PRODUCT_NOT_ELIGIBLE, DISCOUNTED, BELOW_MIN_ITEM when not eligible.
  ineligibleReason  String?
  /// Where the eligibility decision came from: PRODUCT, CATEGORY, PARENT_CATEGORY, DEFAULT.
  eligibilitySource String

  points         Int
  /// How many of `points` have been taken back by returns. Never exceeds `points`.
  reversedPoints Int @default(0)

  @@index([earnId])
  @@map("loyalty_order_earn_lines")
}

/// A delivered item coming back / being refunded. The trigger for reversing
/// the loyalty points that item earned.
model OrderReturn {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  quantity     Int
  reason       String
  /// Money refunded for this return, when known. Informational.
  refundAmount Decimal? @db.Decimal(14, 2)

  recordedById String
  recordedBy   User   @relation("OrderReturnsRecorded", fields: [recordedById], references: [id])

  /// Set when the return/exchange workflow wrote this row (the goods came back
  /// on that request). Null = recorded directly by staff (legacy recordReturn).
  returnRequestId String?        @unique
  returnRequest   ReturnRequest? @relation(fields: [returnRequestId], references: [id])

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([orderItemId])
  @@map("order_returns")
}

// ---------------------------------------------------------------------------
// Storefront checkout & fulfilment
// ---------------------------------------------------------------------------

enum WarehouseKind {
  CENTRAL
  OUTLET
  /// A company-owned store that sells over the counter (POS). Never a checkout
  /// or delivery node - routing and riders select CENTRAL / OUTLET explicitly.
  STORE
}

enum OrderSource {
  STAFF
  STOREFRONT
}

enum FulfillmentMethod {
  LOCAL
  SHIPROCKET
}

enum PaymentMode {
  ONLINE
  COD
  /// B2B on account terms; the credit limit is enforced at placement.
  CREDIT
}

enum CheckoutSessionStatus {
  OPEN
  COMPLETED
  ABORTED
  EXPIRED
}

enum ReservationStatus {
  /// Short-lived (TTL) hold while the customer pays.
  HELD
  /// Firm: an order exists. Stays until packing turns it into batch allocations.
  COMMITTED
  /// Given back (payment failed / abandoned / order cancelled) or converted to allocations.
  RELEASED
  EXPIRED
}

enum PaymentTransactionStatus {
  PENDING
  PAID
  FAILED
  COD
  CREDIT
  REFUNDED
}

enum CouponType {
  PERCENT
  FIXED
}

/// A customer's saved delivery address. Coordinates decide LOCAL vs SHIPROCKET.
model CustomerAddress {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  label     String   @default("Home")
  fullName  String
  phone     String
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  pincode   String
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  isDefault Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@map("customer_addresses")
}

/// Single row of checkout / fulfilment rules, Super Admin editable.
model CheckoutSettings {
  id String @id @default(uuid())

  /// A franchise outlet whose own radius is unset delivers this far.
  localRadiusKm      Decimal @default(5) @db.Decimal(6, 2)
  /// The depot that fulfils everything outside local range and all B2B. Null = first active CENTRAL warehouse.
  centralWarehouseId String?

  localBaseFee   Decimal  @default(30) @db.Decimal(10, 2)
  localFreeAbove Decimal? @default(499) @db.Decimal(12, 2)
  shipBaseFee    Decimal  @default(60) @db.Decimal(10, 2)
  shipFreeAbove  Decimal? @default(999) @db.Decimal(12, 2)
  /// B2B bulk orders ship free above this (null = never free).
  b2bFreeAbove   Decimal? @default(5000) @db.Decimal(12, 2)
  b2bBaseFee     Decimal  @default(150) @db.Decimal(10, 2)

  /// ETA model. LOCAL: prepMinutes + distance x minutesPerKm. SHIPROCKET: whole days.
  prepMinutes  Int @default(30)
  minutesPerKm Int @default(4)
  shipMinDays  Int @default(3)
  shipMaxDays  Int @default(6)

  codEnabled   Boolean  @default(true)
  codMaxAmount Decimal? @default(5000) @db.Decimal(12, 2)

  /// How long stock is held while a customer pays.
  reservationTtlMinutes Int @default(15)
  deliveryOtpDigits     Int @default(4)

  /// B2B credit: the day "Net N days" counts from. See enum CreditPeriodStart.
  creditPeriodStart CreditPeriodStart @default(DISPATCH)

  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("checkout_settings")
}

/// One attempt to buy: the server's frozen quote, the stock hold, and the payment.
model CheckoutSession {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  status CheckoutSessionStatus @default(OPEN)

  /// Everything the server decided at the time: lines, prices, node, method, totals.
  quote       Json
  paymentMode PaymentMode

  gatewayProvider String?
  gatewayOrderId  String?

  expiresAt DateTime
  /// Set once the order exists. The unique constraint on Order.checkoutSessionId
  /// is what makes confirming twice return the SAME order.
  orderId   String?

  /// Client-supplied `Idempotency-Key` header on `POST /checkout/sessions`.
  /// A double-tap or retried request with the same key returns the session
  /// already created for it instead of opening a second stock hold - the same
  /// idempotency `Order.checkoutSessionId` already gives confirm(), one step
  /// earlier. Null for a client that sent no key, which is why the unique
  /// constraint is scoped to (customerId, idempotencyKey): Postgres treats
  /// every NULL as distinct, so keyless requests never collide with each
  /// other.
  idempotencyKey String?

  /// The affiliate click (from the HTTP-only aff_tracker cookie) that was live
  /// when this checkout started. Captured here, not at confirm, because a
  /// gateway webhook can place the order with no browser - and no cookie - in
  /// the request. The order is attributed from this after it is placed.
  affiliateClickId String?
  affiliateClick   AffiliateClick? @relation(fields: [affiliateClickId], references: [id])

  reservations StockReservation[]
  payments     PaymentTransaction[]
  order        Order?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, idempotencyKey])
  @@index([customerId])
  @@index([status, expiresAt])
  @@map("checkout_sessions")
}

/// Product-level stock earmarked for a checkout or a placed order, before
/// packing picks the exact FIFO batch. `available = stock - active reservations`.
model StockReservation {
  id String @id @default(uuid())

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  productId   String

  quantity  Int
  status    ReservationStatus @default(HELD)
  /// Only meaningful while HELD; COMMITTED holds have none.
  expiresAt DateTime?

  sessionId String?
  session   CheckoutSession? @relation(fields: [sessionId], references: [id])
  orderId   String?
  order     Order?           @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([warehouseId, productId, status])
  @@index([sessionId])
  @@index([orderId])
  @@map("stock_reservations")
}

/// The payment ledger. One row per attempt; a session can have several.
model PaymentTransaction {
  id String @id @default(uuid())

  sessionId String?
  session   CheckoutSession? @relation(fields: [sessionId], references: [id])
  orderId   String?
  order     Order?           @relation(fields: [orderId], references: [id])

  provider         String
  mode             PaymentMode
  gatewayOrderId   String?
  gatewayPaymentId String?
  amount           Decimal                  @db.Decimal(14, 2)
  status           PaymentTransactionStatus @default(PENDING)
  failureReason    String?
  raw              Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Defensive guard, not a live race fix: `gatewayPaymentId` is only ever
  /// written once, by `openPayment`, and later rows are `updateMany`'d by
  /// `sessionId`, never re-created - so nothing today can produce a
  /// duplicate. This stops the same real-world payment ever being attributed
  /// to two transaction rows if that assumption ever breaks. Multiple NULLs
  /// (every row before a payment ID exists) are unaffected - Postgres does
  /// not treat NULL as equal to NULL in a unique index.
  @@unique([gatewayPaymentId])
  @@index([sessionId])
  @@index([orderId])
  @@index([gatewayOrderId])
  @@map("payment_transactions")
}

model OrderShipment {
  id String @id @default(uuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  provider    String
  awb         String?
  courier     String?
  trackingUrl String?
  labelUrl    String?
  status      String    @default("CREATED")
  events      Json      @default("[]")
  lastEventAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([awb])
  @@map("order_shipments")
}

/// Append-only timeline of an order (what the customer's tracking screen shows).
model OrderEvent {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// PLACED, CONFIRMED, ALLOCATED, PACKED, DISPATCHED, DELIVERED, CANCELLED,
  /// RIDER_ASSIGNED, SHIPMENT_CREATED, SHIPMENT_UPDATE, ...
  type String
  note String?

  actorId String?
  actor   User?   @relation("OrderEventsActed", fields: [actorId], references: [id])

  /// The customer inbox/push generated for this timeline event. Unique on the
  /// notification side so a retried/replayed event can never alert twice.
  appNotification AppNotification?

  /// Durable outbox marker for the customer notification bridge. A null value
  /// is retried after process restarts; handled events (including intentionally
  /// silent internal events) are stamped once processing finishes.
  customerNotificationHandledAt DateTime?

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([customerNotificationHandledAt, createdAt])
  @@map("order_events")
}

model Coupon {
  id String @id @default(uuid())

  code          String     @unique
  title         String
  description   String     @default("")
  type          CouponType
  value         Decimal    @db.Decimal(12, 2)
  minOrderValue Decimal    @default(0) @db.Decimal(12, 2)
  /// Cap for PERCENT coupons.
  maxDiscount   Decimal?   @db.Decimal(12, 2)

  /// ALL | B2C | B2B
  audience         String    @default("ALL")
  validFrom        DateTime?
  expiresAt        DateTime?
  /// Total uses across everyone / per customer. Null = unlimited.
  usageLimit       Int?
  perCustomerLimit Int?
  usedCount        Int       @default(0)
  isActive         Boolean   @default(true)

  redemptions CouponRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("coupons")
}

model CouponRedemption {
  id String @id @default(uuid())

  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  amount Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([couponId, customerId])
  @@map("coupon_redemptions")
}

/// A staff browser that asked to be told about new orders while the dashboard is closed.
model PushSubscription {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint String @unique
  p256dh   String
  auth     String

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

/// One row per signed-in device. The access/refresh tokens both carry this id (`sid`) and every
/// protected request re-reads the row, so logging out (revokedAt) or expiry ends the session
/// immediately - not when a stateless JWT eventually times out.
model CustomerSession {
  id String @id @default(uuid())

  accountId String
  account   CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// bcrypt of the current refresh token; rotated on every refresh. A refresh that does not match
  /// means an old token was replayed, and the whole session is revoked.
  refreshTokenHash String

  userAgent String?
  ipAddress String?

  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?

  @@index([accountId])
  @@index([expiresAt])
  @@map("customer_sessions")
}

/// A product a storefront customer saved for later. One row per customer+product.
model CustomerWishlistItem {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([customerId, productId])
  @@index([customerId])
  @@map("customer_wishlist_items")
}

/// A help-desk request raised by a storefront customer or retailer (the same
/// Customer record, distinguished by `customer.type`). Ticket numbers are
/// generated the same way as the other trace codes (SequenceService) so
/// support staff can read them aloud on the phone.
model SupportTicket {
  id String @id @default(uuid())

  /// Format: TKT-20260921-001.
  ticketNumber String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  category    SupportTicketCategory
  subject     String
  description String

  /// Free text as typed by the customer - not validated against Order, since
  /// a customer may misremember or quote a WhatsApp-shared number.
  orderNumber String?

  status   SupportTicketStatus   @default(OPEN)
  priority SupportTicketPriority @default(MEDIUM)

  /// Staff response, set when the ticket is resolved/closed. Null while open.
  resolutionNote String?
  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     User?     @relation("SupportTicketResolvedBy", fields: [resolvedById], references: [id])

  /// ---- Complaint / Dispute Resolution Fields ----

  /// Evidence photos uploaded by the customer (URLs stored as a Postgres text array).
  evidenceImages String[] @default([])

  /// The formal resolution action taken by staff (refund, replacement, etc.).
  resolutionAction SupportResolutionAction?

  /// Refund amount approved (if applicable).
  refundAmount Decimal? @db.Decimal(10, 2)

  /// Replacement order number dispatched (if applicable).
  replacementOrderNumber String?

  /// Internal staff audit note for compliance / investigation logs.
  internalAuditNote String?

  /// The conversation after the opening `description`: customer follow-ups
  /// and staff replies, oldest first.
  messages SupportTicketMessage[]

  /// Bumped on every message from either side, so both inboxes can sort by
  /// "most recent activity" without scanning the messages table.
  lastActivityAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([lastActivityAt])
  @@map("support_tickets")
}

/// One message in a support conversation. The ticket's own `description` is
/// the customer's opening message and is not duplicated here.
model SupportTicketMessage {
  id String @id @default(uuid())

  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  author SupportMessageAuthor

  /// The staff member who replied. Null for customer messages.
  staffUserId String?
  staffUser   User?   @relation("SupportTicketMessagesSent", fields: [staffUserId], references: [id])

  body String

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@map("support_ticket_messages")
}

enum SupportMessageAuthor {
  CUSTOMER
  STAFF
}

enum SupportTicketCategory {
  ORDER_ISSUE
  PAYMENT_REFUND
  DELIVERY_DELAY
  ACCOUNT_GST
  OTHER
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
}

/// The formal action a staff member takes to resolve a complaint or dispute.
enum SupportResolutionAction {
  REFUND_APPROVED
  REPLACEMENT_DISPATCHED
  REVERSE_PICKUP
  REJECTED
}

/// A rating + comment a storefront customer or retailer leaves on a product
/// they've bought. One row per (customer, product) - same shape for both
/// channels, since nothing about a rating is channel-specific.
model ProductReview {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// The order this review was left against, if the storefront asked for a
  /// review from a specific delivered order. Null for a review left from the
  /// product page rather than a post-delivery prompt.
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  rating  Int
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([productId])
  @@map("product_reviews")
}

/// A payment a B2B customer made against their credit bills (FRD 24 credit
/// terms). Staff record it; it is applied to the customer's open credit orders,
/// oldest due first, through CreditReceiptAllocation rows. A mistaken receipt
/// is voided, never deleted, so the statement of account keeps its history.
model CreditReceipt {
  id            String        @id @default(uuid())
  /// RCPT-YYYYMMDD-NNN
  receiptNumber String        @unique
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  amount        Decimal       @db.Decimal(14, 2)
  method        ReceiptMethod
  /// UTR, cheque number, UPI reference.
  reference     String?
  /// The day the money was received (calendar date, not a timestamp).
  receivedOn    DateTime      @db.Date
  note          String?

  recordedById String
  recordedBy   User   @relation("CreditReceiptRecordedBy", fields: [recordedById], references: [id])

  voidedAt   DateTime?
  voidReason String?
  voidedById String?
  voidedBy   User?     @relation("CreditReceiptVoidedBy", fields: [voidedById], references: [id])

  allocations CreditReceiptAllocation[]
  createdAt   DateTime                  @default(now())

  @@index([customerId, receivedOn])
  @@map("credit_receipts")
}

/// How much of one receipt settled one order. Deleted when the receipt is voided
/// (the receipt row itself stays, marked void).
model CreditReceiptAllocation {
  id        String        @id @default(uuid())
  receiptId String
  receipt   CreditReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id])
  amount    Decimal       @db.Decimal(14, 2)
  createdAt DateTime      @default(now())

  @@unique([receiptId, orderId])
  @@index([orderId])
  @@map("credit_receipt_allocations")
}

// ---------------------------------------------------------------------------
// Delivery zones & Quick Delivery (src/delivery)
// ---------------------------------------------------------------------------

enum DeliverySpeed {
  STANDARD
  QUICK
}

/// Which products a zone's Quick Delivery promise covers. Stock at the serving
/// outlet is always required on top of this - nothing can be delivered in
/// minutes from a shelf it is not on.
enum ZoneProductScope {
  ALL_PRODUCTS
  SELECTED_CATEGORIES
}

/// What a customer in the zone gets when Quick Delivery is not possible for
/// this cart (out of hours, not stocked at the outlet, product not eligible).
enum ZoneFallback {
  /// The normal routing: local delivery from an outlet in range, else courier.
  STANDARD
  /// Always courier from the central depot.
  COURIER
}

/// A Super Admin-defined delivery area. Eligibility is decided from the
/// customer's actual delivery location - never from city names in code.
///
/// Coverage: an address is in the zone when its pin falls inside `boundary`,
/// or (for an address without a pin, or a zone with no drawn boundary) its
/// pincode is in `pincodes`. `maxRadiusKm` is a hard cap on distance from the
/// serving outlet on top of either.
model DeliveryZone {
  id           String  @id @default(uuid())
  name         String
  /// Short code shown to staff/riders, e.g. "NGP-DHARAMPETH".
  code         String  @unique
  isActive     Boolean @default(true)
  /// Off = customers here get normal delivery; the zone still exists.
  quickEnabled Boolean @default(false)

  /// The outlet/warehouse that serves Quick Delivery in this zone.
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  /// Polygon as [[lat, lng], ...] (first point not repeated). Null = no drawn boundary.
  boundary    Json?
  pincodes    String[] @default([])
  maxRadiusKm Decimal? @db.Decimal(6, 2)

  /// Promised window, e.g. 15-20. No code default: set per zone.
  targetMinMinutes Int
  targetMaxMinutes Int

  /// [{ "day": 0-6 (Sun-Sat), "open": "HH:mm", "close": "HH:mm" }, ...]. Empty = always open.
  operatingHours Json   @default("[]")
  timezone       String @default("Asia/Kolkata")

  productScope ZoneProductScope @default(ALL_PRODUCTS)
  categoryIds  String[]         @default([])
  fallback     ZoneFallback     @default(STANDARD)

  quickFee       Decimal  @default(0) @db.Decimal(10, 2)
  /// Quick Delivery is free at or above this cart value. Null = never free.
  quickFreeAbove Decimal? @db.Decimal(12, 2)

  /// When zones overlap, the higher priority wins; ties go to the nearer outlet.
  priority Int @default(0)

  orders        Order[]
  deliveryTasks DeliveryTask[]
  earningRules  RiderEarningRule[]

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([warehouseId])
  @@map("delivery_zones")
}

// ---------------------------------------------------------------------------
// Riders, delivery tasks, COD and rider earnings (src/delivery)
// ---------------------------------------------------------------------------

enum RiderStatus {
  /// Signed up, phone not yet verified by OTP.
  PENDING_VERIFICATION
  /// Phone verified, waiting for staff to approve and assign an outlet.
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  REJECTED
}

enum RiderAvailability {
  OFFLINE
  ONLINE
}

enum VehicleType {
  BICYCLE
  MOTORCYCLE
  SCOOTER
  EV_SCOOTER
  OTHER
}

enum RiderOtpPurpose {
  VERIFY_PHONE
  RESET_PASSWORD
}

/// A delivery partner. Separate from staff `User` and storefront accounts:
/// own login (phone/email + password, OTP-verified phone), own tokens.
model Rider {
  id              String      @id @default(uuid())
  /// RDR-000001, issued on approval.
  code            String?     @unique
  fullName        String
  phone           String      @unique
  email           String?     @unique
  passwordHash    String
  status          RiderStatus @default(PENDING_VERIFICATION)
  phoneVerifiedAt DateTime?

  city          String?
  vehicleType   VehicleType?
  vehicleNumber String?
  licenceNumber String?
  photoUrl      String?
  /// Driving licence / ID photo uploaded at sign-up, for the approval check.
  documentUrl   String?

  /// Home outlet. Riders are only offered tasks picked up here. Set on approval.
  warehouseId    String?
  warehouse      Warehouse? @relation(fields: [warehouseId], references: [id])
  /// How many tasks the rider may hold at once (batching); 1 = one at a time.
  maxActiveTasks Int        @default(1)

  availability          RiderAvailability @default(OFFLINE)
  availabilityChangedAt DateTime?
  lastLatitude          Decimal?          @db.Decimal(9, 6)
  lastLongitude         Decimal?          @db.Decimal(9, 6)
  lastLocationAt        DateTime?
  /// Last sign of life from the app (socket connect, location heartbeat, going
  /// online). An ONLINE rider not seen for DeliverySettings.riderHeartbeatMinutes
  /// is not offered work - the app was probably killed without going offline.
  lastSeenAt            DateTime?

  reviewedById    String?
  reviewedBy      User?     @relation("RiderReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?

  /// Onboarding gate, kept by RiderVerificationService: every mandatory
  /// document (incl. the PCC) approved and the security deposit paid when that
  /// rule is on. Dispatch, going online and approval all require it.
  isVerified            Boolean   @default(false)
  /// The gate lapses here (earliest expiry among the approved mandatory
  /// documents) without anyone recomputing it. Null = no expiry.
  verifiedUntil         DateTime?
  verificationCheckedAt DateTime?

  sessions       RiderSession[]
  documents      RiderDocument[]
  depositEntries RiderDepositEntry[]
  depositOrders  RiderDepositOrder[]
  otps           RiderOtp[]
  tasks          DeliveryTask[]
  offers         DeliveryOffer[]
  codCollections CodCollection[]
  cashEntries    RiderCashEntry[]
  earnings       RiderEarning[]
  payouts        RiderPayout[]
  notifications  RiderNotification[]
  pushDevices    PushDevice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([warehouseId, status, availability])
  @@map("riders")
}

model RiderSession {
  id                  String    @id @default(uuid())
  riderId             String
  rider               Rider     @relation(fields: [riderId], references: [id], onDelete: Cascade)
  /// SHA-256 of the current refresh token (rotated on every refresh).
  refreshTokenHash    String
  /// The token it replaced, accepted for a short grace window after rotation:
  /// on mobile data a refresh response is often lost, and the app retries
  /// with the old token. Treating that as theft would log riders out mid-shift.
  previousRefreshHash String?
  rotatedAt           DateTime?
  expiresAt           DateTime
  revokedAt           DateTime?
  lastUsedAt          DateTime  @default(now())
  userAgent           String?
  createdAt           DateTime  @default(now())

  @@index([riderId])
  @@map("rider_sessions")
}

model RiderOtp {
  id         String          @id @default(uuid())
  phone      String
  codeHash   String
  purpose    RiderOtpPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int             @default(0)
  riderId    String?
  rider      Rider?          @relation(fields: [riderId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())

  @@index([phone, createdAt])
  @@map("rider_otps")
}

enum DeliveryTaskKind {
  ORDER_DELIVERY
  /// Rider collects a returned / exchanged item from the customer and brings it
  /// to the outlet (`warehouseId`). Same offer/assign machinery, reverse trip.
  RETURN_PICKUP
  /// Rider takes an exchange's replacement from the outlet to the customer.
  REPLACEMENT_DELIVERY
}

enum DeliveryTaskStatus {
  READY_FOR_PICKUP
  OFFERED
  ASSIGNED
  AT_PICKUP
  PICKED_UP
  OUT_FOR_DELIVERY
  AT_DROP
  DELIVERED
  FAILED
  RETURNED_TO_STORE
  CANCELLED
}

/// One trip by one rider. An order that fails and is re-attempted gets a new
/// task (attempt 2, 3 ...); the order's own status machine is untouched and is
/// only advanced at pickup (DISPATCHED) and doorstep OTP (DELIVERED).
model DeliveryTask {
  id         String             @id @default(uuid())
  /// DT-YYYYMMDD-NNN
  taskNumber String             @unique
  kind       DeliveryTaskKind   @default(ORDER_DELIVERY)
  status     DeliveryTaskStatus @default(READY_FOR_PICKUP)
  speed      DeliverySpeed      @default(STANDARD)
  attempt    Int                @default(1)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  /// Set (and `orderId` left null) for RETURN_PICKUP / REPLACEMENT_DELIVERY, so
  /// none of the order-delivery hooks ever fire for a reverse-logistics trip.
  returnRequestId String?
  returnRequest   ReturnRequest? @relation(fields: [returnRequestId], references: [id])

  /// Pickup point.
  warehouseId String
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id])
  zoneId      String?
  zone        DeliveryZone? @relation(fields: [zoneId], references: [id])

  /// Drop point, frozen from the order's address snapshot.
  dropName      String
  dropPhone     String
  dropAddress   String
  dropLatitude  Decimal? @db.Decimal(9, 6)
  dropLongitude Decimal? @db.Decimal(9, 6)
  /// Outlet -> customer, straight line (km).
  distanceKm    Decimal? @db.Decimal(8, 2)

  /// Cash to collect at the door (0 for prepaid).
  codAmount  Decimal   @default(0) @db.Decimal(14, 2)
  /// The time the customer was promised (order etaMax).
  promisedBy DateTime?

  riderId               String?
  rider                 Rider?   @relation(fields: [riderId], references: [id])
  /// No rider accepted / auto-offer off: staff must assign.
  needsManualAssignment Boolean  @default(false)
  offerRound            Int      @default(0)
  /// Staff took this task over: the dispatcher never offers it on its own until
  /// staff resume auto-offer (or assign a rider).
  autoDispatchPaused    Boolean  @default(false)
  /// Total goods weight (kg), from product pack weights. Null = at least one
  /// item has no recorded weight, so no vehicle limit is applied.
  weightKg              Decimal? @db.Decimal(10, 3)

  readyAt               DateTime  @default(now())
  assignedAt            DateTime?
  arrivedPickupAt       DateTime?
  pickedUpAt            DateTime?
  outForDeliveryAt      DateTime?
  arrivedDropAt         DateTime?
  deliveredAt           DateTime?
  failedAt              DateTime?
  returnedAt            DateTime?
  cancelledAt           DateTime?
  /// Arrival confirmed by location within the geofence (used for waiting-time pay).
  arrivedPickupVerified Boolean   @default(false)
  arrivedDropVerified   Boolean   @default(false)

  failureReasonCode String?
  failureNote       String?
  failureProofUrl   String?
  /// Where the task was when it was cancelled - drives cancellation pay.
  cancelStage       String?
  cancelReason      String?

  events   DeliveryTaskEvent[]
  offers   DeliveryOffer[]
  cod      CodCollection?
  earnings RiderEarning[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([riderId, status])
  @@index([warehouseId, status])
  @@index([orderId])
  @@index([returnRequestId])
  @@map("delivery_tasks")
}

model DeliveryTaskEvent {
  id          String       @id @default(uuid())
  taskId      String
  task        DeliveryTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// READY, OFFERED, OFFER_REJECTED, OFFER_EXPIRED, ASSIGNED, AT_PICKUP, PICKED_UP, ...
  type        String
  note        String?
  riderId     String?
  actorUserId String?
  latitude    Decimal?     @db.Decimal(9, 6)
  longitude   Decimal?     @db.Decimal(9, 6)
  createdAt   DateTime     @default(now())

  @@index([taskId, createdAt])
  @@map("delivery_task_events")
}

enum DeliveryOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
  /// Broadcast: another rider in the same round accepted first.
  TAKEN
}

model DeliveryOffer {
  id           String              @id @default(uuid())
  taskId       String
  task         DeliveryTask        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  riderId      String
  rider        Rider               @relation(fields: [riderId], references: [id])
  round        Int
  status       DeliveryOfferStatus @default(PENDING)
  offeredAt    DateTime            @default(now())
  expiresAt    DateTime
  respondedAt  DateTime?
  rejectReason String?

  @@index([riderId, status])
  @@index([taskId])
  @@map("delivery_offers")
}

enum CodMethod {
  CASH
  UPI
}

/// The rider confirming cash (or UPI to the company) at the door. A delivered
/// COD order is only "paid" once this exists.
model CodCollection {
  id              String       @id @default(uuid())
  taskId          String       @unique
  task            DeliveryTask @relation(fields: [taskId], references: [id])
  orderId         String
  riderId         String
  rider           Rider        @relation(fields: [riderId], references: [id])
  expectedAmount  Decimal      @db.Decimal(14, 2)
  collectedAmount Decimal      @db.Decimal(14, 2)
  method          CodMethod
  reference       String?
  collectedAt     DateTime     @default(now())

  @@index([orderId])
  @@map("cod_collections")
}

// ------------------------------------------------------------------ rider onboarding

enum RiderDocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

/// What riders must upload. Super Admin keeps the list; PCC is built in
/// (isSystem) and always mandatory.
model RiderDocumentType {
  id                String  @id @default(uuid())
  /// Stable key, e.g. DRIVING_LICENCE, PCC.
  code              String  @unique
  name              String
  description       String?
  isMandatory       Boolean @default(true)
  isActive          Boolean @default(true)
  /// Ask the rider for the document / certificate number.
  requiresNumber    Boolean @default(false)
  /// Ask who issued it (PCC: the police station / authority).
  requiresIssuer    Boolean @default(false)
  /// Ask for the issue date.
  requiresIssueDate Boolean @default(false)
  /// Ask for the expiry date; an expired approval no longer counts.
  requiresExpiry    Boolean @default(false)
  /// Built in: cannot be made optional, switched off or renamed in code.
  isSystem          Boolean @default(false)
  sortOrder         Int     @default(0)

  documents RiderDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("rider_document_types")
}

/// One upload of one document. A re-upload is a new row; older PENDING /
/// REJECTED rows are superseded, and an APPROVED row stays in force until the
/// new one is approved (so renewing a licence never takes a rider off the road).
model RiderDocument {
  id              String              @id @default(uuid())
  riderId         String
  rider           Rider               @relation(fields: [riderId], references: [id], onDelete: Cascade)
  typeId          String
  type            RiderDocumentType   @relation(fields: [typeId], references: [id])
  /// Front / back photos or a PDF.
  fileUrls        String[]
  documentNumber  String?
  issuedBy        String?
  issuedOn        DateTime?           @db.Date
  expiresOn       DateTime?           @db.Date
  status          RiderDocumentStatus @default(PENDING)
  /// Shown to the rider when REJECTED.
  rejectionReason String?
  /// Staff-only note on the check made (e.g. "verified with police station").
  reviewNote      String?
  reviewedById    String?
  reviewedBy      User?               @relation("RiderDocumentReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  /// Replaced by a newer upload / approval of the same type. Kept for audit.
  supersededAt    DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([riderId, typeId, createdAt])
  @@index([status, supersededAt])
  @@map("rider_documents")
}

enum RiderDepositEntryType {
  /// Money received from the rider (+).
  PAYMENT
  /// Money returned to the rider, e.g. on leaving (-).
  REFUND
  /// Kept by the company against a loss or damage (-).
  FORFEIT
  /// Correction, either sign.
  ADJUSTMENT
}

enum RiderDepositMethod {
  CASH
  UPI
  BANK_TRANSFER
  ONLINE
  EARNINGS_DEDUCTION
  OTHER
}

/// Security deposit ledger. Paid = sum(amount). Never edited, only added to.
model RiderDepositEntry {
  id               String                @id @default(uuid())
  riderId          String
  rider            Rider                 @relation(fields: [riderId], references: [id])
  type             RiderDepositEntryType
  /// Signed: + payment, - refund / forfeit.
  amount           Decimal               @db.Decimal(12, 2)
  method           RiderDepositMethod?
  reference        String?
  note             String?
  /// Online payments: the gateway payment id, so a replayed verify cannot pay twice.
  gatewayPaymentId String?               @unique
  recordedById     String?
  recordedBy       User?                 @relation("RiderDepositRecordedBy", fields: [recordedById], references: [id])
  createdAt        DateTime              @default(now())

  @@index([riderId, createdAt])
  @@map("rider_deposit_entries")
}

/// An online deposit payment the rider started. The amount is fixed here,
/// server side, so the browser cannot change what gets credited.
model RiderDepositOrder {
  id             String    @id @default(uuid())
  riderId        String
  rider          Rider     @relation(fields: [riderId], references: [id])
  gatewayOrderId String    @unique
  amount         Decimal   @db.Decimal(12, 2)
  paidAt         DateTime?
  paymentId      String?
  createdAt      DateTime  @default(now())

  @@index([riderId])
  @@map("rider_deposit_orders")
}

enum RiderCashEntryType {
  /// Cash taken at a door (+).
  COD_COLLECTED
  /// Handed over to the outlet (-).
  DEPOSITED
  ADJUSTMENT
}

/// Cash a rider is holding for the company. Balance = sum(amount).
model RiderCashEntry {
  id              String             @id @default(uuid())
  riderId         String
  rider           Rider              @relation(fields: [riderId], references: [id])
  type            RiderCashEntryType
  /// Signed: + collected, - deposited.
  amount          Decimal            @db.Decimal(14, 2)
  taskId          String?
  codCollectionId String?            @unique
  reference       String?
  note            String?
  recordedById    String?
  recordedBy      User?              @relation("RiderCashRecordedBy", fields: [recordedById], references: [id])
  createdAt       DateTime           @default(now())

  @@index([riderId, createdAt])
  @@map("rider_cash_entries")
}

enum FailureCategory {
  CUSTOMER_UNAVAILABLE
  CUSTOMER_REFUSED
  ADDRESS_ISSUE
  RIDER_ISSUE
  OTHER
}

enum FailureFollowUp {
  /// Rider brings the goods back; staff decide what next.
  RETURN_TO_STORE
  /// After the goods are back, a new attempt is dispatched automatically.
  AUTO_REATTEMPT
}

/// Super Admin-configured reasons a rider can give for a failed delivery.
model DeliveryFailureReason {
  id              String          @id @default(uuid())
  code            String          @unique
  label           String
  category        FailureCategory
  isActive        Boolean         @default(true)
  requiresNote    Boolean         @default(false)
  requiresPhoto   Boolean         @default(false)
  /// Only allowed once the rider has marked arrival at the customer.
  requiresArrival Boolean         @default(false)
  followUp        FailureFollowUp @default(RETURN_TO_STORE)
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("delivery_failure_reasons")
}

/// Single row, Super Admin editable.
model DeliverySettings {
  id                       String   @id @default(uuid())
  /// Offer tasks to riders automatically; off = staff assign every task.
  autoOffer                Boolean  @default(true)
  offerTimeoutSeconds      Int      @default(45)
  /// Riders tried before a task is handed to staff.
  maxOfferRounds           Int      @default(5)
  /// Rider location older than this is ignored when ranking candidates.
  locationFreshMinutes     Int      @default(10)
  /// "Arrived" counts as verified within this distance of the point.
  geofenceMeters           Int      @default(250)
  /// Delivery (OTP) is refused until COD is recorded as collected.
  requireCodBeforeDelivery Boolean  @default(true)
  /// No new offers to a rider holding at least this much cash. Null = no limit.
  maxCashInHand            Decimal? @db.Decimal(12, 2)
  /// Delay before an AUTO_REATTEMPT task is dispatched once goods are back.
  reattemptDelayMinutes    Int      @default(15)
  /// Riders offered a task at the same time (one round). First to accept gets
  /// it; the others' offers close as TAKEN. 1 = one rider at a time.
  broadcastSize            Int      @default(3)
  /// Riders farther than this from the pickup (by fresh location) are not
  /// offered. Null = no limit, and riders with no fresh location rank last.
  maxPickupDistanceKm      Decimal? @db.Decimal(6, 2)
  /// An ONLINE rider whose app has not been seen for this long is skipped.
  riderHeartbeatMinutes    Int      @default(30)
  /// Heaviest delivery (kg) each vehicle may carry: { "BICYCLE": 5, ... }.
  /// A vehicle type not listed has no limit.
  vehicleMaxKg             Json     @default("{}")
  /// Riders must pay a security deposit before they can take orders.
  securityDepositRequired  Boolean  @default(false)
  /// The deposit every rider owes when the rule is on.
  securityDepositAmount    Decimal  @default(0) @db.Decimal(12, 2)
  updatedById              String?
  updatedAt                DateTime @updatedAt

  @@map("delivery_settings")
}

enum EarningRuleKind {
  /// Flat amount per successful delivery.
  BASE_PER_DELIVERY
  /// Amount by distance slab, per successful delivery.
  DISTANCE_SLAB
  /// Extra per delivery completed inside configured time windows.
  PEAK_HOUR
  /// Extra per delivery in a zone (high demand), optionally time-boxed.
  ZONE_INCENTIVE
  /// One-off bonus when a rider reaches N deliveries in a day.
  DAILY_TARGET
  /// One-off bonus when a rider reaches N deliveries in a week (Mon-Sun).
  WEEKLY_TARGET
  /// Pay for verified waiting beyond a free allowance.
  WAITING_TIME
  /// Pay for a cancelled or failed task, by stage / reason.
  OUTCOME_COMPENSATION
}

/// Super Admin-configured rider pay rules. `config` shape depends on `kind`
/// (validated in EarningRulesService). No rule = no pay for that component.
model RiderEarningRule {
  id          String          @id @default(uuid())
  name        String
  kind        EarningRuleKind
  isActive    Boolean         @default(true)
  /// Null = every zone.
  zoneId      String?
  zone        DeliveryZone?   @relation(fields: [zoneId], references: [id])
  config      Json
  validFrom   DateTime?
  validTo     DateTime?
  earnings    RiderEarning[]
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("rider_earning_rules")
}

enum RiderEarningType {
  BASE
  DISTANCE
  PEAK
  ZONE_INCENTIVE
  DAILY_BONUS
  WEEKLY_BONUS
  WAITING
  OUTCOME
  ADJUSTMENT
}

/// What a rider has earned, line by line. Never recomputed in place: each line
/// carries a snapshot of the rule that produced it.
model RiderEarning {
  id           String            @id @default(uuid())
  riderId      String
  rider        Rider             @relation(fields: [riderId], references: [id])
  type         RiderEarningType
  amount       Decimal           @db.Decimal(10, 2)
  taskId       String?
  task         DeliveryTask?     @relation(fields: [taskId], references: [id])
  ruleId       String?
  rule         RiderEarningRule? @relation(fields: [ruleId], references: [id])
  /// Makes crediting idempotent: task:<id>:<rule>, bonus:<rider>:<rule>:<period>:<target>, ...
  dedupeKey    String?           @unique

  /// Set once the line has been paid out. A line belongs to at most one live
  /// payout; voiding the payout releases it for the next one.
  payoutId String?
  payout   RiderPayout? @relation(fields: [payoutId], references: [id])
  detail       Json?
  note         String?
  recordedById String?
  earnedAt     DateTime          @default(now())

  @@index([riderId, earnedAt])
  @@index([payoutId])
  @@map("rider_earnings")
}

enum RiderPayoutMethod {
  BANK_TRANSFER
  UPI
  CASH
}

enum RiderPayoutStatus {
  PAID
  VOIDED
}

/// Rider pay settled: every unpaid earning line up to a cut-off, paid by bank,
/// UPI or cash and recorded after the money moved (with its reference). COD
/// cash the rider still holds can be set off against it - that deduction is a
/// RiderCashEntry, so cash held and pay owed stay reconciled.
model RiderPayout {
  id           String @id @default(uuid())
  /// RPO-YYYYMMDD-NNN
  payoutNumber String @unique

  riderId String
  rider   Rider  @relation(fields: [riderId], references: [id])

  /// Lines earned before this instant (start of the IST day after the chosen date) are included.
  upTo DateTime

  status RiderPayoutStatus @default(PAID)

  /// Sum of the earning lines settled (clawbacks included, so it can be lower than the deliveries alone).
  grossAmount Decimal @db.Decimal(14, 2)
  /// COD cash held by the rider and kept out of the payment instead of being handed in.
  cashOffset  Decimal @default(0) @db.Decimal(14, 2)
  /// What actually left the bank / till: gross - cashOffset.
  netPaid     Decimal @db.Decimal(14, 2)
  lineCount   Int

  method    RiderPayoutMethod
  reference String?
  note      String?
  paidAt    DateTime

  recordedById String
  recordedBy   User   @relation("RiderPayoutRecordedBy", fields: [recordedById], references: [id])

  voidedAt     DateTime?
  voidReason   String?
  voidedById   String?
  voidedBy     User?     @relation("RiderPayoutVoidedBy", fields: [voidedById], references: [id])

  earnings RiderEarning[]

  createdAt DateTime @default(now())

  @@index([riderId, paidAt])
  @@index([status])
  @@map("rider_payouts")
}

model RiderNotification {
  id        String    @id @default(uuid())
  riderId   String
  rider     Rider     @relation(fields: [riderId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  taskId    String?
  imageUrl  String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([riderId, createdAt])
  @@map("rider_notifications")
}

enum PolicyAudience {
  RIDER
  RETAILER
  CUSTOMER
}

enum PolicyType {
  PRIVACY_POLICY
  TERMS_AND_CONDITIONS
}

model LegalPolicy {
  id          String         @id @default(uuid())
  audience    PolicyAudience
  type        PolicyType
  title       String
  content     String         @db.Text
  version     String         @default("1.0")
  isActive    Boolean        @default(true)
  updatedById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([audience, type])
  @@map("legal_policies")
}

// ---------------------------------------------------------------------------
// Push notifications (Firebase Cloud Messaging) + in-app inbox
// ---------------------------------------------------------------------------

/// Which app a device token was issued to - decides the click-through base path and logo.
enum PushApp {
  ADMIN
  FIELD
  CUSTOMER
  RIDER
}

/// The three separate identity systems a notification can be addressed to.
enum PushRecipientKind {
  STAFF
  CUSTOMER
  RIDER
}

/// One browser/phone that asked to receive pushes while signed in. Registered at login and
/// deleted at logout. `sessionId` pins it to the login session (CustomerSession / RiderSession):
/// a device whose session was revoked or has expired is skipped, so a signed-out person never
/// gets a system pop-up even if the logout call never reached us. Staff have no session row;
/// for them a cleared `User.refreshTokenHash` (what staff logout does) means signed out.
model PushDevice {
  id    String            @id @default(uuid())
  /// FCM registration token. Unique: the same browser signing in as someone else moves the row.
  token String            @unique
  app   PushApp
  kind  PushRecipientKind

  userId            String?
  user              User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerAccountId String?
  customerAccount   CustomerAccount? @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  riderId           String?
  rider             Rider?           @relation(fields: [riderId], references: [id], onDelete: Cascade)

  sessionId String?
  userAgent String?

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @updatedAt

  @@index([userId])
  @@index([customerAccountId])
  @@index([riderId])
  @@map("push_devices")
}

/// A message Super Admin sent from the Push Notifications screen. `audience` is the filter as
/// submitted; the counts are what actually happened when it went out.
model PushBroadcast {
  id       String  @id @default(uuid())
  title    String
  body     String
  imageUrl String?
  /// Path inside the receiving app opened on tap, e.g. "/offers". Null = app home.
  link     String?

  audience        Json
  audienceSummary String

  /// People matched by the filter - every one of them gets an inbox entry.
  recipientCount Int @default(0)
  /// Of those, how many had at least one signed-in device.
  reachableCount Int @default(0)
  deviceCount    Int @default(0)
  sentCount      Int @default(0)
  failedCount    Int @default(0)

  createdById String
  createdBy   User     @relation("PushBroadcastsSent", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  notifications AppNotification[]

  @@index([createdAt])
  @@map("push_broadcasts")
}

/// In-app inbox for staff and storefront accounts (riders keep using `rider_notifications`).
/// Written for every recipient whether or not a push could be delivered, so someone who was
/// signed out still sees the message in the app after signing in.
model AppNotification {
  id String @id @default(uuid())

  broadcastId String?
  broadcast   PushBroadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)

  /// Set for automatic order-status notifications. Broadcasts leave it null.
  /// One-to-one is the delivery idempotency key for lifecycle event retries.
  orderEventId String?     @unique
  orderEvent   OrderEvent? @relation(fields: [orderEventId], references: [id], onDelete: SetNull)

  kind              PushRecipientKind
  userId            String?
  user              User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerAccountId String?
  customerAccount   CustomerAccount?  @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  title    String
  body     String
  imageUrl String?
  link     String?
  readAt   DateTime?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([customerAccountId, createdAt])
  @@map("app_notifications")
}

// --- GST invoicing (WS4.4) ---------------------------------------------------

/// The selling company as it must appear on a tax invoice. Single row, created
/// on first read. Invoices snapshot these fields when issued, so editing this
/// never restates an invoice already out.
model GstSettings {
  id String @id @default(uuid())

  legalName    String?
  tradeName    String?
  /// 15-character GSTIN. Its first two digits are the seller's state code, which
  /// decides intra-state (CGST+SGST) vs inter-state (IGST) on every invoice.
  gstin        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  pincode      String?
  phone        String?
  email        String?

  /// Up to 4 letters/digits. Numbers read PREFIX/YYYY-NNNNNN (e.g. INV/2627-000001),
  /// restarting each financial year, never more than the 16 characters GST Rule 46 allows.
  invoicePrefix String @default("INV")

  /// Same rules as invoicePrefix, its own series: CN/2627-000001. GSTR-1 reports
  /// credit notes as a separate document series (table 13).
  creditNotePrefix String @default("CN")

  /// Only turn on once the company is notified for e-invoicing and the GSP
  /// credentials are in place (A-11). Applies to B2B invoices only.
  eInvoiceEnabled Boolean @default(false)

  /// The delivery fee is charged GST-inclusive at checkout. On the invoice it is
  /// a separate service line; tax is carved out of it at this rate, so the
  /// customer's total never changes. Pending confirmation by the client's CA.
  deliveryFeeSac            String  @default("996812")
  deliveryFeeGstRatePercent Decimal @default(18) @db.Decimal(5, 2)

  /// Printed at the foot of every invoice.
  footerNote String?

  /// Set the first time the seller details become complete. Automatic issuing
  /// (and the catch-up sweep) only covers orders dispatched from this moment,
  /// so turning invoicing on never mass-issues invoices for old orders.
  invoicingStartsAt DateTime?

  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("gst_settings")
}

enum InvoiceStatus {
  ISSUED
  CANCELLED
}

/// B2B = the buyer has a GSTIN (input tax credit, e-invoice applies).
/// B2C = everyone else, including a retailer who never supplied one.
enum InvoiceSupplyType {
  B2B
  B2C
}

enum EInvoiceStatus {
  /// B2C, or e-invoicing is switched off.
  NOT_APPLICABLE
  /// Waiting for the sweep to submit it to the GSP.
  PENDING
  GENERATED
  /// Refused or unreachable; `eInvoiceError` says why. Retried until it is fixed.
  FAILED
  CANCELLED
}

/// A GST tax invoice for one order. Issued at dispatch (the time of supply for
/// goods). An order has at most one ISSUED invoice; cancelling it frees the
/// order to be invoiced again under a new number.
model Invoice {
  id String @id @default(uuid())

  /// PREFIX/YYYY-NNNNNN - unique for all time, consecutive within a financial year.
  invoiceNumber String   @unique
  invoiceDate   DateTime
  financialYear String

  /// Exactly one of orderId / posSaleId is set: an invoice is for an order or for a counter sale.
  orderId    String?
  order      Order?       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  posSaleId  String?
  posSale    PosSale?     @relation(fields: [posSaleId], references: [id], onDelete: Restrict)
  /// Null for a counter sale to a walk-in, who has no Customer record.
  customerId String?
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  channel    SalesChannel

  supplyType InvoiceSupplyType
  status     InvoiceStatus     @default(ISSUED)

  /// Frozen copies of who sold to whom, as printed.
  seller Json
  buyer  Json

  /// Two-digit GST state code of where the goods were delivered.
  placeOfSupply        String
  /// True when no delivery state could be found and the seller's state was used.
  placeOfSupplyAssumed Boolean @default(false)
  isInterState         Boolean

  taxableTotal  Decimal @db.Decimal(14, 2)
  cgstTotal     Decimal @db.Decimal(14, 2)
  sgstTotal     Decimal @db.Decimal(14, 2)
  igstTotal     Decimal @db.Decimal(14, 2)
  taxTotal      Decimal @db.Decimal(14, 2)
  discountTotal Decimal @default(0) @db.Decimal(14, 2)
  /// Whatever reconciles the lines to what the order actually charged (normally 0).
  roundOff      Decimal @default(0) @db.Decimal(14, 2)
  grandTotal    Decimal @db.Decimal(14, 2)

  lines InvoiceLine[]

  // ---- E-invoice (IRN) ----
  eInvoiceStatus        EInvoiceStatus @default(NOT_APPLICABLE)
  irn                   String?        @unique
  ackNo                 String?
  ackDate               DateTime?
  /// The signed QR payload the IRP returns; printed as a QR on the invoice.
  signedQrCode          String?
  eInvoiceProvider      String?
  eInvoiceError         String?
  eInvoiceAttempts      Int            @default(0)
  eInvoiceNextAttemptAt DateTime?

  issuedById String?
  issuedBy   User?   @relation("InvoiceIssuedBy", fields: [issuedById], references: [id])

  cancelledAt   DateTime?
  cancelReason  String?
  cancelledById String?
  cancelledBy   User?     @relation("InvoiceCancelledBy", fields: [cancelledById], references: [id])

  creditNotes CreditNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([posSaleId])
  @@index([customerId])
  @@index([invoiceDate])
  @@index([status])
  @@index([eInvoiceStatus])
  @@map("invoices")
}

model InvoiceLine {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  creditNoteLines CreditNoteLine[]
  lineNo    Int

  /// Null on the delivery-charge line.
  productId   String?
  description String
  sku         String?
  /// HSN for goods, SAC for the delivery service. Null when the product has none
  /// recorded - such an invoice cannot be e-invoiced until it is added.
  hsnSac      String?
  isService   Boolean @default(false)

  quantity     Decimal @db.Decimal(12, 3)
  /// GST unit quantity code (PAC = packs, OTH = other).
  uqc          String
  unitPrice    Decimal @db.Decimal(12, 2)
  gross        Decimal @db.Decimal(14, 2)
  discount     Decimal @default(0) @db.Decimal(14, 2)
  taxableValue Decimal @db.Decimal(14, 2)

  gstRatePercent Decimal @db.Decimal(5, 2)
  cgstAmount     Decimal @db.Decimal(14, 2)
  sgstAmount     Decimal @db.Decimal(14, 2)
  igstAmount     Decimal @db.Decimal(14, 2)
  lineTotal      Decimal @db.Decimal(14, 2)

  @@unique([invoiceId, lineNo])
  @@map("invoice_lines")
}

/// Why a credit note was issued. The first six are the reasons the GST portal
/// has used for notes; most here are SALES_RETURN.
enum CreditNoteReason {
  SALES_RETURN
  POST_SALE_DISCOUNT
  DEFICIENCY_IN_SERVICES
  CORRECTION_IN_INVOICE
  CHANGE_IN_POS
  FINALIZATION_OF_PROVISIONAL_ASSESSMENT
  OTHERS
}

/// A GST credit note (CGST Act s.34) against one issued invoice: goods came
/// back, the price was reduced after supply, or the invoice over-charged. It
/// reduces the tax declared on that invoice, so it is reported in GSTR-1 for
/// the month it is issued in (CDNR / CDNUR, or netted into B2CS).
///
/// Separate from Invoice on purpose - everything that asks "does this order
/// have a live invoice" keeps meaning exactly that. Amounts are positive; the
/// document type is what makes them a reduction.
model CreditNote {
  id String @id @default(uuid())

  /// CN/2627-000001 - its own series, restarting each financial year.
  noteNumber    String   @unique
  noteDate      DateTime
  financialYear String

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  /// The return this note was raised for, if any. One note per return.
  returnRequestId String?        @unique
  returnRequest   ReturnRequest? @relation(fields: [returnRequestId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  channel    SalesChannel
  supplyType InvoiceSupplyType
  status     InvoiceStatus     @default(ISSUED)
  reason     CreditNoteReason
  remark     String?

  /// Copied from the invoice - a note always mirrors the parties and place of
  /// supply of the invoice it corrects.
  seller        Json
  buyer         Json
  placeOfSupply String
  isInterState  Boolean

  taxableTotal Decimal @db.Decimal(14, 2)
  cgstTotal    Decimal @db.Decimal(14, 2)
  sgstTotal    Decimal @db.Decimal(14, 2)
  igstTotal    Decimal @db.Decimal(14, 2)
  taxTotal     Decimal @db.Decimal(14, 2)
  grandTotal   Decimal @db.Decimal(14, 2)

  lines CreditNoteLine[]

  /// Same e-invoice handling as Invoice (document type CRN) - B2B only.
  eInvoiceStatus        EInvoiceStatus @default(NOT_APPLICABLE)
  irn                   String?        @unique
  ackNo                 String?
  ackDate               DateTime?
  signedQrCode          String?
  eInvoiceProvider      String?
  eInvoiceError         String?
  eInvoiceAttempts      Int            @default(0)
  eInvoiceNextAttemptAt DateTime?

  issuedById String?
  issuedBy   User?   @relation("CreditNoteIssuedBy", fields: [issuedById], references: [id])

  cancelledAt   DateTime?
  cancelReason  String?
  cancelledById String?
  cancelledBy   User?     @relation("CreditNoteCancelledBy", fields: [cancelledById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([customerId])
  @@index([noteDate])
  @@index([status])
  @@index([eInvoiceStatus])
  @@map("credit_notes")
}

/// One line of a credit note, always tied to the invoice line it reduces, so
/// the total ever credited on a line can be checked against what was invoiced.
model CreditNoteLine {
  id           String     @id @default(uuid())
  creditNoteId String
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  lineNo       Int

  invoiceLineId String
  invoiceLine   InvoiceLine @relation(fields: [invoiceLineId], references: [id], onDelete: Restrict)

  productId   String?
  description String
  sku         String?
  hsnSac      String?
  isService   Boolean @default(false)

  /// Packs coming back. 0 for a value-only note (a discount after the sale).
  quantity  Decimal @db.Decimal(12, 3)
  uqc       String
  unitPrice Decimal @db.Decimal(12, 2)

  taxableValue   Decimal @db.Decimal(14, 2)
  gstRatePercent Decimal @db.Decimal(5, 2)
  cgstAmount     Decimal @db.Decimal(14, 2)
  sgstAmount     Decimal @db.Decimal(14, 2)
  igstAmount     Decimal @db.Decimal(14, 2)
  lineTotal      Decimal @db.Decimal(14, 2)

  @@unique([creditNoteId, lineNo])
  @@index([invoiceLineId])
  @@map("credit_note_lines")
}

// --- POS: company-owned stores selling over the counter ------------------------

/// A company-owned physical store with a POS counter. Its stock lives in its own
/// warehouse (kind STORE), so counter sales draw on the same inventory truth,
/// batch by batch, as every other sale. Franchise outlets are a separate,
/// future module and are not modelled here.
model PosOutlet {
  id   String @id @default(uuid())
  /// Human code staff read aloud, e.g. OUT-PAT-01. Unique.
  code String @unique
  name String

  address  String
  city     String
  district String?
  state    String
  pincode  String?

  managerName        String?
  managerPhone       String?
  /// Display only. Whoever actually sells is the signed-in user on an open shift.
  defaultCashierName String?
  posTerminalsCount  Int     @default(1)
  /// Suggested opening float when a cashier opens a shift here.
  defaultOpeningCash Decimal @default(0) @db.Decimal(12, 2)

  isActive Boolean @default(true)

  branchId    String
  branch      Branch    @relation(fields: [branchId], references: [id])
  warehouseId String    @unique
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  shifts PosShift[]
  sales  PosSale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@map("pos_outlets")
}

enum PosShiftStatus {
  OPEN
  CLOSED
}

/// One cashier's session at one outlet: opening float in, sales against it,
/// cash counted at close. Expected cash and the discrepancy are frozen at close.
model PosShift {
  id          String @id @default(uuid())
  /// SHIFT-YYYYMMDD-NNN
  shiftNumber String @unique

  outletId  String
  outlet    PosOutlet @relation(fields: [outletId], references: [id])
  cashierId String
  cashier   User      @relation("PosShiftCashier", fields: [cashierId], references: [id])

  status      PosShiftStatus @default(OPEN)
  openedAt    DateTime       @default(now())
  openingCash Decimal        @db.Decimal(12, 2)

  closedAt     DateTime?
  closedById   String?
  closedBy     User?     @relation("PosShiftClosedBy", fields: [closedById], references: [id])
  expectedCash Decimal?  @db.Decimal(12, 2)
  countedCash  Decimal?  @db.Decimal(12, 2)
  /// counted - expected. Negative = cash short.
  discrepancy  Decimal?  @db.Decimal(12, 2)
  notes        String?

  sales   PosSale[] @relation("PosSaleShift")
  refunds PosSale[] @relation("PosSaleRefundShift")

  @@index([outletId, status])
  @@index([cashierId, status])
  @@map("pos_shifts")
}

enum PosPaymentMode {
  CASH
  UPI
  CARD
}

enum PosSaleStatus {
  COMPLETED
  REFUNDED
}

enum PosCustomerType {
  WALK_IN
  REGULAR_KIRANA
  INSTITUTIONAL
}

/// A counter sale. Priced by the server from the B2C price list, stock taken
/// first-expiry-first-out from the store's QA-released batches, and the exact
/// batches recorded (PosSaleAllocation) so a pack sold at the counter traces
/// back to the farmer like any other.
model PosSale {
  id              String  @id @default(uuid())
  /// POS-YYYYMMDD-NNN
  saleNumber      String  @unique
  /// Sent by the terminal so a double-click or retry never records the sale twice.
  clientRequestId String? @unique

  outletId    String
  outlet      PosOutlet @relation(fields: [outletId], references: [id])
  shiftId     String
  shift       PosShift  @relation("PosSaleShift", fields: [shiftId], references: [id])
  cashierId   String
  cashier     User      @relation("PosSaleCashier", fields: [cashierId], references: [id])
  warehouseId String

  customerType    PosCustomerType @default(WALK_IN)
  customerName    String
  customerPhone   String?
  customerGstin   String?
  customerAddress String?
  customerCity    String?
  notes           String?

  subtotal      Decimal @db.Decimal(14, 2)
  discountTotal Decimal @default(0) @db.Decimal(14, 2)
  taxTotal      Decimal @db.Decimal(14, 2)
  total         Decimal @db.Decimal(14, 2)

  paymentMode      PosPaymentMode
  /// Cash handed over (CASH only) and the change given back.
  amountTendered   Decimal?       @db.Decimal(14, 2)
  changeDue        Decimal?       @db.Decimal(14, 2)
  /// UPI transaction id / card slip number.
  paymentReference String?

  status        PosSaleStatus @default(COMPLETED)
  refundedAt    DateTime?
  refundedById  String?
  refundedBy    User?         @relation("PosSaleRefundedBy", fields: [refundedById], references: [id])
  refundReason  String?
  /// The shift whose drawer the refund came out of (cash refunds reduce its expected cash).
  refundShiftId String?
  refundShift   PosShift?     @relation("PosSaleRefundShift", fields: [refundShiftId], references: [id])

  lines    PosSaleLine[]
  invoices Invoice[]

  createdAt DateTime @default(now())

  @@index([outletId, createdAt])
  @@index([shiftId])
  @@index([status])
  @@map("pos_sales")
}

model PosSaleLine {
  id     String  @id @default(uuid())
  saleId String
  sale   PosSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  lineNo Int

  productId    String
  product      Product @relation(fields: [productId], references: [id])
  nameSnapshot String
  skuSnapshot  String?

  quantity       Int
  /// Per pack, before GST, from the B2C price rule in force at the sale.
  unitPrice      Decimal @db.Decimal(12, 2)
  priceListId    String?
  gstRatePercent Decimal @db.Decimal(5, 2)
  lineSubtotal   Decimal @db.Decimal(14, 2)
  /// Share of the counter discount; GST is charged on subtotal minus this.
  lineDiscount   Decimal @default(0) @db.Decimal(14, 2)
  lineTax        Decimal @db.Decimal(14, 2)
  lineTotal      Decimal @db.Decimal(14, 2)

  allocations PosSaleAllocation[]

  @@unique([saleId, lineNo])
  @@map("pos_sale_lines")
}

/// Which finished-goods batch each counter sale line was taken from.
model PosSaleAllocation {
  id        String             @id @default(uuid())
  lineId    String
  line      PosSaleLine        @relation(fields: [lineId], references: [id], onDelete: Cascade)
  fgBatchId String
  fgBatch   FinishedGoodsBatch @relation(fields: [fgBatchId], references: [id])
  quantity  Int

  @@index([fgBatchId])
  @@map("pos_sale_allocations")
}

// ---------------------------------------------------------------------------
// Returns & Exchanges (src/returns) and the rupee Refund Wallet (src/wallet)
//
// Handled per ORDER ITEM, never per order: a request names one line and a
// quantity of it. Two logistics paths, decided from how the order was
// delivered, never chosen by the customer:
//
//   QUICK_DELIVERY  in-house rider: RETURN_PICKUP task to collect, and a
//                   REPLACEMENT_DELIVERY task to take an exchange's replacement.
//   SHIPROCKET      courier: a reverse (return) shipment to collect, and a
//                   forward shipment for the replacement.
//
// The courier's own status lives on ReturnShipment.externalStatus and is never
// the request's status: ReturnRequest.status is OUR workflow, and only moves on
// the events the workflow recognises.
// ---------------------------------------------------------------------------

enum ReturnRequestType {
  RETURN
  EXCHANGE
}

/// QUICK_DELIVERY = local rider flow (order.fulfillmentMethod LOCAL);
/// SHIPROCKET = courier flow (order.fulfillmentMethod SHIPROCKET).
enum ReturnLogistics {
  QUICK_DELIVERY
  SHIPROCKET
}

/// Return:   REQUESTED -> APPROVED -> PICKUP_SCHEDULED -> PICKED_UP -> QC -> REFUND_INITIATED -> COMPLETED
/// Exchange: REQUESTED -> APPROVED -> PICKUP_SCHEDULED -> PICKED_UP -> QC -> REPLACEMENT_PROCESSING
///           -> SHIPPED -> DELIVERED -> COMPLETED
/// QC means "received at the warehouse, inspection pending".
enum ReturnRequestStatus {
  REQUESTED
  APPROVED
  PICKUP_SCHEDULED
  PICKED_UP
  QC
  REFUND_INITIATED
  REPLACEMENT_PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  REJECTED
  /// Rider/courier could not collect. Staff reschedule (back to PICKUP_SCHEDULED) or cancel.
  PICKUP_FAILED
  /// Claim rejected at inspection - no refund / no replacement.
  QC_FAILED
  /// Replacement could not be delivered. Staff re-dispatch it or convert to a refund.
  DELIVERY_FAILED
  CANCELLED
}

enum RefundMethod {
  /// Rupee Refund Wallet - credited instantly, spendable at checkout.
  WALLET
  /// Paid by staff outside the system to the customer's UPI id; reference recorded.
  UPI
  /// Paid by staff outside the system by bank transfer; reference recorded.
  BANK
  /// B2B credit-terms order: reduces what the retailer owes (a receipt applied
  /// to the order through Receivables). Any excess goes to the Refund Wallet.
  CREDIT_NOTE
}

enum ReturnShippingPayer {
  COMPANY
  CUSTOMER
}

/// What happens when an exchange's replacement is worth less than what was paid.
enum ExchangeLowerPriceAction {
  REFUND_TO_WALLET
  NO_REFUND
}

enum ExchangeDifferenceStatus {
  NONE
  /// Customer owes `priceDifference`; the replacement does not ship until paid.
  PENDING
  PAID
  /// Replacement cheaper: the difference was credited to the Refund Wallet.
  CREDITED
  WAIVED
}

enum QcDecision {
  /// Claim accepted - refund / replacement proceeds (whatever the pack condition).
  ACCEPT
  /// Claim rejected - QC_FAILED, nothing refunded or replaced.
  REJECT
}

enum ReturnStockDisposition {
  GOOD
  DAMAGED
}

enum ReturnShipmentDirection {
  /// Customer -> warehouse (Shiprocket "return order").
  REVERSE
  /// Warehouse -> customer (an exchange's replacement).
  FORWARD
}

/// One row per channel (B2C customers, B2B retailers): the two are configured
/// and handled separately. Lazily created with these defaults on first read.
model ReturnSettings {
  id      String       @id @default(uuid())
  channel SalesChannel @unique

  returnEnabled       Boolean @default(true)
  exchangeEnabled     Boolean @default(true)
  /// Counted from the order's actual `deliveredAt`, never from placement.
  returnWindowHours   Int     @default(168)
  exchangeWindowHours Int     @default(168)

  /// Photos/videos must be attached to every request (a reason can also demand them).
  mediaRequired Boolean @default(false)
  minMediaCount Int     @default(1)
  maxMediaCount Int     @default(6)

  /// Off = receipt at the warehouse counts as a passed inspection.
  qcRequired  Boolean @default(true)
  /// New requests go straight to APPROVED (replacement stock still has to reserve).
  autoApprove Boolean @default(false)

  allowedRefundMethods RefundMethod[] @default([WALLET, UPI, BANK])
  defaultRefundMethod  RefundMethod   @default(WALLET)

  /// Who bears return pickup cost. CUSTOMER deducts `returnShippingFee` from the
  /// refund, except when the reason is the company's fault.
  returnShippingPayer  ReturnShippingPayer @default(COMPANY)
  returnShippingFee    Decimal             @default(0) @db.Decimal(10, 2)
  /// Percentage of the refund kept on non-fault returns (0 = none).
  restockingFeePercent Decimal             @default(0) @db.Decimal(5, 2)

  exchangeSameProductOnly  Boolean                  @default(true)
  exchangeSameCategoryOnly Boolean                  @default(false)
  exchangeLowerPriceAction ExchangeLowerPriceAction @default(REFUND_TO_WALLET)

  /// Inventory rule: QC-passed packs go back to sellable stock. Off = every
  /// returned pack goes to the damaged bucket regardless of condition.
  restockOnQcPass Boolean @default(true)

  /// Eligibility: anything listed here cannot be returned / exchanged.
  nonReturnableCategoryIds   String[] @default([])
  nonReturnableProductIds    String[] @default([])
  nonExchangeableCategoryIds String[] @default([])
  nonExchangeableProductIds  String[] @default([])

  /// Shown to the customer on the request form.
  policyText String?

  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("return_settings")
}

/// Super Admin-managed reasons a customer/retailer can pick.
model ReturnReason {
  id    String @id @default(uuid())
  code  String @unique
  label String

  forReturn   Boolean       @default(true)
  forExchange Boolean       @default(true)
  /// Null = both channels.
  channel     SalesChannel?

  /// Damaged / wrong / defective - the company's fault: no shipping or
  /// restocking deduction.
  companyFault  Boolean @default(false)
  requiresMedia Boolean @default(false)

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  requests ReturnRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("return_reasons")
}

model ReturnRequest {
  id String @id @default(uuid())

  /// RET-YYYYMMDD-NNN or EXC-YYYYMMDD-NNN
  requestNumber String @unique

  type      ReturnRequestType
  status    ReturnRequestStatus @default(REQUESTED)
  /// Frozen from the order: decides which admin queue (customers vs retailers) and policy.
  channel   SalesChannel
  logistics ReturnLogistics

  orderId     String
  order       Order     @relation(fields: [orderId], references: [id])
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])

  quantity Int

  reasonId     String?
  reason       ReturnReason? @relation(fields: [reasonId], references: [id])
  /// Snapshots: a later edit to the reason list never rewrites a request.
  reasonLabel  String
  companyFault Boolean       @default(false)
  description  String?
  mediaUrls    String[]      @default([])

  /// "STOREFRONT" (customer/retailer) or "STAFF" (raised by staff on their behalf).
  raisedBy   String  @default("STOREFRONT")
  raisedById String?

  // --- Money (frozen at request time from the order line) -----------------
  /// What was actually paid per unit after coupon/coin discounts, incl. GST.
  unitPaid                Decimal @db.Decimal(14, 2)
  /// unitPaid x quantity.
  itemValue               Decimal @db.Decimal(14, 2)
  shippingFee             Decimal @default(0) @db.Decimal(14, 2)
  restockingFee           Decimal @default(0) @db.Decimal(14, 2)
  /// RETURN: itemValue - deductions. EXCHANGE: only set when the replacement is cheaper.
  refundAmount            Decimal @default(0) @db.Decimal(14, 2)
  /// Coins redeemed on the order, pro-rated to this line and quantity - given
  /// back when a RETURN completes.
  loyaltyPointsToRestore  Int     @default(0)
  referralPointsToRestore Int     @default(0)

  refundMethod        RefundMethod?
  refundUpiId         String?
  refundAccountName   String?
  refundAccountNumber String?
  refundIfsc          String?
  refundBankName      String?
  refundReference     String?
  refundNote          String?
  refundedAt          DateTime?
  refundedById        String?

  // --- Exchange -------------------------------------------------------------
  replacementProductId       String?
  replacementProduct         Product?                 @relation("ReturnReplacementProduct", fields: [replacementProductId], references: [id])
  replacementName            String?
  replacementUnitPrice       Decimal?                 @db.Decimal(14, 2)
  replacementGstRate         Decimal?                 @db.Decimal(5, 2)
  replacementTotal           Decimal?                 @db.Decimal(14, 2)
  /// replacementTotal - itemValue. Positive = customer pays; negative = cheaper.
  priceDifference            Decimal                  @default(0) @db.Decimal(14, 2)
  differenceStatus           ExchangeDifferenceStatus @default(NONE)
  differencePaidWallet       Decimal                  @default(0) @db.Decimal(14, 2)
  differenceGatewayOrderId   String?
  differenceGatewayPaymentId String?                  @unique
  differenceReference        String?
  /// Set when the replacement stock was atomically reserved (at approval).
  replacementReservedAt      DateTime?
  replacementShippedAt       DateTime?
  replacementDeliveredAt     DateTime?
  /// Doorstep code the customer reads to the rider for a quick replacement.
  replacementOtp             String?
  replacementOtpAttempts     Int                      @default(0)

  /// Code the customer reads to the rider when handing the item over.
  pickupOtp         String?
  pickupOtpAttempts Int     @default(0)

  /// Where the goods come back to (and, for an exchange, where the replacement leaves from).
  warehouseId String
  warehouse   Warehouse @relation("ReturnReceivingWarehouse", fields: [warehouseId], references: [id])

  // --- QC ---------------------------------------------------------------------
  qcDecision        QcDecision?
  qcGoodQuantity    Int?
  qcDamagedQuantity Int?
  qcNotes           String?
  qcAt              DateTime?
  qcById            String?
  /// Reverse shipment lost/damaged in transit: staff may settle without receipt.
  lostInTransit     Boolean     @default(false)

  // --- Lifecycle stamps ---------------------------------------------------------
  approvedAt        DateTime?
  approvedById      String?
  rejectedReason    String?
  pickupScheduledAt DateTime?
  pickedUpAt        DateTime?
  receivedAt        DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  failureReason     String?
  adminNote         String?

  /// Client-supplied Idempotency-Key, so a double-tap cannot raise two requests.
  idempotencyKey String?

  events                 ReturnRequestEvent[]
  shipments              ReturnShipment[]
  deliveryTasks          DeliveryTask[]
  batchLines             ReturnBatchLine[]
  replacementAllocations ReturnReplacementAllocation[]
  walletTransactions     RefundWalletTransaction[]
  creditNote             CreditNote?
  /// The loyalty-reversal record, once the goods are back (or lost in transit).
  orderReturn            OrderReturn?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, idempotencyKey])
  @@index([channel, status])
  @@index([orderId])
  @@index([orderItemId])
  @@index([customerId])
  @@map("return_requests")
}

/// Append-only timeline of a request.
model ReturnRequestEvent {
  id        String        @id @default(uuid())
  requestId String
  request   ReturnRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  type       String
  fromStatus ReturnRequestStatus?
  toStatus   ReturnRequestStatus?
  note       String?
  /// STAFF | CUSTOMER | RIDER | COURIER | SYSTEM
  actorKind  String
  actorId    String?

  createdAt DateTime @default(now())

  @@index([requestId, createdAt])
  @@map("return_request_events")
}

/// A Shiprocket (or mock) shipment for a request. `externalStatus` is the
/// courier's word, kept apart from ReturnRequest.status on purpose.
model ReturnShipment {
  id        String                  @id @default(uuid())
  requestId String
  request   ReturnRequest           @relation(fields: [requestId], references: [id])
  direction ReturnShipmentDirection

  provider       String
  awb            String?
  courier        String?
  trackingUrl    String?
  labelUrl       String?
  providerRef    String?
  externalStatus String    @default("CREATED")
  events         Json      @default("[]")
  lastEventAt    DateTime?
  /// False once superseded by a re-booked shipment (pickup failed / RTO).
  isActive       Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([awb])
  @@index([requestId])
  @@map("return_shipments")
}

/// Which finished-goods batch each returned pack belonged to, and where it went.
/// Keeps traceability alive in reverse: pack -> batch -> farmer still resolves.
model ReturnBatchLine {
  id          String                 @id @default(uuid())
  requestId   String
  request     ReturnRequest          @relation(fields: [requestId], references: [id])
  fgBatchId   String
  fgBatch     FinishedGoodsBatch     @relation(fields: [fgBatchId], references: [id])
  quantity    Int
  disposition ReturnStockDisposition
  createdAt   DateTime               @default(now())

  @@index([requestId])
  @@index([fgBatchId])
  @@map("return_batch_lines")
}

/// Replacement packs reserved for an exchange (FIFO, QA-released, ACTIVE) -
/// the exchange's equivalent of OrderAllocation. Reserving bumps
/// FinishedGoodsStock.reservedQuantity under a row lock, so the same unit can
/// never be promised to two exchanges (or to an exchange and an order).
model ReturnReplacementAllocation {
  id             String             @id @default(uuid())
  requestId      String
  request        ReturnRequest      @relation(fields: [requestId], references: [id])
  fgBatchId      String
  fgBatch        FinishedGoodsBatch @relation(fields: [fgBatchId], references: [id])
  warehouseId    String
  warehouse      Warehouse          @relation(fields: [warehouseId], references: [id])
  quantity       Int
  /// Stock physically left (quantity and reservation both decremented).
  dispatchedAt   DateTime?
  /// Reservation given back (cancelled / rejected / converted). Never deleted.
  releasedAt     DateTime?
  releasedReason String?
  createdAt      DateTime           @default(now())

  @@index([requestId])
  @@index([fgBatchId])
  @@map("return_replacement_allocations")
}

enum RefundWalletReason {
  /// + A prepaid order that could not be delivered and was closed with its goods back in stock.
  UNDELIVERED_REFUND
  /// + Refund for a completed return.
  RETURN_REFUND
  /// + An exchange's replacement was cheaper.
  EXCHANGE_DIFFERENCE_CREDIT
  /// - Spent on an order at checkout.
  ORDER_PAYMENT
  /// + Spent on an order that was then cancelled - given back.
  ORDER_PAYMENT_REVERSAL
  /// - Spent on an exchange's price difference.
  EXCHANGE_DIFFERENCE_PAYMENT
  /// + Exchange cancelled after its difference was paid from the wallet.
  EXCHANGE_DIFFERENCE_REVERSAL
  /// +/- Super Admin correction; note required.
  MANUAL_ADJUSTMENT
}

/// Ledger of the rupee Refund Wallet. Same invariant as the coin and stock
/// ledgers: Customer.refundWalletBalance never moves without a row here,
/// written in the same transaction.
model RefundWalletTransaction {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  /// Signed: + credit, - debit.
  amount       Decimal            @db.Decimal(14, 2)
  balanceAfter Decimal            @db.Decimal(14, 2)
  reason       RefundWalletReason
  note         String?

  orderId         String?
  order           Order?         @relation(fields: [orderId], references: [id])
  returnRequestId String?
  returnRequest   ReturnRequest? @relation(fields: [returnRequestId], references: [id])

  performedById String?

  createdAt DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([orderId])
  @@index([returnRequestId])
  @@map("refund_wallet_transactions")
}

// ---------------------------------------------------------------------------
// Affiliate marketing (added 5 Oct 2026)
//
// Commission is earned per ORDER ITEM, at the rate of the item's category,
// because margins differ wildly between staples and masalas. Base =
// (unit price x quantity) - the line's share of the coupon; GST, delivery fee
// and coin redemptions are never commissioned. Every rupee an affiliate is owed
// is an AffiliateCommission row; returns never edit the original amount, they
// add an AffiliateCommissionAdjustment and bump refundedQuantity/Amount.
// ---------------------------------------------------------------------------

enum AffiliateStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum AffiliatePayoutMethod {
  UPI
  BANK
}

/// PENDING = inside the hold window. APPROVED = matured, payable. PAID = in a
/// payout. REFUNDED = every unit returned. CANCELLED = order cancelled.
enum AffiliateCommissionStatus {
  PENDING
  APPROVED
  PAID
  REFUNDED
  CANCELLED
}

/// ATTRIBUTED = commission rows written. FRAUD = self-referral, nothing paid.
/// NO_COMMISSION = attributed but every line earned 0 (no rate configured).
enum AffiliateAttributionStatus {
  ATTRIBUTED
  FRAUD
  NO_COMMISSION
}

enum AffiliateAdjustmentKind {
  RETURN
  CANCELLATION
}

enum AffiliateHoldFrom {
  ORDER_DATE
  DELIVERY_DATE
}

/// Singleton (id = "default"), edited by Super Admin.
model AffiliateSettings {
  id                 String            @id @default("default")
  enabled            Boolean           @default(true)
  /// Lifetime of the aff_tracker cookie, and how old a click may be at checkout.
  cookieDays         Int               @default(30)
  /// Days a commission stays PENDING (the grocery return window).
  holdDays           Int               @default(7)
  /// The hold counts from the order date (as specified) or from delivery.
  /// Either way a commission never matures before the order is DELIVERED.
  holdFrom           AffiliateHoldFrom @default(ORDER_DATE)
  /// Used when neither the item's category nor any parent has a rate.
  defaultRatePercent Decimal           @default(0) @db.Decimal(5, 2)
  /// Retailer (B2B) orders earn commission only when this is on.
  applyToB2B         Boolean           @default(false)
  /// The payout list only shows affiliates owed at least this much.
  minPayoutAmount    Decimal           @default(0) @db.Decimal(14, 2)
  termsText          String?
  updatedById        String?
  updatedAt          DateTime          @updatedAt

  @@map("affiliate_settings")
}

/// Category-level commission %. A sub-category without a row inherits its parent's.
model AffiliateCategoryRate {
  id          String   @id @default(uuid())
  categoryId  String   @unique
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  ratePercent Decimal  @db.Decimal(5, 2)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("affiliate_category_rates")
}

model Affiliate {
  id     String          @id @default(uuid())
  /// Goes in the link: ?aff=CODE. Upper-case letters and digits.
  code   String          @unique
  status AffiliateStatus @default(PENDING)

  /// The storefront login that applied. The affiliate dashboard is this login.
  customerAccountId String          @unique
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id])
  /// Their own shopper record, when they have one - buying through your own
  /// link is the most direct self-referral.
  customerId        String?

  fullName      String
  phone         String
  email         String?
  /// Website / social handles they will promote on.
  promotionUrl  String?
  audienceSize  String?
  promotionPlan String?
  pan           String?

  payoutMethod        AffiliatePayoutMethod @default(UPI)
  payoutUpiId         String?
  payoutAccountName   String?
  payoutAccountNumber String?
  payoutIfsc          String?
  payoutBankName      String?

  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  suspendedReason String?

  clicks       AffiliateClick[]
  attributions AffiliateAttribution[]
  commissions  AffiliateCommission[]
  adjustments  AffiliateCommissionAdjustment[]
  payouts      AffiliatePayout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("affiliates")
}

/// One visit through an affiliate link. The cookie holds this row's id, signed.
model AffiliateClick {
  id          String    @id @default(uuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])
  /// sha256 of the IP - enough to de-duplicate refreshes, not to identify anyone.
  ipHash      String?
  userAgent   String?
  landingPath String?
  referrer    String?
  createdAt   DateTime  @default(now())

  checkoutSessions CheckoutSession[]
  attributions     AffiliateAttribution[]

  @@index([affiliateId, createdAt])
  @@map("affiliate_clicks")
}

/// The decision taken once per order that arrived with a live affiliate click.
model AffiliateAttribution {
  id              String                     @id @default(uuid())
  orderId         String                     @unique
  order           Order                      @relation(fields: [orderId], references: [id])
  affiliateId     String
  affiliate       Affiliate                  @relation(fields: [affiliateId], references: [id])
  clickId         String?
  click           AffiliateClick?            @relation(fields: [clickId], references: [id])
  status          AffiliateAttributionStatus
  /// e.g. SAME_CUSTOMER, PHONE_MATCH, EMAIL_MATCH, PAYMENT_MATCH - why it is FRAUD.
  fraudReasons    String[]                   @default([])
  fraudDetail     String?
  /// Sum of commission bases / commission at the time of the order.
  baseTotal       Decimal                    @default(0) @db.Decimal(14, 2)
  commissionTotal Decimal                    @default(0) @db.Decimal(14, 2)
  createdAt       DateTime                   @default(now())

  @@index([affiliateId, createdAt])
  @@index([status])
  @@map("affiliate_attributions")
}

/// The commission ledger: one row per order item.
model AffiliateCommission {
  id            String    @id @default(uuid())
  affiliateId   String
  affiliate     Affiliate @relation(fields: [affiliateId], references: [id])
  attributionId String
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id])
  orderItemId   String    @unique
  productId     String
  productName   String
  categoryId    String?
  categoryName  String?

  quantity         Int
  unitPrice        Decimal @db.Decimal(14, 2)
  /// unitPrice x quantity, before GST.
  grossAmount      Decimal @db.Decimal(14, 2)
  /// This line's share of the order coupon.
  couponShare      Decimal @db.Decimal(14, 2)
  /// grossAmount - couponShare: what the rate is applied to.
  baseAmount       Decimal @db.Decimal(14, 2)
  ratePercent      Decimal @db.Decimal(5, 2)
  /// CATEGORY / PARENT_CATEGORY / DEFAULT - where the rate came from.
  rateSource       String
  commissionAmount Decimal @db.Decimal(14, 2)

  /// Units returned so far, and the commission taken back for them.
  refundedQuantity Int     @default(0)
  refundedAmount   Decimal @default(0) @db.Decimal(14, 2)

  status      AffiliateCommissionStatus @default(PENDING)
  /// Order date + hold days. Matures at this date once the order is delivered.
  releaseDate DateTime
  approvedAt  DateTime?
  payoutId    String?
  payout      AffiliatePayout?          @relation(fields: [payoutId], references: [id])
  paidAt      DateTime?
  statusNote  String?

  adjustments AffiliateCommissionAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([affiliateId, status])
  @@index([status, releaseDate])
  @@index([orderId])
  @@map("affiliate_commissions")
}

/// Commission taken back. When the commission was already PAID, it is a
/// clawback: deducted from the affiliate's next payout (recoveredInPayoutId).
model AffiliateCommissionAdjustment {
  id                  String                  @id @default(uuid())
  commissionId        String
  commission          AffiliateCommission     @relation(fields: [commissionId], references: [id])
  affiliateId         String
  affiliate           Affiliate               @relation(fields: [affiliateId], references: [id])
  kind                AffiliateAdjustmentKind
  quantity            Int
  /// Positive: what the affiliate loses.
  amount              Decimal                 @db.Decimal(14, 2)
  /// The OrderReturn row that triggered it - unique, so a return is deducted once.
  orderReturnId       String?                 @unique
  clawback            Boolean                 @default(false)
  recoveredInPayoutId String?
  recoveredInPayout   AffiliatePayout?        @relation("PayoutRecoveredClawbacks", fields: [recoveredInPayoutId], references: [id])
  note                String?
  createdAt           DateTime                @default(now())

  @@index([affiliateId, clawback])
  @@map("affiliate_commission_adjustments")
}

/// A manual payout made by Super Admin (UPI / bank) outside the system.
model AffiliatePayout {
  id              String                @id @default(uuid())
  /// AFP-YYYYMMDD-NNN
  payoutNumber    String                @unique
  affiliateId     String
  affiliate       Affiliate             @relation(fields: [affiliateId], references: [id])
  /// Matured commission included, before clawbacks.
  grossAmount     Decimal               @db.Decimal(14, 2)
  clawbackAmount  Decimal               @default(0) @db.Decimal(14, 2)
  /// What was actually sent: gross - clawbacks.
  netAmount       Decimal               @db.Decimal(14, 2)
  commissionCount Int
  method          AffiliatePayoutMethod
  /// Snapshot of where it went (UPI id / masked account).
  paidTo          String
  /// The UTR / UPI transaction reference.
  reference       String
  note            String?
  paidById        String
  paidAt          DateTime              @default(now())

  commissions        AffiliateCommission[]
  recoveredClawbacks AffiliateCommissionAdjustment[] @relation("PayoutRecoveredClawbacks")

  @@index([affiliateId, paidAt])
  @@map("affiliate_payouts")
}
