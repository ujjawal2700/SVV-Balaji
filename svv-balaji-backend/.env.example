# App
PORT=3000
NODE_ENV=development

# Database (Postgres)
DATABASE_URL="postgresql://svv_admin:changeme@localhost:5432/svv_balaji?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
JWT_ACCESS_SECRET="change_this_access_secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change_this_refresh_secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Default Super Admin (used by prisma/seed.ts)
SEED_SUPER_ADMIN_EMAIL="admin@svvbalaji.com"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe@123"

# Public traceability site that QR codes point at (FRD 8.2 / 22.3).
# QR codes encode a URL rather than raw data, so linked info can be updated
# without reprinting packaging.
PUBLIC_TRACEABILITY_BASE_URL="https://trace.svvbalaji.com"
