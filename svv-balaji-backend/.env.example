# App
PORT=3000
NODE_ENV=development

# Database (Postgres)
DATABASE_URL="postgresql://svv_admin:changeme@localhost:5432/svv_balaji?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
JWT_ACCESS_SECRET="change_this_access_secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change_this_refresh_secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Default Super Admin (used by prisma/seed.ts)
SEED_SUPER_ADMIN_EMAIL="admin@svvbalaji.com"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe@123"

# Public traceability site that QR codes point at (FRD 8.2 / 22.3).
# QR codes encode a URL rather than raw data, so linked info can be updated
# without reprinting packaging.
PUBLIC_TRACEABILITY_BASE_URL="https://trace.svvbalaji.com"

# Multigrain production (FRD 19.3 / 20.4) is in scope and always on as of
# 14 Aug 2026, when the client confirmed it (action A-05). The MULTIGRAIN_ENABLED
# flag that used to sit here has been removed rather than defaulted to "true":
# a stale .env carrying "false" would have silently blocked production runs on
# somebody's machine with no clue as to why.
#
# The blend ratio is now enforced at production time in production.service.ts -
# a run whose mix drifts more than 0.5 percentage points from the approved
# recipe is refused.
