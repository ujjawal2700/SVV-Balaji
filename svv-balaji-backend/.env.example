# App
PORT=3000
NODE_ENV=development

# Database (Postgres)
DATABASE_URL="postgresql://svv_admin:changeme@localhost:5432/svv_balaji?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth (staff)
JWT_ACCESS_SECRET="change_this_access_secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change_this_refresh_secret"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Storefront (WS2.5 B2C/B2B self-service, added 16 Sep) -------------------
# Customer tokens are signed with their own secret pair, deliberately distinct
# from the staff one above - see src/storefront/customer-token.config.ts for
# why sharing a secret would make a storefront token a staff token.
CUSTOMER_JWT_ACCESS_SECRET="change_this_customer_access_secret"
CUSTOMER_JWT_ACCESS_EXPIRES_IN="30m"
CUSTOMER_JWT_REFRESH_SECRET="change_this_customer_refresh_secret"
CUSTOMER_JWT_REFRESH_EXPIRES_IN="30d"

# No SMS provider is procured yet (needs a vendor + credentials, same shape of
# decision as the GSP one in A-11). "mock" returns the OTP code in the API
# response instead of sending one; the app refuses to boot with mock mode and
# NODE_ENV=production together. See src/storefront/otp.config.ts.
CUSTOMER_OTP_MODE="mock"
CUSTOMER_OTP_MOCK_CODE="123456"

# Default Super Admin (used by prisma/seed.ts)
SEED_SUPER_ADMIN_EMAIL="admin@svvbalaji.com"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe@123"

# Public traceability site that QR codes point at (FRD 8.2 / 22.3).
# QR codes encode a URL rather than raw data, so linked info can be updated
# without reprinting packaging.
PUBLIC_TRACEABILITY_BASE_URL="https://trace.svvbalaji.com"

# Multigrain production (FRD 19.3 / 20.4) is in scope and always on as of
# 14 Aug 2026, when the client confirmed it (action A-05). The MULTIGRAIN_ENABLED
# flag that used to sit here has been removed rather than defaulted to "true":
# a stale .env carrying "false" would have silently blocked production runs on
# somebody's machine with no clue as to why.
#
# The blend ratio is now enforced at production time in production.service.ts -
# a run whose mix drifts more than 0.5 percentage points from the approved
# recipe is refused.

# --- File storage (WS4.1 interim, see A-04) ---------------------------------
# Cloudinary is what we upload to today so that the field executive work is not
# held up waiting on Decision 3. It sits behind StorageService, so answering
# A-04 with S3 or GCS later is a new class in src/uploads/ and one line in
# uploads.module.ts — nothing else in the codebase changes.
#
# The secret is server-side only. Uploads go browser -> our API -> Cloudinary,
# never browser -> Cloudinary, so this value never reaches the bundle.
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Per-file ceiling in bytes. 10 MB by default — a phone photo is 2–5 MB.
MAX_UPLOAD_BYTES="10485760"

# --- Storefront checkout / realtime ---
# mock = dev only (refuses NODE_ENV=production). razorpay needs RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET / RAZORPAY_WEBHOOK_SECRET
PAYMENT_GATEWAY=mock
# mock = dev only. shiprocket needs SHIPROCKET_EMAIL / SHIPROCKET_PASSWORD / SHIPROCKET_PICKUP_LOCATION
SHIPPING_PROVIDER=mock
SHIPROCKET_WEBHOOK_TOKEN=
# Web push for new-order alerts when the admin dashboard is closed: `npx web-push generate-vapid-keys`
VAPID_SUBJECT=mailto:admin@svvbalaji.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Rider app sessions - own signing keys, must differ from the staff and customer secrets
RIDER_JWT_ACCESS_SECRET=
RIDER_JWT_REFRESH_SECRET=
RIDER_JWT_ACCESS_EXPIRES_IN=12h
RIDER_JWT_REFRESH_EXPIRES_IN=30d
